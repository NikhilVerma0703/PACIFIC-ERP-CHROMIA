# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env.local
.env*.local

# typescript
*.tsbuildinfo

# prisma
/prisma/*.db

# docker volumes
/pgdata

.vercel
.env*

# codegraph index (local, rebuildable with `codegraph init`)
/.codegraph/

# python bytecode (scripts/gen-schema.py, make-incentive-notice-pdf.py)
__pycache__/
*.pyc

# throwaway probes and one-off scripts. Named *-tmp or __probe_* by convention
# precisely so they can be matched here — anything you want to keep must not
# carry those names. These are local scratch, never part of the repo.
*-tmp.cjs
*-tmp.mjs
*-tmp.ts
*-tmp.js
__probe_*.ts

# local database dumps taken before a destructive migration. Real backups —
# ignored so they stay out of git, NOT because they are disposable.
/db-archives/

# Agent worktrees. `.claude/worktrees/<name>` is a SECOND FULL CHECKOUT of this
# repo on disk; committing one puts the whole codebase inside itself. 536 files
# of it reached a branch on 2026-08-19 via `git add .`.
/.claude/worktrees/
/.lensverify/

# One-off audit and verification probes. The `*-tmp.*` convention above only
# catches names chosen for it; these are the prefixes actually used in practice.
/zz*.ts
/zz*.mts
/zz*.mjs
/zz*.js
/zz*.json
/lv-*.mts
/lv-*.mjs

# Generated deliverables. The daily report is rebuilt from the database by
# scripts/make-daily-report-pdf.mjs, so the PDF is output, not source.
/Daily-Report-*.pdf

# Business documents dropped in the working folder. They are not code and the
# repo is not where they belong.
/*.docx

# Claude drop-folder leftovers — safe to delete
_to_delete/

# Scratch data dumps generated while investigating (design matrices, handbook
# extracts, dry-run summaries). They are build inputs for a one-off, never
# repo content -- two of them reached a commit before this rule existed.
/*-matrix.json
/handbook*.json
/sf-*.json
/sf-*.md
/.drift.md
