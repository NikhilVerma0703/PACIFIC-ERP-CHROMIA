model ChromiaWasteRecord {
  id         String   @id @default(uuid())
  declaredAt DateTime @default(now()) @map("declared_at")

  slabId String      @unique @map("slab_id")
  slab   ChromiaSlab @relation(fields: [slabId], references: [id], onDelete: Cascade)

  cyclesConsumed          Int @default(0) @map("cycles_consumed")
  recalibrationsAttempted Int @default(0) @map("recalibrations_attempted")

  finalDefectTypeId String?            @map("final_defect_type_id")
