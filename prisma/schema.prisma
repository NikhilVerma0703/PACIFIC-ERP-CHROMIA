  freeDaysExpiry DateTime?          @map("free_days_expiry")
  cadCleared     Boolean            @default(false) @map("cad_cleared")
  deliveryStatus PortDeliveryStatus @default(PENDING) // fork has no @map — column is "deliveryStatus"

  overrideById String?   @map("override_by_id") // -> users.id (no hard FK)
  overrideAt   DateTime? @map("override_at")
  overrideNote String?   @map("override_note")

  arrivalNotifSentAt DateTime? @map("arrival_notif_sent_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  order SalesOrder @relation(fields: [orderId], references: [id])

  @@map("sales_port_arrivals")
}

model SalesAdminAlert {
  id      String @id @default(cuid())
