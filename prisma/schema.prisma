  authorisedById String? @map("authorised_by_id") // -> users.id (no hard FK)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([declaredAt])
  @@map("chromia_waste_record")
}

// ---- Legacy Excel import -------------------------------------------------------

/// One run of the historical Excel register importer (e.g. "PRO MAY").
model ChromiaImportBatch {
  id          String              @id @default(uuid())
  sourceFile  String              @map("source_file")
  sheetName   String?             @map("sheet_name")
  periodLabel String?             @map("period_label")
  status      ChromiaImportStatus @default(PENDING)

  totalRows    Int @default(0) @map("total_rows")
  importedRows Int @default(0) @map("imported_rows")
  skippedRows  Int @default(0) @map("skipped_rows")
  failedRows   Int @default(0) @map("failed_rows")

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  errorLog    Json?     @map("error_log")
  notes       String?

  importedById String? @map("imported_by_id") // -> users.id (no hard FK)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  slabs ChromiaSlab[]

  @@index([status])
  @@map("chromia_import_batch")
