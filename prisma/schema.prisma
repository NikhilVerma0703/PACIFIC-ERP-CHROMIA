model SalesAdminAlert {
  id      String @id @default(cuid())
  orderId String @map("order_id")

  type         String
  message      String
  resolved     Boolean   @default(false)
  resolvedAt   DateTime? @map("resolved_at")
  resolvedById String?   @map("resolved_by_id") // -> users.id (no hard FK)
  resolution   String?

  createdAt DateTime @default(now()) @map("created_at")

  order SalesOrder @relation(fields: [orderId], references: [id])

  @@map("sales_admin_alerts")
}

model SalesOrderLog {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  userId    String   @map("user_id") // -> users.id (no hard FK)
  action    String
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  order SalesOrder @relation(fields: [orderId], references: [id])

  @@map("sales_order_logs")
}

model SalesConfig {
  id                   String   @id @default("global")
  // CC emails always included in all outbound sales emails
  ccEmails             String[] @map("cc_emails") // e.g. ["customs@pacific-surfaces.com","acreceivables@pacific-surfaces.com"]
  // Company details for PDF headers
  companyName          String   @default("Pacific Engineered Surface Pvt Ltd") @map("company_name")
  companyAddress       String?  @map("company_address")
  iecCode              String?  @map("iec_code")
  gstNo                String?  @map("gst_no")
  panNo                String?  @map("pan_no")
  // Bank details for PDF
  bankName             String?  @map("bank_name")
  bankBranch           String?  @map("bank_branch")
  accountNo            String?  @map("account_no")
  ifscCode             String?  @map("ifsc_code")
  swiftCode            String?  @map("swift_code")
  adCode               String?  @map("ad_code")
  logoUrl              String?  @map("logo_url")
  ceoEmail             String?  @map("ceo_email") // receives CEO overdue alerts
  // invoice_config_quartz / invoice_config_granite live in the table for raw SQL only (see 0019 SQL)
  updatedAt            DateTime @updatedAt @map("updated_at")
  /// Present in the live database but not previously modelled here, so
  /// `prisma db push` proposed DROPping it WITH ITS DATA. Modelled
  /// 2026-08-12 to reconcile that drift — nullable, exactly as the column
  /// already is, so this describes the database rather than changing it.
  invoiceConfigGranite Json?    @map("invoice_config_granite")
  /// In the live database but not modelled here, so `prisma db push`
  /// proposed DROPping it WITH ITS DATA. Added 2026-08-12 to reconcile
  /// that drift: each line describes the column as it already exists —
  /// same type, same nullability, same default — so the schema now
  /// matches the database instead of asking to change it.
  invoiceConfigQuartz  Json?    @map("invoice_config_quartz")

  @@map("sales_config")
}

model SalesCreditNote {
  id           String           @id @default(cuid())
  orderId      String           @map("order_id")
  creditNumber String           @unique @map("credit_number") // CN-YYYY-NNNN
  reason       String // e.g. "Broken slab — 2 slabs damaged on arrival"
  description  String? // item details
  amount       Float
  currency     String           @default("USD")
  status       CreditNoteStatus @default(PENDING_INSPECTION)
  inspectedAt  DateTime?        @map("inspected_at")
  issuedAt     DateTime?        @map("issued_at")
  notes        String?
  createdById  String           @map("created_by_id") // -> users.id (no hard FK)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  order            SalesOrder @relation(fields: [orderId], references: [id])
  /// Present in the live database but not previously modelled here, so
  /// `prisma db push` proposed DROPping it WITH ITS DATA. Modelled
  /// 2026-08-12 to reconcile that drift — nullable, exactly as the column
  /// already is, so this describes the database rather than changing it.
  appliedAt        DateTime?  @map("applied_at")
  /// In the live database but not modelled here, so `prisma db push`
  /// proposed DROPping it WITH ITS DATA. Added 2026-08-12 to reconcile
  /// that drift: each line describes the column as it already exists —
  /// same type, same nullability, same default — so the schema now
  /// matches the database instead of asking to change it.
  appliedToOrderId String?    @map("applied_to_order_id")

  @@map("sales_credit_notes")
}

/// In-app notification for a Sales user (bell menu). Written via raw SQL by
/// src/lib/sales/notifications.ts; `actions` is a JSON array of {label, url}
/// buttons. The id defaults in the DATABASE (gen_random_uuid, unlike the
/// client-side cuid() ids elsewhere in this block) because inserts are raw SQL.
model SalesNotification {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String   @map("user_id") // -> users.id (no hard FK)
