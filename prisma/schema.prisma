// ==========================================
// Shop-floor MIS side-tables. Hand-written models for tables created out-of-band
// with raw SQL (their libs keep using $queryRaw — the models exist so `db push`
// stops proposing to DROP them). NOT generated from Airtable; preserve across regens.
// ==========================================

/// Manual batch slab-range edits (src/lib/batchRange.ts): per-batch range
/// confirmations plus manually added/skipped slabs. One row per confirmation
/// or per slab; `kind` discriminates.
model BatchRangeEdit {
  id         String   @id
  batchKey   String   @map("batch_key")
  slabNumber Float?   @map("slab_number")
  kind       String
  enteredBy  String?  @map("entered_by")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([batchKey, kind, slabNumber])
  @@index([batchKey], map: "idx_bre_batch")
  @@map("batch_range_edit")
}

/// Maintenance's response on a downtime incident — one per MIS hourly row
/// (mis_id UNIQUE, no hard FK). May carry a dispute: maintenance's own duration
/// recorded BESIDE production's figure, never over it. See src/lib/downtimeResponse.ts.
model DowntimeResponse {
  id              String    @id
  misId           String    @unique @map("mis_id")
  status          String
  note            String?
  respondedBy     String?   @map("responded_by")
  respondedAt     DateTime  @default(now()) @map("responded_at") @db.Timestamp(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamp(6) // maintained by raw SQL, not @updatedAt
  disputedType    String?   @map("disputed_type")
  disputedMinutes Float?    @map("disputed_minutes")
  disputedBy      String?   @map("disputed_by")
  disputedAt      DateTime? @map("disputed_at") @db.Timestamp(6)

  @@map("downtime_response")
}

/// An APPLIED correction to one hour's delay classification: minutes moved out
/// of one delay bucket on the Mis row and into another, by the Maintenance
/// Manager. Append-only, one row per move. See src/lib/delayReclass.ts.
///
/// Unlike DowntimeResponse's dispute — which sits BESIDE production's figure and
/// is read by nothing — a reclass REWRITES the Mis row, so every total, chart and
/// incentive figure downstream picks it up with no code change. That is the point
/// and also the hazard: shiftScore.ts rates the electrical/mechanical incharges on
/// uptime computed from the breakdown and power-out minutes, so moving minutes out
/// of `breakdown` raises the maintenance team's own payout. This table is the
/// answer to that — a log, not a flag, because the before-figure, the author and
/// the stated reason are all needed months later when a payout is argued about,
/// and a boolean on the Mis row answers none of those questions.
model MisDelayReclass {
  id              String   @id
  /// The Mis hourly row corrected. No hard FK, matching downtime_response.
  misId           String   @map("mis_id")
  /// DELAY_FIELDS keys from src/lib/downtimeShared.ts: process | cleaning |
  /// breakdown | powerout. Text, not an enum, so the vocabulary stays owned by
  /// that one file rather than being half here and half there.
  fromType        String   @map("from_type")
  toType          String   @map("to_type")
  /// Whole minutes moved, always > 0. Float only to match the delay columns it
  /// moves between (all `Float?` on Mis); delayReclass.ts refuses non-integers.
  minutes         Float
  /// Required, min 4 chars — the same bar as the finance duplicate-override.
  /// An unexplained move of paid minutes is indistinguishable from a mistake.
  reason          String
  /// Display name or email, for the tooltip. Nullable only because a session can
  /// carry neither; the action falls back to the user id rather than writing NULL.
  changedBy       String?  @map("changed_by")
  /// User.id as well as the name: attribution has to survive a rename or a
  /// leaver, because this is an edit to somebody's own incentive input.
  changedByUserId String?  @map("changed_by_user_id")
  changedAt       DateTime @default(now()) @map("changed_at") @db.Timestamp(6)

  @@index([misId])
  @@index([changedAt])
  @@map("mis_delay_reclass")
}

/// The maintenance log: anything from incharge up can raise a fault, with or
/// without a stoppage behind it. Two-way linked to DowntimeResponse via mis_id
/// when raised from a downtime incident. See src/lib/maintenanceLog.ts.
model MaintenanceTicket {
  id          String    @id
  ref         String    @unique
  title       String
  detail      String?
  area        String?
  priority    String    @default("Normal")
  status      String    @default("Pending")
  raisedBy    String?   @map("raised_by")
  raisedAt    DateTime  @default(now()) @map("raised_at") @db.Timestamp(6)
  misId       String?   @map("mis_id")
  response    String?
  respondedBy String?   @map("responded_by")
  respondedAt DateTime? @map("responded_at") @db.Timestamp(6)
  closedAt    DateTime? @map("closed_at") @db.Timestamp(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamp(6) // maintained by raw SQL, not @updatedAt

  @@index([misId], map: "maintenance_ticket_mis_idx")
  @@index([raisedAt(sort: Desc)], map: "maintenance_ticket_raised_idx")
  @@index([status])
  @@map("maintenance_ticket")
}

/// Preventive maintenance register — planned work the maintenance team did,
/// logged by the Maintenance Manager after the fact: this day, this hour,
/// this many minutes, at this station, doing this. Not a fault and not a
/// stoppage: nothing here implies the line was down.
model PreventiveMaintenance {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  date        DateTime @map("date") @db.Date
  hour        String   @map("hour") // the plant's hour vocabulary, "06 - 07"
  minutes     Int      @map("minutes")
  station     String   @map("station")
  description String   @map("description")
  actor       String?  @map("actor")
  enteredById String?  @map("entered_by_user_id")

  @@index([date])
  @@map("preventive_maintenance")
}

/// Optional photo attached to a shop-floor entry record — bytea in Postgres
/// because Vercel has no disk (like FinanceBillImage). Saved best-effort from
/// createRow/saveRow; (model, record_id) points at the owning row. See src/lib/entryPhoto.ts.
