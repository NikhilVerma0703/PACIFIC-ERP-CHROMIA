// ==========================================
// Shop-floor MIS side-tables. Hand-written models for tables created out-of-band
// with raw SQL (their libs keep using $queryRaw — the models exist so `db push`
// stops proposing to DROP them). NOT generated from Airtable; preserve across regens.
// ==========================================

/// Manual batch slab-range edits (src/lib/batchRange.ts): per-batch range
/// confirmations plus manually added/skipped slabs. One row per confirmation
/// or per slab; `kind` discriminates.
model BatchRangeEdit {
  id         String   @id
  batchKey   String   @map("batch_key")
  slabNumber Float?   @map("slab_number")
  kind       String
  enteredBy  String?  @map("entered_by")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([batchKey, kind, slabNumber])
  @@index([batchKey], map: "idx_bre_batch")
  @@map("batch_range_edit")
}

/// Maintenance's response on a downtime incident — one per MIS hourly row
/// (mis_id UNIQUE, no hard FK). May carry a dispute: maintenance's own duration
/// recorded BESIDE production's figure, never over it. See src/lib/downtimeResponse.ts.
model DowntimeResponse {
  id              String    @id
  misId           String    @unique @map("mis_id")
  status          String
  note            String?
  respondedBy     String?   @map("responded_by")
  respondedAt     DateTime  @default(now()) @map("responded_at") @db.Timestamp(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamp(6) // maintained by raw SQL, not @updatedAt
  disputedType    String?   @map("disputed_type")
  disputedMinutes Float?    @map("disputed_minutes")
  disputedBy      String?   @map("disputed_by")
  disputedAt      DateTime? @map("disputed_at") @db.Timestamp(6)

  @@map("downtime_response")
}

/// The maintenance log: anything from incharge up can raise a fault, with or
/// without a stoppage behind it. Two-way linked to DowntimeResponse via mis_id
/// when raised from a downtime incident. See src/lib/maintenanceLog.ts.
model MaintenanceTicket {
  id          String    @id
  ref         String    @unique
  title       String
  detail      String?
  area        String?
  priority    String    @default("Normal")
  status      String    @default("Pending")
  raisedBy    String?   @map("raised_by")
  raisedAt    DateTime  @default(now()) @map("raised_at") @db.Timestamp(6)
  misId       String?   @map("mis_id")
  response    String?
  respondedBy String?   @map("responded_by")
  respondedAt DateTime? @map("responded_at") @db.Timestamp(6)
  closedAt    DateTime? @map("closed_at") @db.Timestamp(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamp(6) // maintained by raw SQL, not @updatedAt

  @@index([misId], map: "maintenance_ticket_mis_idx")
  @@index([raisedAt(sort: Desc)], map: "maintenance_ticket_raised_idx")
  @@index([status])
  @@map("maintenance_ticket")
}

/// Optional photo attached to a shop-floor entry record — bytea in Postgres
/// because Vercel has no disk (like FinanceBillImage). Saved best-effort from
/// createRow/saveRow; (model, record_id) points at the owning row. See src/lib/entryPhoto.ts.
model EntryPhoto {
  id       String   @id
  model    String
  recordId String   @map("record_id")
  filename String
  mime     String
  data     Bytes
  takenBy  String?  @map("taken_by")
  at       DateTime @default(now()) @db.Timestamptz(6)

  @@index([model, recordId], map: "entry_photo_record")
  @@map("entry_photo")
}

