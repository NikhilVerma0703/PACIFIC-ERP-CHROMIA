// ─────────────────────────────────────────────────────────────────────────────
// Fabrication Module (erp-v4 integrated)
// All tables prefixed fab_ to avoid conflicts with existing Pacific-ERP tables.
// ─────────────────────────────────────────────────────────────────────────────

enum FabProjectStatus {
  PLANNING
  ALLOCATED
  RELEASED_TO_PRODUCTION
  COMPLETED
}

enum FabRequirementStatus {
  PENDING
  ALLOCATED
  RELEASED
}

enum FabPieceStatus {
  PENDING
  CUTTING
  CUT
  POLISHING
  POLISHED
  SINK_CUTTING
  SINK_CUT
  FABRICATION
  FABRICATED
  PACKAGED
  REJECTED
}

enum FabMachineType {
  CUTTING
  POLISHING
  SINK_CUTTING
  FABRICATION
  PACKAGING
}

enum FabOperationType {
  CUTTING
  POLISHING
  SINK_CUTTING
  FABRICATION
  PACKAGING
}

enum FabOperationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum FabSlabProductionStatus {
  READY
  IN_PROGRESS
  COMPLETED
}

enum FabShapeType {
  RECTANGLE
  L_SHAPE
  CURVE
  /// The original spelling of a circle, kept because live rows hold it.
  /// lib/fab/shape.ts reads ROUND and CIRCLE as the same thing, so a row
  /// written before scripts/0063 is still priced on a circumference rather
  /// than quietly becoming a rectangle.
  ROUND
  CUSTOM
  /// scripts/0063. `length` holds the DIAMETER; `width` is written equal to it,
  /// so the bounding box the slab actually loses falls out of the existing
  /// maths with no special case anywhere else.
  CIRCLE
  /// scripts/0063. `length` is a (the long axis), `width` is b (the short one)
  /// — the owner: "if it's oval enter a, b, long length and long width".
  /// Perimeter by Ramanujan II; see lib/fab/shape.ts.
  OVAL
}

model FabMachine {
  id         String               @id @default(cuid())
  code       String               @unique
  name       String
  type       FabMachineType
  createdAt  DateTime             @default(now()) @map("created_at")
  sessions   FabMachineSession[]
  operations FabOperation[]
  slabJobs   FabSlabJob[]
  downtimes  FabMachineDowntime[]

  @@map("fab_machine")
}

/// Floor roster. The operator login is shared; these names are who actually
/// stood at the machine for a process session. Supervisor creates them.
model FabWorker {
  id          String               @id @default(cuid())
  name        String               @unique
  active      Boolean              @default(true)
  createdAt   DateTime             @default(now()) @map("created_at")
  createdById String?              @map("created_by_id")
  createdBy   User?                @relation(fields: [createdById], references: [id])
  sessions    FabMachineSession[]
  operations  FabOperation[]
  slabJobs    FabSlabJob[]
  downtimes   FabMachineDowntime[]

  @@index([active])
  @@map("fab_worker")
}

model FabMachineSession {
  id         String     @id @default(cuid())
  userId     String     @map("user_id")
  user       User       @relation(fields: [userId], references: [id])
  machineId  String     @map("machine_id")
  machine    FabMachine @relation(fields: [machineId], references: [id])
  /// Who is standing at this process for this session. Null on sessions
  /// started before the roster existed.
  workerId   String?    @map("worker_id")
  worker     FabWorker? @relation(fields: [workerId], references: [id])
  shift      String
  loginTime  DateTime   @default(now()) @map("login_time")
  logoutTime DateTime?  @map("logout_time")
  isActive   Boolean    @default(true) @map("is_active")
  /// Slabs released to cutting from this session. scripts/0064 — this is the
  /// half that names the human, because the login above is shared by the whole
  /// floor and `worker` is not.
  releasedSlabJobs FabSlabJob[]
  /// Pieces sent to the hand bench from this session. scripts/0067 — the half
  /// that names the human, for the same reason releasedSlabJobs is.
  handAssignedPieces FabPiece[]   @relation("FabPieceHandAssignedSession")

  @@index([machineId, isActive])
  @@map("fab_machine_session")
}

/// Floor stoppage on one machine / process. Start and end are logged while a
/// process session is open so the name and shift are known.
model FabMachineDowntime {
  id          String     @id @default(cuid())
  machineId   String     @map("machine_id")
  machine     FabMachine @relation(fields: [machineId], references: [id])
  processType String     @map("process_type")
  reason      String
  notes       String?
  startedAt   DateTime   @default(now()) @map("started_at")
  endedAt     DateTime?  @map("ended_at")
  workerId    String?    @map("worker_id")
  worker      FabWorker? @relation(fields: [workerId], references: [id])
  shift       String?
  sessionId   String?    @map("session_id")
  userId      String     @map("user_id")

  @@index([machineId, endedAt])
  @@index([processType, endedAt])
  @@map("fab_machine_downtime")
}

model FabProject {
  id             String           @id @default(cuid())
  projectCode    String           @unique @map("project_code")
  /// PO or SAMPLE — what this project is FOR. A SAMPLE project is the sampling
  /// desk's own job and runs the same pipeline with sink and fabrication
  /// switched off. See src/lib/fab/sampleOrder.ts and scripts/0059.
  /// DECLARED BECAUSE `prisma db push` DROPS UNDECLARED COLUMNS. Do not remove.
  kind           String           @default("PO")
  customerName   String           @map("customer_name")
  status         FabProjectStatus @default(PLANNING)
  numberOfPieces Int              @default(0) @map("number_of_pieces")
  drawingPdfUrl  String?          @map("drawing_pdf_url")
  /// scripts/0067 — the whole project's fabrication charge, agreed by a human
  /// and replacing every calculation under it. The escape hatch of last resort.
  /// The calculated total is NOT destroyed: both are shown.
  /// DECLARED BECAUSE `prisma db push` DROPS UNDECLARED COLUMNS. Do not remove.
  manualTotal    Float?           @map("manual_total")
  /// DECLARED BECAUSE `prisma db push` DROPS UNDECLARED COLUMNS. Do not remove.
  manualTotalById String?         @map("manual_total_by")
  manualTotalBy   User?           @relation("FabProjectManualTotalBy", fields: [manualTotalById], references: [id])
  /// DECLARED BECAUSE `prisma db push` DROPS UNDECLARED COLUMNS. Do not remove.
  manualTotalAt  DateTime?        @map("manual_total_at")
  /// Why. Worth more than the number six months later.
  /// DECLARED BECAUSE `prisma db push` DROPS UNDECLARED COLUMNS. Do not remove.
  manualTotalNote String?         @map("manual_total_note")
  remarks        String?
  createdAt      DateTime         @default(now()) @map("created_at")
  slabs          FabSlab[]
  pieces         FabPiece[]
  requirements   FabRequirement[]
  drawings       FabDrawing[]
  pos            FabPo[]

  @@map("fab_project")
}

model FabDrawing {
  id            String           @id @default(cuid())
  drawingNumber String           @map("drawing_number")
  unitType      String?          @map("unit_type")
  units         Int?
  areaName      String?          @map("area_name")
  projectId     String           @map("project_id")
  project       FabProject       @relation(fields: [projectId], references: [id])
  defaultSlabId String?          @map("default_slab_id")
  defaultSlab   FabSlab?         @relation("DrawingDefaultSlab", fields: [defaultSlabId], references: [id])
  remarks       String?
  createdAt     DateTime         @default(now()) @map("created_at")
  pieces        FabPiece[]
  requirements  FabRequirement[]

  @@map("fab_drawing")
}

model FabSlab {
  id                     String                     @id @default(cuid())
  slabCode               String                     @map("slab_code")
  colour                 String?
  material               String?
  thickness              Float?
  length                 Float?
  width                  Float?
  totalArea              Float?                     @map("total_area")
  reservedArea           Float?                     @default(0) @map("reserved_area")
  availableArea          Float?                     @map("available_area")
  pacificQcId            String?                    @map("pacific_qc_id")
  projectId              String                     @map("project_id")
  project                FabProject                 @relation(fields: [projectId], references: [id])
  createdAt              DateTime                   @default(now()) @map("created_at")
  pieces                 FabPiece[]
  slabJobs               FabSlabJob[]
  allocations            FabSlabAllocation[]
  requirementAllocations FabRequirementAllocation[]
  assignedDrawings       FabDrawing[]               @relation("DrawingDefaultSlab")
  residuals              FabResidualBag[]

  /// The slab board reads every slab of one project. See scripts/0045.
  @@index([projectId])
  @@map("fab_slab")
}

model FabSlabJob {
  id              String                  @id @default(cuid())
  slabId          String                  @map("slab_id")
  slab            FabSlab                 @relation(fields: [slabId], references: [id])
  machineId       String?                 @map("machine_id")
  machine         FabMachine?             @relation(fields: [machineId], references: [id])
  /// Who is CUTTING this slab — written when the job STARTS, not when it is
  /// created. The cutting board compares it (and machineId) to tell one
  /// station's work from another's. For who RELEASED the slab, see
  /// releasedById / releasedBySessionId below; they are two different acts, by
  /// two different people more often than not.
  operatorId      String?                 @map("operator_id")
  operator        User?                   @relation("FabSlabJobOperator", fields: [operatorId], references: [id])
  workerId        String?                 @map("worker_id")
  worker          FabWorker?              @relation(fields: [workerId], references: [id])

  /// WHO SENT THIS SLAB TO CUTTING — the authenticated login. scripts/0064.
  ///
  /// A real name for a supervisor or manager, who each have their own login.
  /// The SHARED operator account for a floor release, which names nobody — see
  /// releasedBySessionId, which is the half that does. NULL on every job
  /// created before 0064; those were all supervisor releases, and a guessed id
  /// is indistinguishable from a recorded one the moment it is written.
  releasedById        String?             @map("released_by_id")
  releasedBy          User?               @relation("FabSlabJobReleasedBy", fields: [releasedById], references: [id])
  /// The process session the release was made from — its worker names the
  /// person, and it carries the machine and the shift with him. NULL for a desk
  /// release with no station session open, which is the ordinary supervisor
  /// case. The route REQUIRES it for an EMPLOYEE release: without it the record
  /// would be empty for exactly the person it exists for.
  releasedBySessionId String?             @map("released_by_session_id")
  releasedBySession   FabMachineSession?  @relation(fields: [releasedBySessionId], references: [id])

  status          FabSlabProductionStatus @default(READY)
  startTime       DateTime?               @map("start_time")
  endTime         DateTime?               @map("end_time")
  usedAreaSqft    Float?                  @map("used_area_sqft")
  totalWastagePct Float?                  @map("total_wastage_pct")
  trueScrapPct    Float?                  @map("true_scrap_pct")
  kerfMm          Float?                  @default(3) @map("kerf_mm")
  createdAt       DateTime                @default(now()) @map("created_at")

  /// "Has this slab already gone to the cutter?" — asked before every edit
  /// on the slab board and by approve-slab's idempotency check, always
  /// filtered on status as well. See scripts/0045.
  @@index([slabId, status])
  /// "Which slabs were cut between these two dates?" — the CLO half of the
  /// cutting number on the CEO dashboard. The other index leads on slab_id and
  /// cannot serve a scan by status and time. See scripts/0046.
  @@index([status, endTime])
  @@map("fab_slab_job")
}

/// A customer purchase order under a project. A project may hold several POs;
/// the piece rows of each PO's PDF become fab_requirement rows carrying po_id.
/// See scripts/0044-fab-po.sql.
model FabPo {
  id            String           @id @default(cuid())
  projectId     String           @map("project_id")
  project       FabProject       @relation(fields: [projectId], references: [id])
  poNumber      String           @map("po_number")
  /// The uploaded PO PDF's file name, so a manager can tell which document a
  /// set of requirements came from. Null until the PDF is imported.
  pdfFileName   String?          @map("pdf_file_name")
  pdfImportedAt DateTime?        @map("pdf_imported_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  requirements  FabRequirement[]

  /// Unique WITHIN a project, not globally: two customers may legitimately
  /// send the same external PO number. Also the index for "find this PO".
  @@unique([projectId, poNumber])
  /// The PO list on a project page: where project_id = ? order by created_at desc.
  @@index([projectId, createdAt])
  @@map("fab_po")
}

model FabRequirement {
  id                  String                     @id @default(cuid())
  projectId           String                     @map("project_id")
  project             FabProject                 @relation(fields: [projectId], references: [id])
  /// WHICH SHELF THIS SAMPLE ROW CREDITS when its pieces are packed — the
  /// colour AND its finish, never the colour alone. NULL on every purchase-order
  /// row. scripts/0059; declared here because db push drops undeclared columns.
  colourFinishId      String?                    @map("colour_finish_id")
  colourFinish        ProductColourFinish?       @relation(fields: [colourFinishId], references: [id])
  /// The catalogue size ordered. The row also carries length/width in inches for
  /// the saw; this is the shelf those inches came from, so packing credits what
  /// was ORDERED rather than something that merely measures the same.
  samplingSizeId      String?                    @map("sampling_size_id")
  samplingSize        SamplingSize?              @relation(fields: [samplingSizeId], references: [id])
  drawingId           String?                    @map("drawing_id")
  drawing             FabDrawing?                @relation(fields: [drawingId], references: [id])
  /// The purchase order this row came off, when it came from a PO PDF.
  /// Nullable: every requirement created before the PO intake existed has none.
  poId                String?                    @map("po_id")
  po                  FabPo?                     @relation(fields: [poId], references: [id])
  pieceLabel          String?                    @map("piece_label")
  /// THE ROW'S LETTER in the piece code {projectCode}-{LETTER}-{n}: A, B … Z,
  /// AA, AB (lib/fab/pieceNaming.ts). Assigned ONCE when the row is imported
  /// and never recomputed — deriving it from row order at read time would
  /// silently re-letter every piece already cut and stickered the moment a
  /// second purchase order joined the project, and a label on stone cannot be
  /// migrated. Unique per PROJECT, because the code's root is the project code.
  ///
  /// Nullable for the rows that predate scripts/0054; those keep showing their
  /// imported piece_label ("Row 3") rather than being given a letter no piece
  /// of stone carries. See rowLabel().
  rowLetter           String?                    @map("row_letter")
  /// WHICH EDGES OF THIS ROW'S PIECES ARE FINISHED, and therefore charged:
  /// a canonical comma-separated list, "front,back,left,right". Empty string
  /// means none; NULL means nobody has chosen yet, which is not the same thing
  /// and is why it is nullable.
  ///
  /// PER ROW, not per piece — the owner's rule: "same row all have same". Every
  /// piece of row A is the same size and gets the same treatment, so one picker
  /// per row is enough and one per piece would be absurd.
  ///
  /// Edge work is charged by the RUNNING FOOT (2 cm ₹15, 3 cm ₹20), so this
  /// column times the row's dimensions and quantity is the whole edge charge.
  /// See lib/fab/pricing.ts, which owns the arithmetic and the rate card.
  finishedEdges       String?                    @map("finished_edges")
  /// WHICH FACE(S) of the chosen edges get hand polish: TOP / BOTTOM / BOTH.
  /// scripts/0065.
  ///
  /// The owner: "hand edge polish have like not only 4 direction N E S W, also
  /// whether this on top or bottom or both as well." An edge is a band with two
  /// arrises, and doing both is the same line walked TWICE — so this MULTIPLIES
  /// the running feet rather than adding a fee. A 60-piece row at 505 ft is
  /// 1,010 ft and ₹15,150 at 2 cm, against ₹7,575.
  ///
  /// NULL MEANS TOP, and that is deliberately different from finishedEdges,
  /// where NULL is a real unanswered question. Every row that existed before
  /// this column was charged as one face; if NULL were "not chosen" it would
  /// take every one of them off the invoice the day the script ran. So NULL
  /// keeps charging exactly what it charged yesterday, and BOTH must be
  /// chosen — the expensive direction is never fallen into.
  edgeFaces           String?                    @map("edge_faces")
  /// scripts/0067 — THE THREE-FACE HAND-POLISH SPECIFICATION. Each holds the
  /// same canonical CSV finishedEdges uses (front,back,left,right, or the
  /// single word `round`), and each is INDEPENDENT: "top on 4 side, bottom on
  /// 2, side on 4". Summed, never multiplied.
  ///
  /// ALL THREE NULL means this row has no three-face spec and is read from
  /// finishedEdges + edgeFaces above — which is every row written before 0067,
  /// and is why none of their figures moved. An EMPTY STRING is a real answer:
  /// asked, and this face gets nothing.
  /// DECLARED BECAUSE `prisma db push` DROPS UNDECLARED COLUMNS. Do not remove.
  edgesTop            String?                    @map("edges_top")
  /// DECLARED BECAUSE `prisma db push` DROPS UNDECLARED COLUMNS. Do not remove.
  edgesBottom         String?                    @map("edges_bottom")
  /// The BAND itself — the vertical thickness face, normally machine polished
  /// and sometimes done by hand instead. Never produced from the legacy pair.
  /// DECLARED BECAUSE `prisma db push` DROPS UNDECLARED COLUMNS. Do not remove.
  edgesSide           String?                    @map("edges_side")
  /// This row's OWN rate, in the unit pricingMode implies. NULL FALLS BACK TO
  /// THE RATE CARD (Rs15 at 2 cm, Rs20 at 3 cm), which is what every ordinary
  /// row does — nobody types a rate unless the job is unusual. Zero is a real
  /// rate and is honoured; NULL is not zero.
  /// DECLARED BECAUSE `prisma db push` DROPS UNDECLARED COLUMNS. Do not remove.
  edgeRate            Float?                     @map("edge_rate")
  /// scripts/0069 — RUPEES PER FOOT FOR A SIDE DONE ON BOTH TOP AND BOTTOM,
  /// replacing two passes at edgeRate. The owner: "if per feet 10 rs then doing
  /// top + bottom we will give them 15 not 20."
  ///
  /// NULL MEANS NO DISCOUNT and the two faces are simply summed at edgeRate,
  /// which is what every row written before 0069 is charged — so nothing
  /// already quoted moves. Zero is a real pair rate and is honoured.
  /// Applies to the sides that share BOTH faces and to nothing else; the side
  /// band never pairs. RUNNING_FOOT only. See facePairSplit in lib/fab/shape.ts.
  /// DECLARED BECAUSE `prisma db push` DROPS UNDECLARED COLUMNS. Do not remove.
  pairRate            Float?                     @map("pair_rate")
  /// scripts/0070 — A RATE PER FACE. The owner: "bottom edge have diff price
  /// sometime, top have diff price sometime and side have different price
  /// sometime." Each NULL falls back to edgeRate, which falls back to the rate
  /// card — so a row with all three empty prices exactly as it did before 0070.
  /// A side polished on both faces uses pairRate, or top + bottom when pairRate
  /// is NULL. The side band never shares a rate with a flat face.
  /// DECLARED BECAUSE `prisma db push` DROPS UNDECLARED COLUMNS. Do not remove.
  edgeRateTop         Float?                     @map("edge_rate_top")
  /// DECLARED BECAUSE `prisma db push` DROPS UNDECLARED COLUMNS. Do not remove.
  edgeRateBottom      Float?                     @map("edge_rate_bottom")
  /// DECLARED BECAUSE `prisma db push` DROPS UNDECLARED COLUMNS. Do not remove.
  edgeRateSide        Float?                     @map("edge_rate_side")
  /// RUNNING_FOOT (default, and NULL means this) / PER_PIECE / LUMP_SUM.
  /// HAND POLISH ONLY — the sink is fixed per piece off the card in every mode.
  /// DECLARED BECAUSE `prisma db push` DROPS UNDECLARED COLUMNS. Do not remove.
  pricingMode         String?                    @map("pricing_mode")
  /// A figure a human agreed, replacing this row's calculated hand-polish
  /// charge — "when system feels heavy they call and enter the amount". Also
  /// rescues a row the system refuses to price. Does NOT touch the sink.
  /// DECLARED BECAUSE `prisma db push` DROPS UNDECLARED COLUMNS. Do not remove.
  edgeTotalOverride   Float?                     @map("edge_total_override")
  /// DECLARED BECAUSE `prisma db push` DROPS UNDECLARED COLUMNS. Do not remove.
  edgeTotalOverrideById String?                  @map("edge_total_override_by")
  edgeTotalOverrideBy   User?                    @relation("FabRequirementEdgeOverrideBy", fields: [edgeTotalOverrideById], references: [id])
  /// DECLARED BECAUSE `prisma db push` DROPS UNDECLARED COLUMNS. Do not remove.
  edgeTotalOverrideAt DateTime?                  @map("edge_total_override_at")
  description         String?
  slabCode            String                     @map("slab_code")
  length              Float?
  width               Float?
  /// scripts/0068 — THE UNIT THE CUSTOMER ORDERED IN, for display only: 'CM'
  /// or 'IN'. NULL means IN and is not a missing answer — every row written
  /// before 0068 came off a packing list in inches and square feet.
  ///
  /// length/width above are ALWAYS INCHES whatever this says, because
  /// sqft_per_piece is length*width/144 and the running-foot edge charge is
  /// perimeter/12. A centimetre in those columns is a 2.54x overcharge that
  /// looks entirely ordinary on screen. src/lib/fab/dimensions.ts is the only
  /// thing that reads this, and priceRow() must never learn about it.
  /// DECLARED BECAUSE `prisma db push` DROPS UNDECLARED COLUMNS. Do not remove.
  dimUnit             String?                    @map("dim_unit")
  thickness           Float?
  quantity            Int
  shapeType           FabShapeType?              @map("shape_type")
  sinkRequired        Boolean                    @default(false) @map("sink_required")
  fabricationRequired Boolean                    @default(false) @map("fabrication_required")
  polishRequired      Boolean                    @default(false) @map("polish_required")
  // How many of `quantity` pieces get a sink — the supervisor's call, per row,
  // replacing the sheet's sink_cuts column. NULL = he has not looked at this row
  // yet, 0 = he looked and said none; both route to no sink. Equal to quantity
  // means all of them. See scripts/0043-fab-requirement-sink-quantity.sql and
  // resolveSinkQuantity() in src/lib/fab/requirement-derive.ts.
  sinkQuantity        Int?                       @map("sink_quantity")
  sinkModel           String?                    @map("sink_model")
  sinkCuts            Int?                       @default(0) @map("sink_cuts")
  faucetCount         Int?                       @default(0) @map("faucet_count")
  depLength           Float?                     @map("dep_length")
  jointCount          Int?                       @default(0) @map("joint_count")
  jointDepLength      Float?                     @map("joint_dep_length")
  radiusCorners       Int?                       @default(0) @map("radius_corners")
  sqftPerPiece        Float?                     @map("sqft_per_piece")
  totalSqft           Float?                     @map("total_sqft")
  notes               String?
  status              FabRequirementStatus       @default(PENDING)
  createdAt           DateTime                   @default(now()) @map("created_at")
  pieces              FabPiece[]
  allocations         FabRequirementAllocation[]

  /// The PO detail screen reads every requirement of one PO. Postgres does
  /// not index a foreign key for you, and without this the lookup is a
  /// sequential scan of every requirement in the system.
  @@index([poId])
  /// Both supervisor boards, and release-project, read every requirement of
  /// one project. See scripts/0045.
  @@index([projectId])
  @@map("fab_requirement")
}

model FabRequirementAllocation {
  id                String         @id @default(cuid())
  requirementId     String         @map("requirement_id")
  requirement       FabRequirement @relation(fields: [requirementId], references: [id])
  slabId            String         @map("slab_id")
  slab              FabSlab        @relation(fields: [slabId], references: [id])
  allocatedQuantity Int            @map("allocated_quantity")
  createdAt         DateTime       @default(now()) @map("created_at")

  /// "Everything this piece row is allocated to, across slabs" — the sum the
  /// no-over-allocation rule is checked against, re-read inside a transaction
  /// on every assignment. See scripts/0045.
  @@index([requirementId])
  /// "The rows on this slab" — the slab cards and the loss recomputation in
  /// approve-slab.
  @@index([slabId])
  @@map("fab_requirement_allocation")
}

model FabPiece {
  id                   String              @id @default(cuid())
  pieceCode            String              @unique @map("piece_code")
  /// The sampling_intake row this piece created when it was PACKED, if it is a
  /// sample piece. Its presence is what stops a re-run of packaging crediting
  /// the shelf twice. NULL for a purchase-order piece. scripts/0059.
  samplingIntakeId     String?             @unique @map("sampling_intake_id")
  samplingIntake       SamplingIntake?     @relation(fields: [samplingIntakeId], references: [id])
  projectId            String              @map("project_id")
  project              FabProject          @relation(fields: [projectId], references: [id])
  slabId               String?             @map("slab_id")
  slab                 FabSlab?            @relation(fields: [slabId], references: [id])
  drawingId            String?             @map("drawing_id")
  drawing              FabDrawing?         @relation(fields: [drawingId], references: [id])
  requirementId        String?             @map("requirement_id")
  requirement          FabRequirement?     @relation(fields: [requirementId], references: [id])
  shapeType            FabShapeType?       @map("shape_type")
  length               Float?
  width                Float?
  remarks              String?
  hasSink              Boolean             @default(false) @map("has_sink")
  /// HAND edge polish — the outsourced running-foot job, not the machine polish
  /// the operator does, and not the sink polish (which is implied by the sink
  /// cut and priced inside the per-piece sink rate).
  ///
  /// INDEPENDENT OF hasSink since scripts/0063. The owner: "any pieces can be
  /// assigned the edge hand polish or not — this is chosen and done by
  /// supervisor, or else the one manager who uploads the PO." A plain piece can
  /// have it and a sink piece can go without.
  ///
  /// Stamped at release from the row's finished_edges, which under the group
  /// rule applies to every piece of the row. Not backfilled — see 0063.
  hasEdgePolish        Boolean             @default(false) @map("has_edge_polish")
  /// scripts/0067 — THIS PIECE WAS MOVED FROM THE POLISHING MACHINE TO THE HAND
  /// BENCH: the machine could not do the profile, was busy, or broke down.
  ///
  /// It OVERRIDES its row's edge charge for this piece alone, using the hand*
  /// fields below. Every piece of the row that did not move keeps the row
  /// price. THIS IS THE ONE PLACE THE HOMOGENEOUS-ROW RULE DOES NOT HOLD, and
  /// it is deliberate: a machine failing at nine at night takes the pieces in
  /// front of it, mid-row, and nobody renumbers an order around that.
  ///
  /// Pricing only — the piece still routes through the polishing queue.
  /// DECLARED BECAUSE `prisma db push` DROPS UNDECLARED COLUMNS. Do not remove.
  polishByHand         Boolean             @default(false) @map("polish_by_hand")
  /// WHAT THIS PIECE EARNED, frozen when it was packed (scripts/0066). The
  /// period report reads these instead of re-pricing a closed month, so a rate
  /// card edited later cannot rewrite what was already paid. Declared here
  /// because the columns exist in the database and Prisma DROPS any column no
  /// model describes: without these three lines a `db push` would delete every
  /// frozen charge permanently.
  chargedEdge    Float?    @map("charged_edge")
  chargedSink    Float?    @map("charged_sink")
  chargedAt      DateTime? @map("charged_at")
  /// DECLARED BECAUSE `prisma db push` DROPS UNDECLARED COLUMNS. Do not remove.
  handEdgesTop         String?             @map("hand_edges_top")
  /// DECLARED BECAUSE `prisma db push` DROPS UNDECLARED COLUMNS. Do not remove.
  handEdgesBottom      String?             @map("hand_edges_bottom")
  /// DECLARED BECAUSE `prisma db push` DROPS UNDECLARED COLUMNS. Do not remove.
  handEdgesSide        String?             @map("hand_edges_side")
  /// What was agreed for THIS piece — "it need to ask the cost on how much per
  /// feet". NULL falls back to the card.
  /// DECLARED BECAUSE `prisma db push` DROPS UNDECLARED COLUMNS. Do not remove.
  handRate             Float?              @map("hand_rate")
  /// scripts/0069 — this piece's own pair rate at the hand bench: rupees per
  /// foot for a side polished on both top and bottom. NULL means no discount.
  /// The per-piece counterpart of FabRequirement.pairRate.
  /// DECLARED BECAUSE `prisma db push` DROPS UNDECLARED COLUMNS. Do not remove.
  handPairRate         Float?              @map("hand_pair_rate")
  /// scripts/0070 — this piece's own per-face rates at the hand bench. Each
  /// NULL falls back to handRate.
  /// DECLARED BECAUSE `prisma db push` DROPS UNDECLARED COLUMNS. Do not remove.
  handRateTop          Float?              @map("hand_rate_top")
  /// DECLARED BECAUSE `prisma db push` DROPS UNDECLARED COLUMNS. Do not remove.
  handRateBottom       Float?              @map("hand_rate_bottom")
  /// DECLARED BECAUSE `prisma db push` DROPS UNDECLARED COLUMNS. Do not remove.
  handRateSide         Float?              @map("hand_rate_side")
  /// DECLARED BECAUSE `prisma db push` DROPS UNDECLARED COLUMNS. Do not remove.
  handPricingMode      String?             @map("hand_pricing_mode")
  /// DECLARED BECAUSE `prisma db push` DROPS UNDECLARED COLUMNS. Do not remove.
  handTotalOverride    Float?              @map("hand_total_override")
  /// DECLARED BECAUSE `prisma db push` DROPS UNDECLARED COLUMNS. Do not remove.
  handAssignedById     String?             @map("hand_assigned_by_id")
  handAssignedBy       User?               @relation("FabPieceHandAssignedBy", fields: [handAssignedById], references: [id])
  /// THE HALF THAT NAMES THE HUMAN. The floor shares one operator login, so
  /// handAssignedById reads "operator@..." for every floor reassignment while
  /// the session carries the worker, the machine and the shift. Same reasoning
  /// as scripts/0064.
  /// DECLARED BECAUSE `prisma db push` DROPS UNDECLARED COLUMNS. Do not remove.
  handAssignedSessionId String?            @map("hand_assigned_session_id")
  handAssignedSession   FabMachineSession? @relation("FabPieceHandAssignedSession", fields: [handAssignedSessionId], references: [id])
  /// DECLARED BECAUSE `prisma db push` DROPS UNDECLARED COLUMNS. Do not remove.
  handAssignedAt       DateTime?           @map("hand_assigned_at")
  polishRequired       Boolean             @default(false) @map("polish_required")
  fabricationRequired  Boolean             @default(false) @map("fabrication_required")
  polishingCompleted   Boolean             @default(false) @map("polishing_completed")
  sinkCompleted        Boolean             @default(false) @map("sink_completed")
  fabricationCompleted Boolean             @default(false) @map("fabrication_completed")
  status               FabPieceStatus      @default(PENDING)
  createdAt            DateTime            @default(now()) @map("created_at")
  operations           FabOperation[]
  pieceOperations      FabPieceOperation[]
  allocations          FabSlabAllocation[]
  packagePieces        FabPackagePiece[]
  rejectedAt           DateTime?           @map("rejected_at")
  rejectReason         String?             @map("reject_reason")
  rejectNotes          String?             @map("reject_notes")
  rejectedByWorkerId   String?             @map("rejected_by_worker_id")

  @@map("fab_piece")
}

model FabSlabAllocation {
  id            String   @id @default(cuid())
  pieceId       String   @map("piece_id")
  piece         FabPiece @relation(fields: [pieceId], references: [id])
  slabId        String   @map("slab_id")
  slab          FabSlab  @relation(fields: [slabId], references: [id])
  allocatedArea Float?   @map("allocated_area")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("fab_slab_allocation")
}

model FabOperation {
  id              String              @id @default(cuid())
  pieceId         String              @map("piece_id")
  piece           FabPiece            @relation(fields: [pieceId], references: [id])
  machineId       String?             @map("machine_id")
  machine         FabMachine?         @relation(fields: [machineId], references: [id])
  operatorId      String              @map("operator_id")
  operator        User                @relation(fields: [operatorId], references: [id])
  workerId        String?             @map("worker_id")
  worker          FabWorker?          @relation(fields: [workerId], references: [id])
  shift           String?
  operationType   FabOperationType    @map("operation_type")
  pieceOperations FabPieceOperation[]
  startTime       DateTime?           @map("start_time")
  endTime         DateTime?           @map("end_time")
  remarks         String?
  status          FabOperationStatus  @default(IN_PROGRESS)
  createdAt       DateTime            @default(now()) @map("created_at")

  @@map("fab_operation")
}

model FabPieceOperation {
  id            String           @id @default(cuid())
  pieceId       String           @map("piece_id")
  piece         FabPiece         @relation(fields: [pieceId], references: [id])
  operationType FabOperationType @map("operation_type")
  sequence      Int
  isRequired    Boolean          @default(true) @map("is_required")
  isCompleted   Boolean          @default(false) @map("is_completed")
  startedAt     DateTime?        @map("started_at")
  completedAt   DateTime?        @map("completed_at")
  operationId   String?          @map("operation_id")
  operation     FabOperation?    @relation(fields: [operationId], references: [id])
  createdAt     DateTime         @default(now()) @map("created_at")

  /// "What was finished between these two dates?" — the CEO dashboard's
  /// single-day strip, its date-wise stage breakdown (up to 92 days, grouped
  /// in the database) and its 30-minute idle window all ask exactly this, and
  /// the table carried no index at all until now. See scripts/0046.
  @@index([isCompleted, completedAt])
  /// 0051 hot-path (2026-08-23): Postgres does not index foreign keys on its own, so every
  /// `pieceOperations` include (one child query per queue poll, every 15-20 s per station), the
  /// cutting-queue / CEO "pending CUTTING op" EXISTS probe, and the per-piece updateMany in the
  /// eight complete/undo routes all walked the whole table to find one piece's operations.
  @@index([pieceId])
  @@map("fab_piece_operation")
}

model FabPackage {
  id          String            @id @default(cuid())
