// ============================================================================
// PRODUCT CATALOGUE (shared, product_*) + SAMPLING MODULE (sampling_*)
//
// The sampling module cuts quartz slabs into sample pieces, keeps them in one
// place, and packs and ships them to customers. Extra usable pieces left over
// from cut-to-size fabrication jobs become sample stock too.
//
// SAMPLING IS A ROLE, NOT A DEPARTMENT. Role.SAMPLING is a capped login gated
// exactly like ROBO and CHROMIA — the module and its APIs, nothing else — and
// NO Branch value was added for it. It was designed as a department, back when
// Chromia was one; Chromia has since been retired AS a department (Branch
// CHROMIA survives only so old rows decode, and scripts/0046 moves those logins
// onto Role.CHROMIA), so the surviving shape for a single-purpose module is the
// capped role. See lib/sampling/actions.ts for who may do what — including the
// Fabrication Supervisor, who may add stock and nothing else because the
// offcuts are his — lib/sampling/size.ts for the size rules, and
// lib/sampling/lifecycle.ts for the status machine.
//
// WHY THE CATALOGUE IS NOT CALLED Sampling*. Sampling is the first module that
// needs a curated series/colour master, but it is not the only one that will
// use it: fabrication buys against these colour names already ("Arva White" is
// the material on PO 10026, lib/fab/poParser.ts) and the polishing line calls
// the same string a "design" (polish_qc.design). So the three catalogue tables
// are product_*, they carry nothing sampling-specific, and product_colour.name
// is globally UNIQUE so a PO line or a QC row can resolve one colour by name
// without knowing its series. Only the tables that are genuinely about sample
// pieces are sampling_*.
//
// FINISH IS A VARIANT OF A COLOUR, NOT A COLOUR (the owner's decision 3).
// Cappuccino comes in Polished and Leather: ONE product_colour row, TWO
// product_colour_finish rows. Stock, intake and dispatch lines all point at
// the colour+finish row, never at the colour — because "50 Cappuccino 4x4" is
// not a stock figure until you know which finish. The finish vocabulary is a
// string, not an enum, so adding one needs no DDL; the canonical spellings
// live in lib/catalogue/colours.ts.
//
// UNITS. sampling_size stores length and width in INCHES and thickness in
// MILLIMETRES, and every column name says which. This is the fabrication
// convention (fab_requirement is inches, fab_slab and
// chromia_base_material.default_thickness_mm are millimetres) and it is named
// in full because lib/fab/slabLoss.ts is this repo's standing warning about
// what silent unit-mixing costs. See lib/sampling/size.ts.
//
// Seeded by prisma/seed-catalogue.ts (`npm run db:seed:catalogue`), which is
// safe against production. Applied to Neon via
// scripts/0051-sampling-and-catalogue.sql (NOT db push). Hand-maintained; NOT
// touched by gen-schema.py.
// ============================================================================

/// A range in the colour chart — Kosmic, Nebula, Eclipse, Aurora, Solids,
/// Celestia, Luminara. Seven of them; the owner says six, because Solids is
/// two plain whites rather than a range. See prisma/seed-catalogue.ts.
model ProductSeries {
  id        String   @id @default(cuid())
  name      String   @unique
  /// Chart order, so a pick-list reads the way the printed chart does.
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  colours ProductColour[]

  @@map("product_series")
}

/// One colour, in one series. "Cappuccino (Leather)" is NOT one of these — it
/// is the Leather finish of Cappuccino. "Cappuccino Dark" IS one of these: a
/// darker colour, not a finish.
model ProductColour {
  id       String        @id @default(cuid())
  seriesId String        @map("series_id")
  series   ProductSeries @relation(fields: [seriesId], references: [id])
  /// UNIQUE ACROSS EVERY SERIES, deliberately: fabrication and QC name a
  /// colour without naming its series, so a duplicate would make that lookup
  /// ambiguous. prisma/seed-catalogue.ts refuses to run if the chart ever
  /// lists one name twice.
  name     String        @unique
  /// Chart order within the series.
  position Int           @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  finishes ProductColourFinish[]

  /// "The colours of this series" — the pick-list behind step 2 of adding
  /// stock (series -> colour -> finish -> size). Postgres does not index a
  /// foreign key for you.
  @@index([seriesId])
  @@map("product_colour")
}

/// A colour in one finish — Polished, Leather, Suede, Honed. This is the row
/// stock is actually counted against. Every colour has at least the default
/// (Polished); three of today's 56 carry a second finish.
model ProductColourFinish {
  id       String        @id @default(cuid())
  colourId String        @map("colour_id")
  colour   ProductColour @relation(fields: [colourId], references: [id])
  /// One of lib/catalogue/colours.ts FINISHES. A string rather than an enum so
  /// adding a finish is a seed edit, not a migration.
  finish   String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stock         SamplingStock[]
  intakes       SamplingIntake[]
  dispatchLines SamplingDispatchLine[]
  /// Sample ORDERS placed against this colour+finish — fab_requirement rows on a
  /// SAMPLE project. The other half of the relation added in scripts/0059.
  sampleRows    FabRequirement[]

  /// One row per colour+finish, and the index for "the finishes of this
  /// colour" — its colour_id prefix serves the foreign key too.
  @@unique([colourId, finish])
  @@map("product_colour_finish")
}

/// A sample size, created the first time it is typed and reused from then on.
/// There are no standard sizes (the owner's decision 1) and nobody curates the
/// list, so the normalisation in lib/sampling/size.ts is the only thing
/// stopping two spellings of one size splitting a pile of stock into two
/// half-counts. THICKNESS IS PART OF THE SIZE (decision 2): Cappuccino 4x4 in
/// 2 cm and Cappuccino 4x4 in 3 cm are different stock.
model SamplingSize {
  id          String  @id @default(cuid())
  /// INCHES. The LONGER edge — 4x6 and 6x4 are the same size and fold onto one
  /// row (a sample piece has no orientation; see lib/sampling/size.ts). The
  /// ordering is enforced in code, not by a CHECK constraint, because Prisma
  /// cannot model one and an unmodelled constraint reads as drift.
  lengthIn    Decimal @map("length_in") @db.Decimal(10, 2)
  /// INCHES. The shorter edge.
  widthIn     Decimal @map("width_in") @db.Decimal(10, 2)
  /// MILLIMETRES, whole. 20 for 2 cm, 30 for 3 cm, 12 for 12 mm.
  thicknessMm Int     @map("thickness_mm")

  /// users.id of whoever typed it first (no hard FK — the Sales/Chromia
  /// precedent), so a size nobody recognises can be traced to a person.
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  stock         SamplingStock[]
  intakes       SamplingIntake[]
  dispatchLines SamplingDispatchLine[]
  /// Sample ORDERS placed against this size — fab_requirement rows on a SAMPLE
  /// project. The other half of the relation added in scripts/0059.
  sampleRows    FabRequirement[]

  /// The identity of a size, and the constraint that makes "typed twice" one
  /// row. NUMERIC scale does the rest: 4, 4.0 and 4.00 are the same value.
  @@unique([lengthIn, widthIn, thicknessMm])
  @@map("sampling_size")
}

/// Pieces on the shelf, per colour+finish and size. One row per combination;
/// the quantity moves, the row does not. Stock leaves at RELEASE, not at
/// dispatch — the pieces are physically pulled when the package is packed.
model SamplingStock {
  id             String              @id @default(cuid())
  colourFinishId String              @map("colour_finish_id")
  colourFinish   ProductColourFinish @relation(fields: [colourFinishId], references: [id])
  sizeId         String              @map("size_id")
  size           SamplingSize        @relation(fields: [sizeId], references: [id])
  /// Never negative. Enforced in lib/sampling/lifecycle.ts checkRelease, which
  /// the release transaction runs against a re-read count.
  quantity       Int                 @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// The point lookup every intake and every release does, and the index for
  /// "every size of this colour+finish" — the inventory screen's main row.
  @@unique([colourFinishId, sizeId])
  /// The other way round: "who has 4x4 in 2 cm, across all colours" — the
  /// question asked when a customer wants a size rather than a colour.
  @@index([sizeId])
  @@map("sampling_stock")
}

/// Where a piece came from. Deliberate sample cutting, or a usable offcut from
/// a cut-to-size fabrication job.
enum SamplingIntakeSource {
  SAMPLE_CUTTING
  FAB_OFFCUT

  @@map("sampling_intake_source")
}

/// One addition of stock. Append-only: sampling_stock carries the running
/// count, this carries how it got there.
///
/// NO FOREIGN KEY TO fab_residual_piece, on purpose. The offcut side already
/// has designed-for-it models (FabResidualBag / FabResidualPiece) but NOTHING
/// writes them — they are dead, and a hard link would make sampling intake
/// wait on a fabrication feature that has no owner. They also cannot carry
/// what a sample needs: a residual piece has length and width but no thickness
/// and no colour, and thickness is half of what makes a sample size. sourceRef
/// is the seam — the slab or bag number as written on the piece — so the day
/// fab_residual_bag is really written, the bridge is one nullable column and a
/// match on that text, not a re-model.
model SamplingIntake {
  id             String               @id @default(cuid())
  colourFinishId String               @map("colour_finish_id")
  colourFinish   ProductColourFinish  @relation(fields: [colourFinishId], references: [id])
  sizeId         String               @map("size_id")
  size           SamplingSize         @relation(fields: [sizeId], references: [id])
  quantity       Int
  source         SamplingIntakeSource
  /// Free text: the slab number, bag code or job the pieces came off. REQUIRED
  /// in practice for the two fabrication sources — the route refuses a
  /// SAMPLE_CUTTING or FAB_OFFCUT intake without one, because stock nobody can
  /// trace back to a slab cannot be repaired once the slab has gone. Left
  /// nullable in the column so the sampling desk's own additions, which have no
  /// slab behind them, do not have to invent a reference.
  sourceRef      String?              @map("source_ref")
  /// polish_qc.id — the QC slab these pieces were cut from.
  ///
  /// NO HARD FOREIGN KEY, matching source_ref's own note and the Sales/Chromia
  /// precedent: polish_qc is imported from the polishing line and its rows are
  /// re-imported, so a constraint here would make a QC re-import fail on
  /// sampling history. source_ref stays the human answer ("slab 154700"); this
  /// is what "every sample cut off this slab" actually joins on.
  sourceQcId     String?              @map("source_qc_id")
  /// fab_slab.id — the slab on the supervisor's board these came off.
  ///
  /// source_qc_id answers "which stone"; this answers "which slab card", and
  /// they are not the same question: fabrication's accounting is per fab_slab
  /// (that is what carries the allocations and the loss figures), and a QC slab
  /// can be put on the board more than once across projects. This is the column
  /// computeSlabLoss's sampledAreaSqft is summed over — without it, stone that
  /// left as samples was reported as scrap AND left the slab's PO capacity
  /// unchanged.
  ///
  /// No hard FK, like the two references above it: deleting fab test data
  /// (scripts/0037) must not have to reason about sampling history, and a
  /// dangling reference is still a better record than none.
  sourceSlabId   String?              @map("source_slab_id")
  note           String?

  /// users.id of whoever added it (no hard FK). A Fabrication Supervisor may
  /// add stock and nothing else, so this is not always sampling staff.
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  /// "What came in recently" — the intake list, newest first.
  @@index([createdAt])
  /// "How did this stock row get to that number" — the audit when a count
  /// looks wrong.
  @@index([colourFinishId, sizeId])
  /// "How much of our stock is offcut rather than cut-to-sample, this month" —
  /// the question the source column exists to answer.
  @@index([source, createdAt])
  /// The size_id foreign key. Nothing above covers it — both composites lead
  /// with colour_finish_id — and an unindexed FK makes a size lookup a
  /// sequential scan.
  @@index([sizeId])
  /// "Everything cut off slab 154700" — the traceability question source_qc_id
  /// exists to answer, asked from the QC side.
  @@index([sourceQcId])
  /// "How much of THIS slab left as samples" — read on every send-to-cutter and
  /// on every board load, so it is the hottest of the three.
  @@index([sourceSlabId])
  /// The packed sample PIECE that created this intake, when it came from a
  /// sample order rather than from an offcut. One piece, one intake — the
  /// unique link is what stops a re-run of packaging crediting twice.
  fabPiece FabPiece?

  @@map("sampling_intake")
}

/// Domestic or international. Free-form for now (the owner's decision 4): no
/// link to the Sales module, no client table, just what the person typing
/// knows.
enum SamplingDestination {
  DOMESTIC
  INTERNATIONAL

  @@map("sampling_destination")
}

/// The three states a dispatch can be in. IN STOCK is deliberately absent: it
/// is where a piece is BEFORE any dispatch claims it, so it is a sampling_stock
/// quantity, not a status. Creating the dispatch is the first transition. See
/// lib/sampling/lifecycle.ts.
enum SamplingDispatchStatus {
  RELEASED
  DISPATCHED
  DELIVERED

  @@map("sampling_dispatch_status")
}

/// One package going to one customer, and its three timestamps. Every
/// transition records when it happened and who did it — the whole point of
/// keeping the lifecycle here rather than in a status column that changes with
/// nobody's name on it.
model SamplingDispatch {
  id           String                 @id @default(cuid())
  customerName String                 @map("customer_name")
  destination  SamplingDestination
  /// The customer's reference, if they gave one. Optional by decision 4.
  reference    String?
  status       SamplingDispatchStatus @default(RELEASED)

  releasedAt     DateTime  @default(now()) @map("released_at")
  releasedById   String?   @map("released_by_id")
  dispatchedAt   DateTime? @map("dispatched_at")
  dispatchedById String?   @map("dispatched_by_id")
  deliveredAt    DateTime? @map("delivered_at")
  deliveredById  String?   @map("delivered_by_id")

  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lines SamplingDispatchLine[]

  /// The board: "what is packed but not gone", "what is gone but not
  /// confirmed", newest first.
  @@index([status, createdAt])
  /// "What have we sent this customer before" — free-text name, so this serves
  /// the exact and prefix match a lookup starts with.
  @@index([customerName])
  @@map("sampling_dispatch")
}

/// One colour+finish and size on a package, and how many pieces.
model SamplingDispatchLine {
  id             String              @id @default(cuid())
  dispatchId     String              @map("dispatch_id")
  dispatch       SamplingDispatch    @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  colourFinishId String              @map("colour_finish_id")
  colourFinish   ProductColourFinish @relation(fields: [colourFinishId], references: [id])
  sizeId         String              @map("size_id")
  size           SamplingSize        @relation(fields: [sizeId], references: [id])
  quantity       Int

  createdAt DateTime @default(now()) @map("created_at")

  /// One line per item on a package — adding the same item twice is a quantity
  /// change, not a second line. The dispatch_id prefix is also the index for
  /// "the lines of this package", which every read of a dispatch does.
  ///
  /// NAMED EXPLICITLY, unlike every other index here. Prisma's default would be
  /// sampling_dispatch_line_dispatch_id_colour_finish_id_size_id_key — exactly
  /// 63 characters, which is Postgres's identifier limit to the character. It
  /// fits today, but one letter added to any of those column names and Prisma
  /// silently truncates while scripts/0051 does not, leaving two names for one
  /// constraint. Short name, no cliff edge.
  @@unique([dispatchId, colourFinishId, sizeId], map: "sampling_dispatch_line_item_key")
  /// "Where did our 4x4 Cappuccino go" — the reverse lookup from a stock row.
  @@index([colourFinishId, sizeId])
  /// The size_id foreign key, for the same reason as on sampling_intake.
  @@index([sizeId])
  @@map("sampling_dispatch_line")
}

// ============================================================================
// COMMERCIAL MODULE — enquiry → internal sales order → 5-day stock hold →
// production request → proforma → packing list → dispatch check → invoice /
// delivery challan / export document set. Built as its own module (owner,
// 2026-09-05) because the ported International Sales module matched no stage
// exactly; only the client master (sales_clients) is shared. Money and
// quantities are NUMERIC; slab_number is Float to match fg_finished_slab and is
// a snapshot, not a foreign key. Attribution columns are plain users.id.
// Applied to Neon via scripts/0076-commercial-module.sql (NOT db push).
// Hand-maintained; NOT touched by gen-schema.py.
// ============================================================================

enum CommercialEnquiryStatus {
  NEW
  QUOTED
  ORDERED
  LOST
  CLOSED

  @@map("commercial_enquiry_status")
}

enum CommercialOrderKind {
  DOMESTIC
  EXPORT

  @@map("commercial_order_kind")
}

/// A pipeline with a timestamp per stage and NO gate between stages: the order
/// of steps is deliberately undecided (see lib/commercial/stages.ts).
enum CommercialOrderStatus {
  DRAFT
  CONFIRMED
  STOCK_CHECKED
  PI_ISSUED
  PACKING
  DISPATCH_CHECK
  READY
  INVOICED
  DISPATCHED
  CLOSED
  CANCELLED

  @@map("commercial_order_status")
}

enum CommercialPoEvidence {
  PO
  PI_ACKNOWLEDGED
  EMAIL

  @@map("commercial_po_evidence")
}

enum CommercialHoldStatus {
  ACTIVE
  RELEASED
  EXPIRED
  CONSUMED

  @@map("commercial_hold_status")
}

enum CommercialProductionStatus {
  QUEUED
  SCHEDULED
  IN_PRODUCTION
  PRODUCED
  CANCELLED

  @@map("commercial_production_status")
}

enum CommercialProformaStatus {
  DRAFT
  ISSUED
  ACCEPTED
  SUPERSEDED
  CANCELLED

  @@map("commercial_proforma_status")
}

enum CommercialPackingStatus {
  DRAFT
  SUBMITTED
  VERIFIED
  REJECTED
  FINAL
  DISPATCHED

  @@map("commercial_packing_status")
}

enum CommercialFitStatus {
  PENDING
  FIT
  UNFIT

  @@map("commercial_fit_status")
}

enum CommercialInvoiceKind {
  DTA
  EXPORT

  @@map("commercial_invoice_kind")
}

enum CommercialDocStatus {
  DRAFT
  ISSUED
  CANCELLED

  @@map("commercial_doc_status")
}

/// Race-safe document counters — one row per key, advanced with
/// INSERT … ON CONFLICT DO UPDATE … RETURNING (lib/commercial/sequence.ts).
model CommercialSequence {
  key       String   @id
  nextValue BigInt   @default(1) @map("next_value")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("commercial_sequence")
}

/// One JSON row ('global') of overrides over lib/commercial/settings-defaults.ts.
model CommercialSetting {
  id          String   @id @default("global")
  data        Json     @default("{}")
  updatedById String?  @map("updated_by_id") // -> users.id (no hard FK)
  updatedAt   DateTime @default(now()) @map("updated_at")

  @@map("commercial_setting")
}

/// What a tax invoice and the export workbook need about a customer that
/// sales_clients does not carry: GSTIN, PAN, state code, customer code and
/// the printed address blocks.
model CommercialClientExt {
  clientId        String      @id @map("client_id")
  client          SalesClient @relation(fields: [clientId], references: [id])
  customerCode    String?     @map("customer_code")
  gstin           String?
  pan             String?
  stateCode       String?     @map("state_code")
  billingAddress  Json?       @map("billing_address")
  shippingAddress Json?       @map("shipping_address")
  notifyParty     Json?       @map("notify_party")
  defaultIncoterm String?     @map("default_incoterm")
  defaultCurrency String?     @map("default_currency")
  notes           String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@map("commercial_client_ext")
}

/// An enquiry, logged by Commercial from the email that brought it.
model CommercialEnquiry {
  id           String                  @id @default(cuid())
  number       String                  @unique
  clientId     String?                 @map("client_id")
  client       SalesClient?            @relation(fields: [clientId], references: [id])
  prospectName String?                 @map("prospect_name")
  contactName  String?                 @map("contact_name")
  contactEmail String?                 @map("contact_email")
  contactPhone String?                 @map("contact_phone")
  receivedAt   DateTime                @map("received_at")
  source       String                  @default("EMAIL")
  subject      String?
  body         String?
  status       CommercialEnquiryStatus @default(NEW)
  assignedToId String?                 @map("assigned_to_id") // -> users.id (no hard FK)
  /// The order this became, once converted (plain id; the order also carries enquiryId).
  orderId      String?                 @map("order_id")
  lostReason   String?                 @map("lost_reason")
  createdById  String?                 @map("created_by_id") // -> users.id (no hard FK)
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  items              CommercialEnquiryItem[]
  orders             CommercialOrder[]
  holds              CommercialStockHold[]
  productionRequests CommercialProductionRequest[]

  /// The enquiries list: open first, newest first.
  @@index([status, receivedAt])
  /// Every enquiry from this client.
  @@index([clientId])
  @@map("commercial_enquiry")
}

model CommercialEnquiryItem {
  id          String            @id @default(cuid())
  enquiryId   String            @map("enquiry_id")
  enquiry     CommercialEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  lineNo      Int               @default(1) @map("line_no")
  design      String?
  customerSku String?           @map("customer_sku")
  thickness   String?
  finish      String?
  qtySlabs    Int?              @map("qty_slabs")
  qtySqft     Decimal?          @map("qty_sqft") @db.Decimal(12, 3)
  notes       String?
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([enquiryId])
  @@map("commercial_enquiry_item")
}

/// The internal sales order. The PI is its printed form; its number is the
/// order number (SAL-ORD/26-27/01642 by default, overridable).
model CommercialOrder {
  id                    String                 @id @default(cuid())
  number                String                 @unique
  kind                  CommercialOrderKind
  status                CommercialOrderStatus  @default(DRAFT)
  clientId              String                 @map("client_id")
  client                SalesClient            @relation(fields: [clientId], references: [id])
  enquiryId             String?                @map("enquiry_id")
  enquiry               CommercialEnquiry?     @relation(fields: [enquiryId], references: [id])
  customerPoNumber      String?                @map("customer_po_number")
  customerPoDate        DateTime?              @map("customer_po_date") @db.Date
  poEvidence            CommercialPoEvidence?  @map("po_evidence")
  currency              String                 @default("USD")
  exchangeRate          Decimal?               @map("exchange_rate") @db.Decimal(12, 4)
  incoterm              String?
  deliveryTerms         String?                @map("delivery_terms")
  paymentTerms          String?                @map("payment_terms")
  paymentMode           String?                @map("payment_mode")
  /// Answer 11: the share of the PI that must be RECEIVED before dispatch.
  /// NULL falls back to the settings default; 0 asks for no advance at all.
  advancePct            Decimal?               @map("advance_pct") @db.Decimal(5, 2)
  /// Answer 12: the Commercial Manager let this truck go without the advance.
  advanceWaivedAt       DateTime?              @map("advance_waived_at")
  advanceWaivedById     String?                @map("advance_waived_by_id") // -> users.id (no hard FK)
  advanceWaivedByName   String?                @map("advance_waived_by_name")
  advanceWaivedReason   String?                @map("advance_waived_reason")
  billTo                Json?                  @map("bill_to")
  consignee             Json?
  notifyParty           Json?                  @map("notify_party")
  buyerIfNotConsignee   Json?                  @map("buyer_if_not_consignee")
  preCarriageBy         String?                @map("pre_carriage_by")
  placeOfReceipt        String?                @map("place_of_receipt")
  portOfLoading         String?                @map("port_of_loading")
  portOfDischarge       String?                @map("port_of_discharge")
  finalDestination      String?                @map("final_destination")
  countryOfOrigin       String                 @default("India") @map("country_of_origin")
  countryOfDestination  String?                @map("country_of_destination")
  deliverySchedule      String?                @map("delivery_schedule")
  specialPacking        String?                @map("special_packing")
  forwarderDetails      String?                @map("forwarder_details")
  receiverDetails       String?                @map("receiver_details")
  customerContact       String?                @map("customer_contact")
  /// The SOP sheet's points: [{ key, no, label, value, ok }] (lib/commercial/checklist.ts).
  checklist             Json                   @default("[]")
  checkedById           String?                @map("checked_by_id") // -> users.id (no hard FK)
  checkedByName         String?                @map("checked_by_name")
  checkedAt             DateTime?              @map("checked_at")
  approvedById          String?                @map("approved_by_id") // -> users.id (no hard FK)
  approvedByName        String?                @map("approved_by_name")
  approvedAt            DateTime?              @map("approved_at")
  notes                 String?
  confirmedAt           DateTime?              @map("confirmed_at")
  stockCheckedAt        DateTime?              @map("stock_checked_at")
  piIssuedAt            DateTime?              @map("pi_issued_at")
  packingAt             DateTime?              @map("packing_at")
  dispatchCheckedAt     DateTime?              @map("dispatch_checked_at")
  readyAt               DateTime?              @map("ready_at")
  invoicedAt            DateTime?              @map("invoiced_at")
  dispatchedAt          DateTime?              @map("dispatched_at")
  closedAt              DateTime?              @map("closed_at")
  cancelledAt           DateTime?              @map("cancelled_at")
  cancelReason          String?                @map("cancel_reason")
  createdById           String?                @map("created_by_id") // -> users.id (no hard FK)
  createdByName         String?                @map("created_by_name")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  items              CommercialOrderItem[]
  events             CommercialOrderEvent[]
  holds              CommercialStockHold[]
  productionRequests CommercialProductionRequest[]
  proformas          CommercialProforma[]
  packingLists       CommercialPackingList[]
  invoices           CommercialInvoice[]
  challans           CommercialDeliveryChallan[]
  receipts           CommercialReceipt[]

  /// The orders board: by stage, newest first.
  @@index([status, createdAt])
  /// Every order of this client.
  @@index([clientId])
  @@map("commercial_order")
}

model CommercialOrderItem {
  id          String          @id @default(cuid())
  orderId     String          @map("order_id")
  order       CommercialOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lineNo      Int             @default(1) @map("line_no")
  /// Our design name (canonical finished-goods name).
  design      String?
  /// The customer's code, e.g. VGWT10301A.
  customerSku String?         @map("customer_sku")
  description String?
  /// Canonical '2 cm' / '3 cm' (lib/thickness.ts canonThickness).
  thickness   String?
  finish      String?
  sizeLabel   String?         @map("size_label")
  gradeLabel  String?         @map("grade_label")
  qtySlabs    Int?            @map("qty_slabs")
  qty         Decimal?        @db.Decimal(14, 3)
  uom         String          @default("SQFT")
  rate        Decimal?        @db.Decimal(14, 4)
  amount      Decimal?        @db.Decimal(16, 3)
  hsn         String          @default("68101990")
  isSample    Boolean         @default(false) @map("is_sample")
  notes       String?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([orderId])
  @@map("commercial_order_item")
}

/// The order's log: every stage move, hold, request, PI, packing list, invoice.
model CommercialOrderEvent {
  id      String          @id @default(cuid())
  orderId String          @map("order_id")
  order   CommercialOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind    String
  note    String?
  payload Json?
  byId    String?         @map("by_id") // -> users.id (no hard FK)
  byName  String?         @map("by_name")
  at      DateTime        @default(now())

  @@index([orderId, at])
  @@map("commercial_order_event")
}

/// The module's record of a hold. The hold itself is fg_finished_slab.status
/// RESERVED with reserved_for_pi = reference; this row says who placed it,
/// against what, until when, and which slabs — and survives their release.
model CommercialStockHold {
  id            String               @id @default(cuid())
  orderId       String?              @map("order_id")
  order         CommercialOrder?     @relation(fields: [orderId], references: [id])
  enquiryId     String?              @map("enquiry_id")
  enquiry       CommercialEnquiry?   @relation(fields: [enquiryId], references: [id])
  /// What is stamped on the slabs (order / PI / enquiry number).
  reference     String
  customer      String?
  status        CommercialHoldStatus @default(ACTIVE)
  placedById    String?              @map("placed_by_id") // -> users.id (no hard FK)
  placedByName  String?              @map("placed_by_name")
  placedAt      DateTime             @default(now()) @map("placed_at")
  expiresAt     DateTime             @map("expires_at")
  releasedAt    DateTime?            @map("released_at")
  releasedById  String?              @map("released_by_id") // -> users.id (no hard FK)
  releaseReason String?              @map("release_reason")
  notes         String?
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  slabs CommercialStockHoldSlab[]

  /// "What expires soon" on the dashboard.
  @@index([status, expiresAt])
  @@index([orderId])
  @@index([reference])
  @@map("commercial_stock_hold")
}

model CommercialStockHoldSlab {
  id          String              @id @default(cuid())
  holdId      String              @map("hold_id")
  hold        CommercialStockHold @relation(fields: [holdId], references: [id], onDelete: Cascade)
  /// = fg_finished_slab.slab_number — a snapshot, not a foreign key.
  slabNumber  Float               @map("slab_number")
  design      String?
  thickness   String?
  batchKey    String?             @map("batch_key")
  batchNumber String?             @map("batch_number")
  grade       String?
  lengthIn    Float?              @map("length_in")
  widthIn     Float?              @map("width_in")
  sqft        Decimal?            @db.Decimal(10, 3)
  releasedAt  DateTime?           @map("released_at")
  packedAt    DateTime?           @map("packed_at")
  createdAt   DateTime            @default(now()) @map("created_at")

  @@unique([holdId, slabNumber])
  /// Which hold is this slab on, from the slab side.
  @@index([slabNumber])
  @@map("commercial_stock_hold_slab")
}

/// One (design, thickness) shortfall in the production planning queue.
/// priority is the order the planner drags; lower runs first.
model CommercialProductionRequest {
  id                String                     @id @default(cuid())
  orderId           String?                    @map("order_id")
  order             CommercialOrder?           @relation(fields: [orderId], references: [id])
  orderItemId       String?                    @map("order_item_id")
  enquiryId         String?                    @map("enquiry_id")
  enquiry           CommercialEnquiry?         @relation(fields: [enquiryId], references: [id])
  design            String
  thickness         String
  finish            String?
  qtyRequired       Int                        @map("qty_required")
  qtyAvailable      Int                        @default(0) @map("qty_available")
  qtyShort          Int                        @map("qty_short")
  priority          Int
  status            CommercialProductionStatus @default(QUEUED)
  cleaningNote      String?                    @map("cleaning_note")
  plannedBatch      String?                    @map("planned_batch")
  notes             String?
  raisedById        String?                    @map("raised_by_id") // -> users.id (no hard FK)
  raisedByName      String?                    @map("raised_by_name")
  raisedAt          DateTime                   @default(now()) @map("raised_at")
  scheduledAt       DateTime?                  @map("scheduled_at")
  startedAt         DateTime?                  @map("started_at")
  producedAt        DateTime?                  @map("produced_at")
  producedById      String?                    @map("produced_by_id") // -> users.id (no hard FK)
  producedBatchKeys String[]                   @default([]) @map("produced_batch_keys")
  notifiedAt        DateTime?                  @map("notified_at")
  notifiedVia       String?                    @map("notified_via")
  cancelledAt       DateTime?                  @map("cancelled_at")
  /// The plan's own figures (answer 13). plannedSlabs starts equal to qtyShort;
  /// cleaningHours is 3, or 6 after an abrupt dark → light change. Editable by
  /// ADMIN / COMMERCIAL_MANAGER; every reduction is a CommercialProductionPlanChange.
  plannedSlabs      Int?                       @map("planned_slabs")
  plannedHours      Decimal?                   @map("planned_hours") @db.Decimal(6, 1)
  cleaningHours     Decimal?                   @map("cleaning_hours") @db.Decimal(4, 1)
  /// LIGHT / MEDIUM / DARK, copied from the design master when raised.
  shade             String?
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")

  changes CommercialProductionPlanChange[]

  /// The planning queue itself.
  @@index([status, priority])
  @@index([orderId])
  @@map("commercial_production_request")
}

/// A revision-stamped snapshot of the order at the moment the PI was issued.
/// The PDF renders from snapshot, never from the live order.
model CommercialProforma {
  id           String                   @id @default(cuid())
  orderId      String                   @map("order_id")
  order        CommercialOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  number       String
  revision     Int                      @default(0)
  status       CommercialProformaStatus @default(DRAFT)
  issuedAt     DateTime?                @map("issued_at")
  validUntil   DateTime?                @map("valid_until") @db.Date
  acceptedAt   DateTime?                @map("accepted_at")
  supersededAt DateTime?                @map("superseded_at")
  /// A cancellation is an audit fact; it used to be appended to `notes`, the
  /// column a human types remarks into. Added by scripts/0077.
  cancelledAt  DateTime?                @map("cancelled_at")
  cancelReason String?                  @map("cancel_reason")
  /// Answer 8: the PI issued in its place. Not a relation — the row is in this
  /// same table and a cascade would delete the history the register prints.
  replacedById String?                  @map("replaced_by_id")
  /// lib/commercial/types.ts ProformaSnapshot.
  snapshot     Json
  currency     String                   @default("USD")
  totalAmount  Decimal?                 @map("total_amount") @db.Decimal(16, 3)
  notes        String?
  createdById  String?                  @map("created_by_id") // -> users.id (no hard FK)
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")

  @@unique([number, revision])
  @@index([orderId])
  @@map("commercial_proforma")
}

model CommercialPackingList {
  id               String                  @id @default(cuid())
  orderId          String                  @map("order_id")
  order            CommercialOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  number           String                  @unique
  status           CommercialPackingStatus @default(DRAFT)
  containerNo      String?                 @map("container_no")
  sealNo           String?                 @map("seal_no")
  linerOtlNo       String?                 @map("liner_otl_no")
  vehicleNo        String?                 @map("vehicle_no")
  /// Issued by the shipping line and by customs AFTER the container leaves, so
  /// they are typed in later; the packing list prints a box for each and could
  /// only ever print them blank. Added by scripts/0077.
  blNo             String?                 @map("bl_no")
  sbNo             String?                 @map("sb_no")
  /// cm or in — the unit the packing and measurement lists print (answer 17).
  measurementUnit  String                  @default("cm") @map("measurement_unit")
  grossWeightKg    Decimal?                @map("gross_weight_kg") @db.Decimal(12, 2)
  netWeightKg      Decimal?                @map("net_weight_kg") @db.Decimal(12, 2)
  /// e.g. "07 Wooden Crate(S) + 08 Sample Box".
  packagesSummary  String?                 @map("packages_summary")
  notes            String?
  createdById      String?                 @map("created_by_id") // -> users.id (no hard FK)
  createdByName    String?                 @map("created_by_name")
  submittedAt      DateTime?               @map("submitted_at")
  submittedById    String?                 @map("submitted_by_id") // -> users.id (no hard FK)
  verifiedAt       DateTime?               @map("verified_at")
  verifiedById     String?                 @map("verified_by_id") // -> users.id (no hard FK)
  verifiedByName   String?                 @map("verified_by_name")
  verificationNote String?                 @map("verification_note")
  finalisedAt      DateTime?               @map("finalised_at")
  dispatchedAt     DateTime?               @map("dispatched_at")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  crates   CommercialCrate[]
  slabs    CommercialPackedSlab[]
  invoices CommercialInvoice[]

  @@index([orderId])
  /// The dispatch team's queue: SUBMITTED, oldest first.
  @@index([status, submittedAt])
  @@map("commercial_packing_list")
}

model CommercialCrate {
  id            String                @id @default(cuid())
  packingListId String                @map("packing_list_id")
  packingList   CommercialPackingList @relation(fields: [packingListId], references: [id], onDelete: Cascade)
  crateNo       Int                   @map("crate_no")
  /// Wooden Crate / Sample Box / Bundle.
  kind          String                @default("Wooden Crate")
  grossKg       Decimal?              @map("gross_kg") @db.Decimal(10, 2)
  netKg         Decimal?              @map("net_kg") @db.Decimal(10, 2)
  lengthCm      Decimal?              @map("length_cm") @db.Decimal(8, 1)
  widthCm       Decimal?              @map("width_cm") @db.Decimal(8, 1)
  heightCm      Decimal?              @map("height_cm") @db.Decimal(8, 1)
  remarks       String?
  createdAt     DateTime              @default(now()) @map("created_at")

  slabs CommercialPackedSlab[]

  @@unique([packingListId, crateNo])
  @@map("commercial_crate")
}

/// One slab on a packing list: our record and, when the customer wants their
/// own numbering, theirs beside it.
model CommercialPackedSlab {
  id              String                @id @default(cuid())
  packingListId   String                @map("packing_list_id")
  packingList     CommercialPackingList @relation(fields: [packingListId], references: [id], onDelete: Cascade)
  crateId         String?               @map("crate_id")
  crate           CommercialCrate?      @relation(fields: [crateId], references: [id])
  /// Ours (= fg_finished_slab.slab_number; snapshot, no FK).
  slabNumber      Float                 @map("slab_number")
  customerSlabNo  String?               @map("customer_slab_no")
  customerBatchNo String?               @map("customer_batch_no")
  design          String?
  customerSku     String?               @map("customer_sku")
  thickness       String?
  batchKey        String?               @map("batch_key")
  batchNumber     String?               @map("batch_number")
  grade           String?
  lengthCm        Decimal?              @map("length_cm") @db.Decimal(8, 1)
  widthCm         Decimal?              @map("width_cm") @db.Decimal(8, 1)
  sqm             Decimal?              @db.Decimal(10, 4)
  sqft            Decimal?              @db.Decimal(10, 3)
  fit             CommercialFitStatus   @default(PENDING)
  unfitReason     String?               @map("unfit_reason")
  checkedById     String?               @map("checked_by_id") // -> users.id (no hard FK)
  checkedAt       DateTime?             @map("checked_at")
  sortOrder       Int                   @default(0) @map("sort_order")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  @@unique([packingListId, slabNumber])
  @@index([slabNumber])
  @@index([crateId])
  @@map("commercial_packed_slab")
}

/// A DTA (domestic, GST) or export invoice, rendered from its snapshot.
model CommercialInvoice {
  id            String                 @id @default(cuid())
  orderId       String                 @map("order_id")
  order         CommercialOrder        @relation(fields: [orderId], references: [id])
  packingListId String?                @map("packing_list_id")
  packingList   CommercialPackingList? @relation(fields: [packingListId], references: [id])
  kind          CommercialInvoiceKind
  /// PESPL/2780 (export) · PESPL/0137/26-27 (DTA).
  number        String                 @unique
  invoiceDate   DateTime               @map("invoice_date") @db.Date
  status        CommercialDocStatus    @default(DRAFT)
  currency      String
  exchangeRate  Decimal?               @map("exchange_rate") @db.Decimal(12, 4)
  /// lib/commercial/types.ts InvoiceSnapshot.
  snapshot      Json
  subtotal      Decimal?               @db.Decimal(16, 3)
  /// IGST / CGST_SGST / NONE.
  taxType       String?                @map("tax_type")
  taxRate       Decimal?               @map("tax_rate") @db.Decimal(6, 2)
  igst          Decimal?               @db.Decimal(16, 2)
  cgst          Decimal?               @db.Decimal(16, 2)
  sgst          Decimal?               @db.Decimal(16, 2)
  roundOff      Decimal?               @map("round_off") @db.Decimal(8, 2)
  /// THREE decimals, like subtotal: the reference PI's own figure is USD
  /// 17,324.657, and at scale 2 the register read .66 while the PDF and the
  /// words said .657 — two figures for one document. Widened by scripts/0077.
  grandTotal    Decimal?               @map("grand_total") @db.Decimal(16, 3)
  amountInWords String?                @map("amount_in_words")
  vehicleNo     String?                @map("vehicle_no")
  transporter   String?
  lrNo          String?                @map("lr_no")
  containerNo   String?                @map("container_no")
  sealNo        String?                @map("seal_no")
  ewayBillNo    String?                @map("eway_bill_no")
  notes         String?
  createdById   String?                @map("created_by_id") // -> users.id (no hard FK)
  issuedAt      DateTime?              @map("issued_at")
  cancelledAt   DateTime?              @map("cancelled_at")
  cancelReason  String?                @map("cancel_reason")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  exportDocSet CommercialExportDocSet?

  @@index([orderId])
  /// The invoice register: by kind and date.
  @@index([kind, invoiceDate])
  @@map("commercial_invoice")
}

/// Samples, display stands, goods to the sister company: a movement, not a sale.
model CommercialDeliveryChallan {
  id                String              @id @default(cuid())
  /// PESPL/DC/20/26.
  number            String              @unique
  challanDate       DateTime            @map("challan_date") @db.Date
  orderId           String?             @map("order_id")
  order             CommercialOrder?    @relation(fields: [orderId], references: [id])
  consigneeClientId String?             @map("consignee_client_id")
  consigneeClient   SalesClient?        @relation(fields: [consigneeClientId], references: [id])
  consigneeName     String              @map("consignee_name")
  consigneeAddress  String?             @map("consignee_address")
  consigneeGstin    String?             @map("consignee_gstin")
  /// 'Verbal' is a real value here.
  poRef             String?             @map("po_ref")
  commodity         String?
  purpose           String?
  /// [{ description, qty, unit, sqft, rate, amount, hsn }] (lib/commercial/types.ts ChallanItem).
  items             Json                @default("[]")
  totalAmount       Decimal?            @map("total_amount") @db.Decimal(14, 2)
  amountInWords     String?             @map("amount_in_words")
  lorryNo           String?             @map("lorry_no")
  notes             String?
  status            CommercialDocStatus @default(DRAFT)
  createdById       String?             @map("created_by_id") // -> users.id (no hard FK)
  issuedAt          DateTime?           @map("issued_at")
  cancelledAt       DateTime?           @map("cancelled_at")
  /// Beside cancelledAt for the same reason the invoice has one. scripts/0077.
  cancelReason      String?             @map("cancel_reason")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@index([challanDate])
  @@map("commercial_delivery_challan")
}

/// The root variables the export workbook is generated from, so it can be
/// regenerated and edited later.
model CommercialExportDocSet {
  id              String            @id @default(cuid())
  invoiceId       String            @unique @map("invoice_id")
  invoice         CommercialInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  rootVariables   Json              @map("root_variables")
  templateVersion String?           @map("template_version")
  generatedAt     DateTime?         @map("generated_at")
  generatedById   String?           @map("generated_by_id") // -> users.id (no hard FK)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@map("commercial_export_doc_set")
}

enum CommercialReceiptKind {
  ADVANCE
  CAD
  BALANCE
  OTHER

  @@map("commercial_receipt_kind")
}

enum CommercialPlanChangeStatus {
  OPEN
  ADDED_BACK
  REMOVED

  @@map("commercial_plan_change_status")
}

/// Money received against an order (answer 29). The first ADVANCE is what
/// lets a truck leave (answer 2). scripts/0079.
model CommercialReceipt {
  id             String                @id @default(cuid())
  orderId        String                @map("order_id")
  order          CommercialOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind           CommercialReceiptKind
  amount         Decimal               @db.Decimal(16, 2)
  currency       String
  receivedAt     DateTime              @map("received_at") @db.Date
  mode           String?
  reference      String?
  notes          String?
  recordedById   String?               @map("recorded_by_id") // -> users.id (no hard FK)
  recordedByName String?               @map("recorded_by_name")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  @@index([orderId])
  @@map("commercial_receipt")
}

/// One row per canonical design: the owner's item code (answer 20) and the
/// shade the planning queue sequences by (answer 13). scripts/0079.
model CommercialDesignCode {
  design         String   @id
  code           String?  @unique
  /// LIGHT / MEDIUM / DARK. A first guess from the name until confirmed.
  shade          String?
  shadeConfirmed Boolean  @default(false) @map("shade_confirmed")
  /// Answer 15: the owner reads L*a*b* off the sample and may overrule the hex
  /// by hand. L* is what decides an abrupt changeover (answer 14).
  colourName     String?  @map("colour_name")
  hex            String?
  labL           Decimal? @map("lab_l") @db.Decimal(6, 2)
  labA           Decimal? @map("lab_a") @db.Decimal(6, 2)
  labB           Decimal? @map("lab_b") @db.Decimal(6, 2)
  notes          String?
  updatedById    String?  @map("updated_by_id") // -> users.id (no hard FK)
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("commercial_design_code")
}

/// What was planned and then taken away, kept so it is never simply gone
/// (answer 13: "put it on another table … with add back or remove").
model CommercialProductionPlanChange {
  id            String                      @id @default(cuid())
  requestId     String                      @map("request_id")
  request       CommercialProductionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  /// plannedSlabs / plannedHours / cleaningHours
  field         String
  fromValue     Decimal?                    @map("from_value") @db.Decimal(10, 1)
  toValue       Decimal?                    @map("to_value") @db.Decimal(10, 1)
  /// to − from; negative is a reduction.
  delta         Decimal                     @db.Decimal(10, 1)
  reason        String?
  status        CommercialPlanChangeStatus  @default(OPEN)
  changedById   String?                     @map("changed_by_id") // -> users.id (no hard FK)
  changedByName String?                     @map("changed_by_name")
  changedAt     DateTime                    @default(now()) @map("changed_at")
  resolvedAt    DateTime?                   @map("resolved_at")
  resolvedById  String?                     @map("resolved_by_id") // -> users.id (no hard FK)

  @@index([requestId])
  /// The "not planned" panel: open reductions, newest first.
  @@index([status, changedAt])
  @@map("commercial_production_plan_change")
}
