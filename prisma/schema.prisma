model SalesShipmentDocs {
  id      String @id @default(cuid())
  orderId String @unique @map("order_id")

  // Document URLs
  blDocUrl          String? @map("bl_doc_url")
  fumigationCertUrl String? @map("fumigation_cert_url")
  invoiceUrl        String? @map("invoice_url")
  bankDetailsUrl    String? @map("bank_details_url")

  // Invoice / BL / SB references
  commercialInvoiceNo   String?   @map("commercial_invoice_no")
  commercialInvoiceDate DateTime? @map("commercial_invoice_date")
  blNo                  String?   @map("bl_no")
  sbNo                  String?   @map("sb_no")
  blDate                DateTime? @map("bl_date")
  blDocSentAt           DateTime? @map("bl_doc_sent_at")
  t15MailSentAt         DateTime? @map("t15_mail_sent_at")

