  isActive      Boolean                @default(true)
  createdAt     DateTime               @default(now())
  recipeEntries RoboBatchRecipeEntry[]
  delayLogs     RoboDelayLog[]
}

model RoboDesign {
  id           String            @id @default(cuid())
  name         String            @unique
  seriesName   String?
  createdAt    DateTime          @default(now())
  programs     RoboProgram[]
  batchRecipes RoboBatchRecipe[]
}

model RoboProgram {
  id           String            @id @default(cuid())
  name         String            @unique
  designId     String
  design       RoboDesign        @relation(fields: [designId], references: [id])
  createdAt    DateTime          @default(now())
  batchRecipes RoboBatchRecipe[]
}

model RoboTool {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model RoboLiquid {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model RoboPowder {
  id        String   @id @default(cuid())
  name      String   @unique
