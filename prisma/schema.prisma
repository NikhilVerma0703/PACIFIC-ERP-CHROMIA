  // Stuffing / dispatch email
  stuffingPhotos     Json      @default("[]") @map("stuffing_photos") // [{url, filename, caption?}]
  stuffingMailSentAt DateTime? @map("stuffing_mail_sent_at")
  combinedPdfUrl     String?   @map("combined_pdf_url") // Invoice+PL+ML combined PDF URL

  // Shipping docs email (sent when BL ready)
  shippingDocsMailSentAt DateTime? @map("shipping_docs_mail_sent_at")
  paymentDueDate         DateTime? @map("payment_due_date")

  // packing_list_upload / measurement_list_upload / discount_amount /
