  id               String    @id @default(cuid())
  invNo            String    @map("inv_no")
  type             String    @default("") @map("type")
  size             String    @default("") @map("size")
  grade            String    @default("") @map("grade")
  supplier         String?   @map("supplier")
  totalKg          Float     @default(0) @map("total_kg")
  remainingKg      Float     @default(0) @map("remaining_kg")
  // mirrored from the RM table (non-bag fields)
  date             DateTime? @map("date")
  status           String?   @map("status")
  testedBy         String?   @map("tested_by")
  availability     String?   @map("availability")
  contamination    String?   @map("contamination")
  gritShade        String?   @map("grit_shade")
  fillerShade      String?   @map("filler_shade")
  colourL          Float?    @map("colour_l")
