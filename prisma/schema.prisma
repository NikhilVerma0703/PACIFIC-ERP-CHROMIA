/// Append-only log of reversible data-fix actions, enabling "undo the last action".
model ActionLog {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now()) @map("created_at")
  actor     String?
  batchKey  String?   @map("batch_key")
  kind      String
