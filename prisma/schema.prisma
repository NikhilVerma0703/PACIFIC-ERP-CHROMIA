// ---- Quality control & grade decision ---------------------------------------

model ChromiaQcRecord {
  id          String           @id @default(uuid())
  inspectedAt DateTime         @default(now()) @map("inspected_at")
  verdict     ChromiaQcVerdict

  cycleId String              @unique @map("cycle_id")
  cycle   ChromiaProcessCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  slabId String      @map("slab_id")
  slab   ChromiaSlab @relation(fields: [slabId], references: [id], onDelete: Cascade)

  inspectorId String? @map("inspector_id") // -> users.id (no hard FK)

  printQualityResult  ChromiaQcCheckResult @default(NOT_APPLICABLE) @map("print_quality_result")
  colourMatchResult   ChromiaQcCheckResult @default(NOT_APPLICABLE) @map("colour_match_result")
  surfaceFinishResult ChromiaQcCheckResult @default(NOT_APPLICABLE) @map("surface_finish_result")
  glossResult         ChromiaQcCheckResult @default(NOT_APPLICABLE) @map("gloss_result")
  dimensionalResult   ChromiaQcCheckResult @default(NOT_APPLICABLE) @map("dimensional_result")
  edgeConditionResult ChromiaQcCheckResult @default(NOT_APPLICABLE) @map("edge_condition_result")

  glossReading    Decimal? @map("gloss_reading") @db.Decimal(18, 3)
  colourDeviation String?  @map("colour_deviation")
  photoUrls       String[] @map("photo_urls")
  remarks         String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  defects ChromiaQcDefect[]

  @@index([slabId, inspectedAt])
  @@index([verdict, inspectedAt])
  @@index([inspectorId])
  @@map("chromia_qc_record")
}

model ChromiaQcDefect {
  id          String                @id @default(uuid())
  severity    ChromiaDefectSeverity
  areaOnSlab  String?               @map("area_on_slab")
  description String?
  photoUrl    String?               @map("photo_url")

  qcRecordId String          @map("qc_record_id")
  qcRecord   ChromiaQcRecord @relation(fields: [qcRecordId], references: [id], onDelete: Cascade)

  defectTypeId String            @map("defect_type_id")
  defectType   ChromiaDefectType @relation(fields: [defectTypeId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([qcRecordId])
  @@index([defectTypeId])
  @@map("chromia_qc_defect")
}

model ChromiaGradeDecision {
  id          String             @id @default(uuid())
  grade       ChromiaSlabGrade
  disposition ChromiaDisposition
  reason      String?
  decidedAt   DateTime           @default(now()) @map("decided_at")
  remarks     String?

  cycleId String              @unique @map("cycle_id")
  cycle   ChromiaProcessCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  slabId String      @map("slab_id")
  slab   ChromiaSlab @relation(fields: [slabId], references: [id], onDelete: Cascade)

  decidedById String? @map("decided_by_id") // -> users.id (no hard FK)

  targetLocationId String?          @map("target_location_id")
  targetLocation   ChromiaLocation? @relation("ChromiaGradeTargetLocation", fields: [targetLocationId], references: [id], onDelete: SetNull)

  attemptNumberAtDecision Int @default(1) @map("attempt_number_at_decision")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([slabId, decidedAt])
  @@index([grade, decidedAt])
  @@index([disposition])
  @@map("chromia_grade_decision")
}

// ---- Recalibration -----------------------------------------------------------

/// One recalibration cycle. Maximum five per slab — enforced in the service
/// layer against ChromiaSlab.recalibrationCount and by the unique constraint
/// below.
model ChromiaRecalibrationCycle {
  id            String                     @id @default(uuid())
  attemptNumber Int                        @map("attempt_number")
  status        ChromiaRecalibrationStatus @default(PENDING_DISPATCH)

  slabId String      @map("slab_id")
  slab   ChromiaSlab @relation(fields: [slabId], references: [id], onDelete: Cascade)

  // The cycle that failed QC and triggered this recalibration.
  failedCycleId String?              @unique @map("failed_cycle_id")
  failedCycle   ChromiaProcessCycle? @relation("ChromiaFailedCycle", fields: [failedCycleId], references: [id], onDelete: SetNull)

  // The cycle created when the slab restarted after coming back.
  restartedCycleId String?              @unique @map("restarted_cycle_id")
  restartedCycle   ChromiaProcessCycle? @relation("ChromiaRestartedCycle", fields: [restartedCycleId], references: [id], onDelete: SetNull)

  reasonId String?                     @map("reason_id")
  reason   ChromiaRecalibrationReason? @relation(fields: [reasonId], references: [id], onDelete: SetNull)

  reasonNotes String? @map("reason_notes")

  // Outward
  sentDate           DateTime? @map("sent_date")
  expectedReturnDate DateTime? @map("expected_return_date")
  facilityName       String?   @map("facility_name")
  gatePassNo         String?   @map("gate_pass_no")
  transporter        String?
  vehicleNo          String?   @map("vehicle_no")
  conditionOnSend    String?   @map("condition_on_send")

  issuedById String? @map("issued_by_id") // -> users.id (no hard FK)

  // Return
  receivedDate      DateTime? @map("received_date")
  turnaroundDays    Int?      @map("turnaround_days")
  conditionOnReturn String?   @map("condition_on_return")
  workAccepted      Boolean?  @map("work_accepted")

  receivedById String? @map("received_by_id") // -> users.id (no hard FK)

  // Upper-surface removal
  thicknessBeforeMm  Decimal? @map("thickness_before_mm") @db.Decimal(18, 3)
  thicknessAfterMm   Decimal? @map("thickness_after_mm") @db.Decimal(18, 3)
  materialRemovedMm  Decimal? @map("material_removed_mm") @db.Decimal(18, 3)
  withinMinThickness Boolean? @map("within_min_thickness")

  photoUrls String[] @map("photo_urls")
  notes     String?

  restartedAt DateTime? @map("restarted_at")

  createdById String?  @map("created_by_id") // -> users.id (no hard FK)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([slabId, attemptNumber])
  @@index([status, sentDate])
  @@index([slabId])
  @@index([reasonId])
  @@index([receivedDate])
  @@map("chromia_recalibration_cycle")
}

