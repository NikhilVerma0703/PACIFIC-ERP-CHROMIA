// ============================================================================
// ROBO MODULE — Robo production line (merged from ROBO_MODULE standalone app).
// Models are Robo-prefixed to keep them clearly namespaced from the Airtable-
// generated tables above. Hand-maintained; NOT touched by gen-schema.py.
// ============================================================================

model RoboMachine {
  id            String                 @id @default(cuid())
  name          String                 @unique
  type          String
  isActive      Boolean                @default(true)
  createdAt     DateTime               @default(now())
  recipeEntries RoboBatchRecipeEntry[]
  delayLogs     RoboDelayLog[]
}

model RoboDesign {
  id           String            @id @default(cuid())
  name         String            @unique
  seriesName   String?
  createdAt    DateTime          @default(now())
  programs     RoboProgram[]
  batchRecipes RoboBatchRecipe[]
}

model RoboProgram {
  id           String            @id @default(cuid())
  name         String            @unique
  designId     String
  design       RoboDesign        @relation(fields: [designId], references: [id])
  createdAt    DateTime          @default(now())
  batchRecipes RoboBatchRecipe[]
}

model RoboTool {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model RoboLiquid {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model RoboPowder {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model RoboOperator {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model RoboDelayCode {
  id              String         @id @default(cuid())
  code            String         @unique
  description     String
  category        String
  isRobotSpecific Boolean        @default(false)
  createdAt       DateTime       @default(now())
  delayLogs       RoboDelayLog[]
}

model RoboShift {
  id                String                 @id @default(cuid())
  date              String
  shiftNumber       Int
  startTime         String
  endTime           String?
  status            String                 @default("ACTIVE")
  operatorName      String                 @default("")
  notes             String?
  // Fixed cycle times for Roycuts (set once per shift — applies to all slabs)
  roycut1CycleTime  Int?
  roycut2CycleTime  Int?
  roycut3CycleTime  Int?
  createdAt         DateTime               @default(now())
  batchRecipes      RoboBatchRecipe[]
  productionRecords RoboProductionRecord[]
  delayLogs         RoboDelayLog[]
}

model RoboBatchRecipe {
  id                String                 @id @default(cuid())
  shiftId           String
  shift             RoboShift              @relation(fields: [shiftId], references: [id])
  // The two the operator writes at the top of the setup. productionDate is a
  // plain yyyy-mm-dd string, the same convention RoboShift.date already uses —
  // the shift's own date is when the tablet was opened, and a run entered late
  // or corrected the next morning belongs to the day it was produced, not the
  // day it was typed. batchNo is the plant's own number for the run, free text
  // because it is theirs to format. Both optional: setups saved before this
  // existed have neither, and the form does not force either.
  productionDate    String?
  batchNo           String?
  designId          String?
  design            RoboDesign?            @relation(fields: [designId], references: [id])
  programId         String?
  program           RoboProgram?           @relation(fields: [programId], references: [id])
  designName        String                 @default("")
  programName       String                 @default("")
  targetSlabs       Int?
  thickness         Float?
  notes             String?
  createdAt         DateTime               @default(now())
  entries           RoboBatchRecipeEntry[]
  productionRecords RoboProductionRecord[]
}

model RoboBatchRecipeEntry {
  id              String          @id @default(cuid())
  batchRecipeId   String
  batchRecipe     RoboBatchRecipe @relation(fields: [batchRecipeId], references: [id])
  machineId       String
  machine         RoboMachine     @relation(fields: [machineId], references: [id])
  programName     String? // Program name for this specific machine
  toolName        String?
  liquidName      String?
  powderName      String?
  rollerHeight    String?
  targetCycleTime Int? // Target cycle time in seconds (fixed for production run)
  notes           String?

  @@unique([batchRecipeId, machineId])
}

model RoboProductionRecord {
  id               String           @id @default(cuid())
  serialNumber     Int?
  slabNumber       String
  shiftId          String
  shift            RoboShift        @relation(fields: [shiftId], references: [id])
  batchRecipeId    String?
  batchRecipe      RoboBatchRecipe? @relation(fields: [batchRecipeId], references: [id])
  // The slab's OWN production date, when it differs from the batch's. A batch
  // can run past midnight — slabs 1-80 on 1 Sep, slab 81 at 00:03 on 2 Sep —
  // and the operator sets this per slab so slab 81 reads 2 Sep while 1-80 stay
  // 1 Sep, all on the same batch, same shift, same running S.No. Highest
  // precedence in productionDate.ts: this, else the setup's date, else the
  // shift's. INVARIANT: a real yyyy-mm-dd string or NULL, never "" — every
  // writer stores `trim() || null`, so "no per-slab date" is exactly NULL and
  // the where-builders can gate the fallback branches on `productionDate: null`
  // alone. Nullable and added late, so existing and imported slabs are NULL and
  // keep falling back to the setup exactly as before.
  productionDate   String?
  inTime           String?
  outTime          String?
  roymixCycleTime  Int? // RoyMix cycle time in seconds (varies per slab)
  roymixBodyWeight Float? // RoyMix body weight in kg (recorded per slab)
  thickness        Float?
  status           String           @default("COMPLETED")
  remarks          String?
  createdAt        DateTime         @default(now())
  delayLogs        RoboDelayLog[]
}

model RoboDelayLog {
  id                 String                @id @default(cuid())
  shiftId            String
  shift              RoboShift             @relation(fields: [shiftId], references: [id])
  productionRecordId String?
  productionRecord   RoboProductionRecord? @relation(fields: [productionRecordId], references: [id])
  machineId          String?
  machine            RoboMachine?          @relation(fields: [machineId], references: [id])
  machineName        String?
  delayCodeId        String
  delayCode          RoboDelayCode         @relation(fields: [delayCodeId], references: [id])
  durationMinutes    Int
  startTime          String?
  endTime            String?
  remarks            String?
  createdAt          DateTime              @default(now())
}

/// One bulk import of a production register workbook (ROBO_MODULE upstream's
/// ImportLog, namespaced). No relations on purpose - it is a journal, and the
/// rows it describes survive it.
model RoboImportLog {
  id        String   @id @default(cuid())
  fileName  String
  period    String?
  status    String   @default("failed")
  totalRows Int      @default(0)
  imported  Int      @default(0)
  skipped   Int      @default(0)
  failed    Int      @default(0)
  message   String?
  user      String   @default("System Administrator")
  createdAt DateTime @default(now())
}

/// An admin's ruling on a slab two shifts both claimed in MIS.
///
/// The scoreboard drops a contested slab from BOTH shifts, because paying it
/// twice is wrong and picking a winner is not a machine's decision. This table
/// is where the admin makes that call: one row per slab, naming the shift it
/// belongs to. Awarded slabs stop being contested — they score for the winner
/// and are excluded from everyone else.
///
/// Deliberately per-slab rather than per-range: a range is an MIS row, and the
/// row is exactly what was typed wrong, so a ruling keyed to it would move when
/// the row is corrected.
model SlabClaimAward {
  id         String   @id @default(cuid())
  slabNumber Float    @unique @map("slab_number")
  /// The IST date the winning shift STARTED (a C shift anchors on that day).
  anchor     String   @map("anchor")
  /// A | B | C
  shift      String   @map("shift")
  decidedBy  String?  @map("decided_by")
  decidedAt  DateTime @default(now()) @map("decided_at")

  @@index([anchor, shift])
  @@map("slab_claim_award")
}

// ---------------------------------------------------------------------------
// Finance engine (Bill Automation) — ported from automation/app/db.py so the
// whole flow runs inside the web app: Vercel + Neon, no Python service, no
// tunnel. Table-for-table with the SQLite schema except:
//   - `vouchers` (live Tally HTTP mode) and `layout_memory` (never read) are
//     not ported — file export is the only posting path here.
//   - Page images live in fin_bill_image (bytea) because Vercel has no disk.
// ---------------------------------------------------------------------------

model FinanceBill {
  id             Int      @id @default(autoincrement())
  filename       String
  // One row per BILL, not per uploaded file: an 11-page PDF of receipts is 11
  // separate claims, each needing its own ledger and amount.
  sourceFile     String?  @map("source_file")
  pageNo         Int      @default(1) @map("page_no")
  batchId        String?  @map("batch_id")
  fileSha256     String   @map("file_sha256")
  textLayer      String?  @map("text_layer")
  // Chosen by the clerk BEFORE upload, never read off the bill.
  person         String?
  phash          String?
  pageCount      Int      @default(1) @map("page_count")
  // queued | processing | review | needs_reupload | manual_entry
  // | approved | posted | rejected | duplicate | error
  status         String   @default("queued")
  error          String?
  autoApproved   Boolean  @default(false) @map("auto_approved")
  qualityVerdict String?  @map("quality_verdict")
  qualityJson    Json?    @map("quality_json")
  ocrEngine      String?  @map("ocr_engine")
  ocrVariant     String?  @map("ocr_variant")
  ocrConfidence  Float?   @map("ocr_confidence")
  ocrText        String?  @map("ocr_text")
  createdBy      String   @default("system") @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  image       FinanceBillImage?
  extractions FinanceExtraction[]

  @@index([fileSha256])
  @@index([status])
  @@index([batchId])
  @@map("fin_bill")
}

/// The page image, separated so bill listings never drag megabytes of bytea
/// through the pool. Compressed to JPEG at ingest; served by /bills/{id}/image.
model FinanceBillImage {
  billId Int         @id @map("bill_id")
  bill   FinanceBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  mime   String
  bytes  Bytes

  @@map("fin_bill_image")
}

model FinanceExtraction {
  id              Int         @id @default(autoincrement())
  billId          Int         @map("bill_id")
  bill            FinanceBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  vendorName      String?     @map("vendor_name")
  vendorGstin     String?     @map("vendor_gstin")
  invoiceNo       String?     @map("invoice_no")
  invoiceDate     String?     @map("invoice_date")
  taxableValue    Float?      @map("taxable_value")
  cgst            Float?
  sgst            Float?
  igst            Float?
  roundOff        Float?      @map("round_off")
  netAmount       Float?      @map("net_amount")
  hsnSac          String?     @map("hsn_sac")
  ledger          String?
  person          String?
  narration       String?
  fieldsJson      Json?       @map("fields_json")
  suggestionsJson Json?       @map("suggestions_json")
  confidence      Float?
  arithmeticOk    Boolean     @default(false) @map("arithmetic_ok")
  editedByUser    Boolean     @default(false) @map("edited_by_user")
  createdBy       String      @default("system") @map("created_by")
  createdAt       DateTime    @default(now()) @map("created_at")

  @@index([billId])
  @@index([vendorGstin, invoiceNo, netAmount])
  @@map("fin_extraction")
}

model FinanceVendorMemory {
  vendorKey String   @map("vendor_key")
  ledger    String
  count     Int      @default(1)
  lastSeen  DateTime @default(now()) @map("last_seen")

  @@id([vendorKey, ledger])
  @@map("fin_vendor_memory")
}

/// Which ledgers a person's claims actually go to — available BEFORE the bill
/// is read, and the cheapest intelligence in the system.
model FinancePersonMemory {
  person   String
  ledger   String
  count    Int      @default(1)
  lastSeen DateTime @default(now()) @map("last_seen")
  source   String   @default("confirmed") // confirmed | tally_history

  @@id([person, ledger])
  @@map("fin_person_memory")
}

model FinanceLedgerUsage {
  ledger String @id
  count  Int    @default(0)

  @@map("fin_ledger_usage")
}

model FinanceTokenWeight {
  token  String
  ledger String
  weight Float  @default(1.0)

  @@id([token, ledger])
  @@index([token])
  @@map("fin_token_weight")
}

model FinanceCorrection {
  id        Int      @id @default(autoincrement())
  billId    Int?     @map("bill_id")
  suggested String?
  corrected String?
  vendorKey String?  @map("vendor_key")
  person    String?
  score     Float?
  createdBy String   @default("system") @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("fin_correction")
}

model FinanceDuplicate {
  id             Int      @id @default(autoincrement())
  billId         Int      @map("bill_id")
  matchId        Int      @map("match_id")
  kind           String // file_hash | image_hash | field_match
  detail         String?
  overridden     Boolean  @default(false)
  overrideReason String?  @map("override_reason")
  overrideBy     String?  @map("override_by")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([billId])
  @@map("fin_duplicate")
}

/// One row per exported XML batch. A bill in an export is `posted` and
/// permanently excluded from later batches — with Tally's standard Journal
/// type, this table and dedupe are the ONLY duplicate defences there are.
model FinanceExport {
  ref        String   @id
  xml        String
  xlsxBase64 String?  @map("xlsx_base64")
  vouchers   Int
  total      Float
  newLedgers Json?    @map("new_ledgers")
  status     String   @default("generated") // generated | imported | voided
  note       String?
  createdBy  String   @default("system") @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  bills FinanceExportBill[]

  @@map("fin_export")
}

model FinanceExportBill {
  ref       String
  export    FinanceExport @relation(fields: [ref], references: [ref], onDelete: Cascade)
  billId    Int           @map("bill_id")
  voucherNo String        @map("voucher_no")

  @@id([ref, billId])
  @@index([billId])
  @@map("fin_export_bill")
}

/// The Tally chart of accounts, seeded from a MASTER.xml upload. Replaces both
/// ledgers_cache and the people list in config.yaml: person rows are the
/// claimant dropdown, expense rows are the classifier vocabulary.
model FinanceLedger {
  name      String   @id
  parent    String?
  gstin     String?
  isPerson  Boolean  @default(false) @map("is_person")
  isExpense Boolean  @default(false) @map("is_expense")
  syncedAt  DateTime @default(now()) @map("synced_at")

  @@index([isPerson])
  @@index([isExpense])
  @@map("fin_ledger")
}

model FinanceVendorEntry {
  id            Int      @id @default(autoincrement())
  billId        Int      @map("bill_id")
  vendorLedger  String   @map("vendor_ledger")
  expenseLedger String   @map("expense_ledger")
  taxable       Float
  cgst          Float    @default(0)
  sgst          Float    @default(0)
  igst          Float    @default(0)
  /// The reviewer's CHOSEN input-tax heads: [{ledger, amount, tax, rate}].
  ///
  /// The three scalars above cannot stand in for this. (tax, rate, eligible)
  /// does not identify one ledger — 9% eligible CGST matches both
  /// "INPUT CGST @ 9%" and "CGST @ 9% ON SERVICE", and nothing on the invoice
  /// chooses between them (gst.ts, trap 2). Re-deriving the head at export
  /// time would therefore silently overrule the human on the one decision the
  /// vendor panel exists to ask, and book input credit where the GST return
  /// will not find it. So the choice is stored verbatim.
  taxLinesJson  Json?    @map("tax_lines_json")
  tdsSection    String?  @map("tds_section")
  /// The full TDS head as spelled in Tally. `tdsSection` keeps the section
  /// (194C) for reporting; the voucher needs the ledger name itself, and PESPL
  /// runs several heads per section at different rates (tds.ts).
  tdsLedger     String?  @map("tds_ledger")
  tdsAmount     Float    @default(0) @map("tds_amount")
  invoiceNo     String?  @map("invoice_no")
  invoiceDate   String?  @map("invoice_date")
  narration     String?
  createdBy     String   @default("system") @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([billId])
  @@map("fin_vendor_entry")
}

/// The agent's journal. Autonomy without a journal is unaccountable: when a
/// clerk asks "why is this bill already approved?", the answer must be one
/// screen away, not a shrug.
model FinanceAgentEvent {
  id        Int      @id @default(autoincrement())
  kind      String
  billId    Int?     @map("bill_id")
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("fin_agent_event")
}

model FinanceLedgerRequest {
  id        Int      @id @default(autoincrement())
  name      String
  parent    String?
  reason    String?
  status    String   @default("open") // open | done | declined
  createdBy String   @default("system") @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("fin_ledger_request")
}

/// The costing rate card - one rate in force from a date.
///
/// Row-per-(item, variant, effective_from), append-only. "What did resin cost
/// in June?" is answered by the newest row at or before the batch's run date,
/// so costing a June batch uses June's rates even when today's differ - and a
/// re-costed batch prices identically forever. Purpose-built rather than
/// reusing consumables_and_rate: that table is an Airtable-sync snapshot with
/// one COLUMN per material and no unit or supplier axis, so a new grit band
/// there is a schema migration, where here it is a row an admin inserts.
model CostingRate {
  id            String   @id @default(cuid())
  /// RESIN | GRIT | FILLER | PIGMENT | CHEMICAL | CONVERSION | BASIS
  category      String
  /// Canonical key from src/lib/costing/rateCard.ts, e.g. "grit-0.6-1.2".
  item          String
  /// Splits an item across suppliers (resin: "Aypols", "3n Composits").
  /// Empty string rather than NULL so the uniqueness constraint can hold -
  /// Postgres treats NULLs as distinct, which would allow duplicate rows.
  variant       String   @default("")
  /// What `rate` is per: kg | t | sqft | month | slab | usd | day
  unit          String
  rate          Float
  effectiveFrom DateTime @map("effective_from") @db.Date
  note          String?
  createdBy     String   @default("system") @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([item, variant, effectiveFrom])
  @@index([category, effectiveFrom])
  @@map("costing_rate")
}

/// How ONE batch's materials were actually bought — quantity, price and what
/// each part was (src/lib/costing/batchRates.ts).
///
/// WHY LINES AND NOT A RATE. The mixer weighs one number, "resin, 1,000 kg".
/// What was bought is often several things: 600 kg from Aypols at ₹161 and 400
/// from 3n Composits at ₹145, or one drum from a new supplier at a trial price.
/// A single ₹/kg can only average that, and an average is exactly the figure
/// nobody can reconcile against an invoice. So a material may carry several
/// rows here, each with its own qty, rate and description.
///
/// FALLBACK, NOT REPLACEMENT. A material with no rows is priced whole at the
/// card rate, so a batch nobody has touched costs exactly as it did before this
/// table existed.
///
/// QUANTITIES NEED NOT SUM TO THE MIXER. Deliberately: the mixer figure is not
/// fixed — a corrected mixer row re-costs the batch on the next read — so a
/// split that balanced when typed can stop balancing without anyone touching
/// it. splitMaterial prices what is there and reports the difference; refusing
/// would blank a costing because a different screen was corrected.
///
/// Unlike costing_rate this is NOT append-only. A rate revision is history the
/// whole plant shares and earns a row; these are current facts about one run,
/// corrected in place — hence (batch_key, item, seq) and updatedAt rather than
/// effective_from.
///
/// Only material categories may appear: RESIN, GRIT, FILLER, PIGMENT, CHEMICAL
/// and the DOSING rules. CONVERSION is a whole-plant monthly figure and BASIS
/// holds the denominators every sheet divides by — a per-batch slab area or
/// ₹/USD would make two batches incomparable under the same column heading.
/// Enforced in batchRates.ts and again in the write route, not by this table.
model CostingBatchMaterial {
  id       String @id @default(cuid())
  /// mixer_cycle.batch_key — the same key the costing dashboard picks by.
  /// No FK: batch_key is a string across several import tables, not a table.
  batchKey String @map("batch_key")
  /// RESIN | GRIT | FILLER | PIGMENT | CHEMICAL | DOSING
  category String
  /// Canonical key from src/lib/costing/rateCard.ts, e.g. "grit-0.6-1.2".
  item     String
  /// Order within the material. Lines consume the mixer quantity in this
  /// order, so a null-qty "rest" line placed last takes what is left rather
  /// than everything.
  seq      Int    @default(0)

  /// How much this line covers, in the item's own unit. NULL means "whatever
  /// is left of the mixer's quantity" — the common case when someone splits
  /// off one known drum and lets the remainder fall through. Always null for
  /// DOSING, which is a factor with nothing to split.
  qty         Float?
  unit        String
  rate        Float
  /// Supplier, PO number, "trial drum" — what this part of the quantity was.
  /// This is the column that makes a split readable six months later.
  description String?
  note        String?

  createdBy String   @default("system") @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([batchKey, item, seq])
  @@index([batchKey])
  @@map("costing_batch_material")
}

/// RETIRED — modelled only so `prisma db push` stops proposing to DROP it.
///
/// The first shape of per-batch pricing (scripts/0040, restored by 0042 after
/// a push dropped it once already): one flat rate per (batch, item, variant),
/// superseded by costing_batch_material's split lines above. The table sits
/// in Neon with 0 rows (verified 2026-08-18) and no code reads or writes it.
/// Every attribute below describes the column exactly as it already exists —
/// including updated_at's plain CURRENT_TIMESTAMP default, deliberately NOT
/// Prisma's @updatedAt, so the diff stays empty. Do not reuse; drop it some
/// day with a numbered script, not with db push.
model CostingBatchRate {
  id       String  @id
  batchKey String  @map("batch_key")
  category String
  item     String
  variant  String  @default("")
  unit     String
  rate     Float
  note     String?

  createdBy String   @default("system") @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@unique([batchKey, item, variant], map: "costing_batch_rate_batch_item_variant_key")
  @@index([batchKey], map: "costing_batch_rate_batch_idx")
  @@map("costing_batch_rate")
}

/// One person's sign-off on one half of a batch.
///
/// The costed sheet is ADMIN-only and stays that way. What this table records
/// is the two checks made either side of it: the production manager confirming
/// the weights the mixer recorded, and the store incharge confirming the prices
/// those weights are costed at. Neither verifier can see the other's half and
/// neither sees a total — see src/lib/costing/verification.ts.
model CostingBatchVerification {
  id       String @id @default(cuid())
  /// mixer_cycle.batch_key, same key the costing dashboard picks by. No FK for
  /// the same reason as costing_batch_material: batch_key is a string across
  /// several import tables, not a table.
  batchKey String @map("batch_key")
  /// WEIGHTS | COSTS. Text rather than an enum so this migrates on a database
  /// where `prisma migrate` is applied by hand.
  side     String

  /// What the side's numbers hashed to when the button was pressed.
  ///
  /// Stored rather than a bare boolean because the weights are edited on half a
  /// dozen other screens and the prices move whenever the rate card is revised.
  /// Hooking every write path that could invalidate a sign-off means finding
  /// all of them, and missing one leaves a batch marked checked over numbers
  /// that changed after the check. Comparing the numbers cannot miss one.
  fingerprint String

  verifiedBy String   @map("verified_by")
  verifiedAt DateTime @default(now()) @map("verified_at")

  /// Per PERSON per side, not per side: both verifiers may hold a mark on the
  /// same side of the same batch (owner, 2026-08-18 — scripts/0048). The old
  /// (batchKey, side) unique made the second signature overwrite the first.
  @@unique([batchKey, side, verifiedBy])
  @@index([batchKey])
  @@map("costing_batch_verification")
}

/// Which SIZE a silo ran in one batch — the production side of silo-wise grit.
///
/// NO RATE COLUMN, deliberately. The price lives in costing_batch_material under
/// 'grit-silo-<n>', which is the only table any sheet is priced from. A rupee
/// figure here would be a second pricing path and a second fingerprint input
/// computed in two places, and would put money one SELECT away from a screen
/// that is meant to carry none.
///
/// NO RELATION TO Silo, and none to MixerCycle. silo_no is the mixer's own typed
/// string, not silo.id — an assignment describes what somebody says a silo ran
/// on one batch, and must never become a handle for writing to the silo record.
model CostingBatchGritSilo {
  id       String @id @default(cuid())
  /// mixer_cycle.batch_key. No FK: batch_key is a string across several import
  /// tables, not a table — same as costing_batch_material.
  batchKey String @map("batch_key")
  /// The mixer's own silo string (mixer_cycle.m*_g*_sn), btrim'd.
  siloNo   String @map("silo_no")
  /// Verbatim as typed. Normalised only for COMPARISON (sizeKey), never stored
  /// canonicalised — a stored canonical form is a second source of truth. Not a
  /// rate-card key: a typed size must never mint a catalogue entry.
  /// '' means listed but not yet sized.
  size     String @default("")
  /// What the silo ran: "Premium Supreme G2", "Glass", "Cristobalite", or
  /// whatever the plant runs next. Verbatim as typed, exactly like `size`, and
  /// for the same two reasons: a stored canonical form is a second source of
  /// truth, and a typed value must never mint a rate-card key. '' means not
  /// chosen yet. The dropdown is DERIVED from this column, so a type typed once
  /// is offered on every batch afterwards with no dictionary to administer.
  gritType String @default("") @map("grit_type")

  assignedBy String   @default("system") @map("assigned_by")
  assignedAt DateTime @default(now()) @map("assigned_at")
  updatedAt  DateTime @default(now()) @map("updated_at")

  /// ONE SIZE PER SILO PER BATCH. This index is where "a silo cannot run two
  /// sizes in one batch" is actually true; the single dropdown is only how it
  /// looks on screen.
  @@unique([batchKey, siloNo])
  @@index([batchKey])
  /// The learned size list is SELECT DISTINCT over this column.
  @@index([size])
  @@map("costing_batch_grit_silo")
}

/// Which supplier(s) a silo's weight was drawn from, and how much from each.
///
/// Same no-rate, no-relation rules as CostingBatchGritSilo above. Kilograms, not
/// tonnes: the mixer records kilograms and the screen shows kilograms, and the
/// single conversion to tonnes happens in report.ts where rupees-per-tonne is
/// applied. Converting in two places is how somebody types 14,780 against a kilo.
model CostingBatchGritSupplier {
  id       String    @id @default(cuid())
  batchKey String    @map("batch_key")
  siloNo   String    @map("silo_no")
  /// Position within the silo's split; rewritten wholesale per silo on save,
  /// the same convention as costing_batch_material.seq.
  seq      Int       @default(0)
  /// As typed. Compared fuzzily to the silo's recorded supplier and flagged when
  /// they differ — THE TYPED VALUE WINS, and nothing here is written back.
  supplier String
  kg       Float
  /// Rupees per TONNE for this supplier's share of this silo. The weight beside
  /// it is KILOGRAMS, because that is what the mixer records; the single
  /// conversion lives in report.ts and must not be repeated.
  ///
  /// NULLABLE, AND NULL IS NOT ZERO. Null means nobody has priced this line;
  /// 0 would mean the grit was free. Anything that reads this with `?? 0`
  /// turns an unpriced batch into a cheap one and prints a complete-looking
  /// sheet with the grit silently missing.
  ratePerT Float?    @map("rate_per_t")
  /// Kept apart from assignedBy/assignedAt, which record who assigned the
  /// SPLIT. Usually the same person, but an admin may correct a rate long
  /// after the split was entered and collapsing them would erase that.
  rateBy   String?   @map("rate_by")
  rateAt   DateTime? @map("rate_at")

  assignedBy String   @default("system") @map("assigned_by")
  assignedAt DateTime @default(now()) @map("assigned_at")

  @@unique([batchKey, siloNo, seq])
  @@index([batchKey])
  @@index([supplier])
  @@map("costing_batch_grit_supplier")
}

// ============================================================================
// CHROMIA MODULE — Chromia line slab lifecycle (ported from the CHROMIA_MODULE
// standalone app). Intake -> ten processing stages -> QC -> grade ->
// recalibration loop (max 5 attempts) -> dispatch / stock / sample cutting /
// waste, plus the legacy Excel register importer.
//
// Namespacing: every model is Chromia-prefixed and every table/type is
// chromia_-prefixed, matching the Robo precedent — in a 111-model schema a bare
// `Slab` or `Machine` would say nothing about which line owns it. NOTE: the
// pre-existing Chromia1 / ChromiaPar1 models above are legacy Airtable mirrors
// of this same line (tables chromia_1 / chromia_par_1) — untouched, and no name
// here collides with them.
//
// User attribution: the module shipped its own User model and FK'd every action
// to it. Logins here are ERP users (role CHROMIA, gated exactly like Robo — see
// lib/chromia/tier.ts), so every *ById / userId / operatorId / inspectorId
// column below is a plain String? holding an ERP users.id with NO foreign key —
// the Sales precedent. The ChromiaUser table is carried across dormant as the
// module's employee directory; nothing references it and nothing should write
// to it while sign-in is owned by the ERP.
//
// Hand-maintained; NOT touched by gen-schema.py. Conventions kept from the
// module: snake_case tables/columns via @@map/@map, uuid() ids,
// Decimal(18,3) measurements, createdAt/updatedAt everywhere, soft-delete
// deletedAt on business entities, append-only ChromiaSlabEvent.
//
// Neon: scripts/0044-drop-chromia-module.sql drops the previous integration's
// tables, then scripts/0045-chromia-module.sql creates these, then
// scripts/0046-migrate-chromia-branch-users.sql moves any login left on the
// retired CHROMIA department onto the role (NOT db push).
// ============================================================================
enum ChromiaRole {
  ADMIN
  PRODUCTION_MANAGER
  SUPERVISOR
  OPERATOR
  QUALITY_INSPECTOR
  STORE_KEEPER
  VIEWER

  @@map("chromia_role")
}

enum ChromiaUserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("chromia_user_status")
}

/// The ten stages of the Chromia process, in order.
enum ChromiaProcessStage {
  INCOMING
