model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String?
  passwordHash       String
  sessionVersion     Int                 @default(1) @map("session_version") // bump -> all of this user's devices are logged out
  role               Role                @default(OPERATOR)
  station            Station?
  branch             Branch              @default(SHOP_FLOOR)
  active             Boolean             @default(true)
  // International Sales duty + factory scope (text on purpose: the fork's
  // SalesRole enum is retired — PRODUCTION_MANAGER duties belong to ADMIN).
  // Columns arrive via scripts/0020-sales-user-columns.sql (user-applied).
  salesRole          String?             @map("sales_role")
  salesFactory       String?             @map("sales_factory")
  createdById        String?
  createdBy          User?               @relation("UserCreator", fields: [createdById], references: [id])
  createdUsers       User[]              @relation("UserCreator")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  cuttingEntries     CuttingEntry[]
  fabMachineSessions FabMachineSession[]
  fabSlabJobs        FabSlabJob[]
  fabOperations      FabOperation[]

  @@map("users")
}

/// Login rate-limit counters (src/auth.ts): one row per throttle key, counting
/// failures in a rolling 15-minute window; stale rows are cleaned opportunistically.
/// DB-backed so the lockout survives serverless instances — auth falls back to an
/// in-memory map if this table is absent. Hand-written; access stays raw SQL.
model LoginAttempt {
  key     String   @id
  n       Int      @default(1)
  firstAt DateTime @default(now()) @map("first_at") @db.Timestamptz(6)

  @@map("login_attempt")
}

