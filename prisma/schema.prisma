// ---- Identity & audit ------------------------------------------------------

/// DORMANT — carried across from the standalone module, where it was the
/// login table. In the ERP, Chromia staff sign in as `users` rows (branch
/// CHROMIA) and every attribution column stores users.id as a plain string,
/// so nothing points here. Kept (not dropped) so the employee-code / shift
/// directory concept survives if the line wants it later without a schema
/// change. Do not write to it while sign-in is owned by the ERP.
model ChromiaUser {
  id           String            @id @default(uuid())
  employeeCode String            @unique @map("employee_code")
  email        String            @unique
  name         String
  passwordHash String?           @map("password_hash")
  role         ChromiaRole       @default(OPERATOR)
  status       ChromiaUserStatus @default(ACTIVE)
  phone        String?
  shift        String?
  lastLoginAt  DateTime?         @map("last_login_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([role, status])
  @@index([deletedAt])
  @@map("chromia_user")
}

model ChromiaAuditLog {
  id         String             @id @default(uuid())
  entity     String
  entityId   String             @map("entity_id")
  action     ChromiaAuditAction
  userId     String?            @map("user_id") // -> users.id (no hard FK)
  changes    Json?
  ipAddress  String?            @map("ip_address")
  userAgent  String?            @map("user_agent")
  occurredAt DateTime           @default(now()) @map("occurred_at")

  @@index([entity, entityId])
  @@index([userId])
  @@index([occurredAt])
  @@map("chromia_audit_log")
}

// ---- Master data -----------------------------------------------------------

/// Base slab material — "Coastal Pearl", "Bianco Cristallo", "Maple Gaze", ...
model ChromiaBaseMaterial {
  id                   String   @id @default(uuid())
  code                 String   @unique
  name                 String
  description          String?
  defaultThicknessMm   Decimal? @map("default_thickness_mm") @db.Decimal(18, 3)
  minUsableThicknessMm Decimal? @map("min_usable_thickness_mm") @db.Decimal(18, 3)
  isActive             Boolean  @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  batches ChromiaBatch[]
  slabs   ChromiaSlab[]

  @@index([isActive])
  @@map("chromia_base_material")
}

/// Digital print artwork — "Cristallo OG", "Lighter Thaj 3", "AlmondMist1", ...
model ChromiaDesign {
  id       String  @id @default(uuid())
  code     String  @unique
  name     String
  fileName String  @map("file_name")
  version  String?
  notes    String?
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  plannedForSlabs ChromiaSlab[]           @relation("ChromiaPlannedDesign")
  processCycles   ChromiaProcessCycle[]
  printingDetails ChromiaPrintingDetail[]

  @@index([isActive])
  @@index([fileName])
  @@map("chromia_design")
}

model ChromiaMachine {
  id       String               @id @default(uuid())
  code     String               @unique
  name     String
  type     ChromiaMachineType
  stage    ChromiaProcessStage?
  isActive Boolean              @default(true) @map("is_active")

  locationId String?          @map("location_id")
  location   ChromiaLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  stageRecords ChromiaStageRecord[]

  @@index([type, isActive])
  @@index([stage])
  @@map("chromia_machine")
}

model ChromiaLocation {
  id       String              @id @default(uuid())
  code     String              @unique
  name     String
  type     ChromiaLocationType
  capacity Int?
  isActive Boolean             @default(true) @map("is_active")

  parentId String?           @map("parent_id")
  parent   ChromiaLocation?  @relation("ChromiaLocationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children ChromiaLocation[] @relation("ChromiaLocationHierarchy")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  machines       ChromiaMachine[]
  slabsHere      ChromiaSlab[]          @relation("ChromiaSlabCurrentLocation")
  stageRecords   ChromiaStageRecord[]
  movementsFrom  ChromiaSlabMovement[]  @relation("ChromiaMovementFrom")
  movementsTo    ChromiaSlabMovement[]  @relation("ChromiaMovementTo")
