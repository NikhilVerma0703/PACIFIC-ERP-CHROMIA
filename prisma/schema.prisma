// ─────────────────────────────────────────────────────────────────────────────
// Fabrication Module (erp-v4 integrated)
// All tables prefixed fab_ to avoid conflicts with existing Pacific-ERP tables.
// ─────────────────────────────────────────────────────────────────────────────

enum FabProjectStatus {
  PLANNING
  ALLOCATED
  RELEASED_TO_PRODUCTION
  COMPLETED
}

enum FabRequirementStatus {
  PENDING
  ALLOCATED
  RELEASED
}

enum FabPieceStatus {
  PENDING
  CUTTING
  CUT
  POLISHING
  POLISHED
  SINK_CUTTING
  SINK_CUT
  FABRICATION
  FABRICATED
  PACKAGED
}

enum FabMachineType {
  CUTTING
  POLISHING
  SINK_CUTTING
  FABRICATION
  PACKAGING
}

enum FabOperationType {
  CUTTING
  POLISHING
  SINK_CUTTING
  FABRICATION
  PACKAGING
}

enum FabOperationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum FabSlabProductionStatus {
  READY
  IN_PROGRESS
  COMPLETED
}

enum FabShapeType {
  RECTANGLE
  L_SHAPE
  CURVE
  ROUND
  CUSTOM
}

model FabMachine {
  id         String              @id @default(cuid())
  code       String              @unique
  name       String
