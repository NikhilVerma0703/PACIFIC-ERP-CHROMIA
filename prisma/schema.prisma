// ---- Core transactions -----------------------------------------------------

model ChromiaBatch {
  id           String   @id @default(uuid())
  batchNo      String   @unique @map("batch_no")
  receivedDate DateTime @map("received_date")
  totalSlabs   Int      @default(0) @map("total_slabs")
  notes        String?

  baseMaterialId String              @map("base_material_id")
  baseMaterial   ChromiaBaseMaterial @relation(fields: [baseMaterialId], references: [id])

  supplierId String?          @map("supplier_id")
  supplier   ChromiaSupplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  createdById String?   @map("created_by_id") // -> users.id (no hard FK)
  updatedById String?   @map("updated_by_id") // -> users.id (no hard FK)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  slabs ChromiaSlab[]

  @@index([receivedDate])
  @@index([baseMaterialId])
  @@map("chromia_batch")
}

/// One physical slab. Its identity is permanent for the slab's entire life,
/// across every recalibration cycle.
model ChromiaSlab {
  id     String @id @default(uuid())
  slabNo String @unique @map("slab_no")

  batchId String       @map("batch_id")
  batch   ChromiaBatch @relation(fields: [batchId], references: [id])

  baseMaterialId String              @map("base_material_id")
  baseMaterial   ChromiaBaseMaterial @relation(fields: [baseMaterialId], references: [id])

  plannedDesignId String?        @map("planned_design_id")
  plannedDesign   ChromiaDesign? @relation("ChromiaPlannedDesign", fields: [plannedDesignId], references: [id], onDelete: SetNull)

  // Physical attributes
  originalThicknessMm Decimal? @map("original_thickness_mm") @db.Decimal(18, 3)
  currentThicknessMm  Decimal? @map("current_thickness_mm") @db.Decimal(18, 3)
  lengthMm            Decimal? @map("length_mm") @db.Decimal(18, 3)
  widthMm             Decimal? @map("width_mm") @db.Decimal(18, 3)

  // Live position — denormalised for fast dashboard reads. Always written in
  // the same transaction as the ChromiaSlabEvent that caused the change.
  status             ChromiaSlabStatus    @default(RECEIVED)
  currentStage       ChromiaProcessStage? @map("current_stage")
  currentCycleNumber Int                  @default(1) @map("current_cycle_number")

  currentLocationId String?          @map("current_location_id")
  currentLocation   ChromiaLocation? @relation("ChromiaSlabCurrentLocation", fields: [currentLocationId], references: [id], onDelete: SetNull)

  // Outcome
  currentGrade       ChromiaSlabGrade?   @map("current_grade")
  currentDisposition ChromiaDisposition? @map("current_disposition")

  // Recalibration counters — the five-attempt ceiling is checked against these.
  recalibrationCount Int     @default(0) @map("recalibration_count")
  isRecalibrationOut Boolean @default(false) @map("is_recalibration_out")

  receivedDate       DateTime @map("received_date")
  conditionOnArrival String?  @map("condition_on_arrival")
  remarks            String?

  // Legacy Excel import — null for records created inside the ERP.
  legacySourceFile String?             @map("legacy_source_file")
  legacySheetName  String?             @map("legacy_sheet_name")
  legacySourceRow  Int?                @map("legacy_source_row")
  legacyRemark     String?             @map("legacy_remark")
  importBatchId    String?             @map("import_batch_id")
  importBatch      ChromiaImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  createdById String?   @map("created_by_id") // -> users.id (no hard FK)
  updatedById String?   @map("updated_by_id") // -> users.id (no hard FK)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  cycles         ChromiaProcessCycle[]
  stageRecords   ChromiaStageRecord[]
  events         ChromiaSlabEvent[]
  movements      ChromiaSlabMovement[]
  qcRecords      ChromiaQcRecord[]
  gradeDecisions ChromiaGradeDecision[]
  recalibrations ChromiaRecalibrationCycle[]
  dispatches     ChromiaDispatch[]
  stockEntries   ChromiaStockEntry[]
  sampleCuttings ChromiaSampleCutting[]
  wasteRecord    ChromiaWasteRecord?

  @@index([status])
  @@index([status, currentStage])
  @@index([currentStage])
  @@index([batchId])
  @@index([currentLocationId])
  @@index([isRecalibrationOut])
  @@index([receivedDate])
  @@index([deletedAt])
  @@map("chromia_slab")
}

/// One complete pass of a slab through the ten stages.
/// Cycle 1 is the original pass; cycle n+1 follows the n-th recalibration.
model ChromiaProcessCycle {
  id          String             @id @default(uuid())
  cycleNumber Int                @map("cycle_number")
  status      ChromiaCycleStatus @default(ACTIVE)
  startedAt   DateTime           @default(now()) @map("started_at")
  completedAt DateTime?          @map("completed_at")

  slabId String      @map("slab_id")
  slab   ChromiaSlab @relation(fields: [slabId], references: [id], onDelete: Cascade)

  designId String?        @map("design_id")
  design   ChromiaDesign? @relation(fields: [designId], references: [id], onDelete: SetNull)

  /// Processing window. The six production stages (Base Primer, Printing,
  /// Moulding, Cooling, Polishing, UV Polishing) are NOT timed individually —
  /// the slab is stamped in when it enters processing and out when all of
  /// them are finished.
  inTime            DateTime? @map("in_time")
  outTime           DateTime? @map("out_time")
  processingMinutes Int?      @map("processing_minutes")

  /// The date the slab came out fully printed — the register's "fully printed
  /// date" column. Recorded per cycle, so a recalibrated slab that is printed
  /// again gets its own date on cycle 2.
  fullyPrintedDate DateTime? @map("fully_printed_date") @db.Date

  printResult ChromiaPrintResult? @map("print_result")
  finalGrade  ChromiaSlabGrade?   @map("final_grade")
  disposition ChromiaDisposition?
  notes       String?

  createdById String?  @map("created_by_id") // -> users.id (no hard FK)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  stageRecords  ChromiaStageRecord[]
  events        ChromiaSlabEvent[]
  qcRecord      ChromiaQcRecord?
  gradeDecision ChromiaGradeDecision?
  failedInto    ChromiaRecalibrationCycle? @relation("ChromiaFailedCycle")
  restartedFrom ChromiaRecalibrationCycle? @relation("ChromiaRestartedCycle")

  @@unique([slabId, cycleNumber])
  @@index([status])
  @@index([slabId])
  @@index([outTime])
  @@map("chromia_process_cycle")
}

/// Execution record for one stage within one cycle.
/// Start and end are captured separately, so true stage duration is known.
model ChromiaStageRecord {
  id       String              @id @default(uuid())
  stage    ChromiaProcessStage
  sequence Int
  status   ChromiaStageStatus  @default(PENDING)

  startedAt       DateTime? @map("started_at")
  endedAt         DateTime? @map("ended_at")
  durationMinutes Int?      @map("duration_minutes")
  holdMinutes     Int?      @map("hold_minutes")
  isOverdue       Boolean   @default(false) @map("is_overdue")

  cycleId String              @map("cycle_id")
  cycle   ChromiaProcessCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  slabId String      @map("slab_id")
  slab   ChromiaSlab @relation(fields: [slabId], references: [id], onDelete: Cascade)

  operatorId String? @map("operator_id") // -> users.id (no hard FK)

  machineId String?         @map("machine_id")
  machine   ChromiaMachine? @relation(fields: [machineId], references: [id], onDelete: SetNull)

  locationId String?          @map("location_id")
  location   ChromiaLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  incomingDetail    ChromiaIncomingDetail?
  primerDetail      ChromiaPrimerDetail?
  printingDetail    ChromiaPrintingDetail?
  mouldingDetail    ChromiaMouldingDetail?
  coolingDetail     ChromiaCoolingDetail?
  polishingDetail   ChromiaPolishingDetail?
  uvPolishingDetail ChromiaUvPolishingDetail?

  @@unique([cycleId, stage])
  @@index([slabId, stage])
  @@index([stage, status])
  @@index([status, startedAt])
  @@index([operatorId])
  @@map("chromia_stage_record")
}

/// Append-only history. Never updated, never deleted — corrections are
/// recorded as new events of type CORRECTION. (Renamed from the module's
/// SlabEvent — the ERP's SlabEvent is the production-line slab event.)
model ChromiaSlabEvent {
  id        String               @id @default(uuid())
  eventType ChromiaSlabEventType @map("event_type")

  slabId String      @map("slab_id")
  slab   ChromiaSlab @relation(fields: [slabId], references: [id], onDelete: Cascade)

  cycleId String?              @map("cycle_id")
  cycle   ChromiaProcessCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  stage      ChromiaProcessStage?
  fromStage  ChromiaProcessStage? @map("from_stage")
  toStage    ChromiaProcessStage? @map("to_stage")
  fromStatus ChromiaSlabStatus?   @map("from_status")
  toStatus   ChromiaSlabStatus?   @map("to_status")

  locationId String?          @map("location_id")
  location   ChromiaLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  userId String? @map("user_id") // -> users.id (no hard FK)

  occurredAt DateTime @default(now()) @map("occurred_at")
  note       String?
  payload    Json?

  @@index([slabId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([cycleId])
  @@map("chromia_slab_event")
}

/// Physical movement of a slab between locations.
model ChromiaSlabMovement {
  id      String                @id @default(uuid())
  reason  ChromiaMovementReason
  movedAt DateTime              @default(now()) @map("moved_at")
  note    String?

  slabId String      @map("slab_id")
  slab   ChromiaSlab @relation(fields: [slabId], references: [id], onDelete: Cascade)

  fromLocationId String?          @map("from_location_id")
  fromLocation   ChromiaLocation? @relation("ChromiaMovementFrom", fields: [fromLocationId], references: [id], onDelete: SetNull)

  toLocationId String          @map("to_location_id")
  toLocation   ChromiaLocation @relation("ChromiaMovementTo", fields: [toLocationId], references: [id])

  movedById String? @map("moved_by_id") // -> users.id (no hard FK)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([slabId, movedAt])
  @@index([toLocationId])
  @@map("chromia_slab_movement")
}

