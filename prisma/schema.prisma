  rmGrade           Json?    @map("rm_grade")
  lastSiloIds       String[] @default([]) @map("last_silo")
  siloRemaining     Json?    @map("silo_remaining")
  lastResinTankIds  String[] @default([]) @map("last_resin_tank")
  resinStatus       Json?    @map("resin_status")
  updateTime        Json?    @map("update_time")
  importedAt        DateTime @default(now()) @map("imported_at")
  syncedAt          DateTime @updatedAt @map("synced_at")

  @@map("mixer_cycle_summary")
}

/// Append-only log of reversible data-fix actions, enabling "undo the last action".
model ActionLog {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now()) @map("created_at")
  actor     String?
  batchKey  String?   @map("batch_key")
  kind      String
  model     String?
  summary   String
  payload   Json
  undone    Boolean   @default(false)
  undoneAt  DateTime? @map("undone_at")

  @@index([batchKey, undone, createdAt])
  @@map("action_log")
}

/// Phased Airtable→ERP cutover: which system owns each table, and the
/// incremental-sync watermark for tables still sourced from Airtable.
model SyncState {
  id             String    @id @default(cuid())
  model          String    @unique
  source         String    @default("AIRTABLE") // "AIRTABLE" | "ERP"
  cursor         DateTime? @map("cursor") // sync watermark (last-modified filter)
  lastSyncAt     DateTime? @map("last_sync_at")
  lastCount      Int       @default(0) @map("last_count")
  lastChangeAt   DateTime? @map("last_change_at") // last time Airtable actually had changes
  airtableTotal  Int?      @map("airtable_total") // record count from the parity check
  countCheckedAt DateTime? @map("count_checked_at") // when parity was last verified
  autoCutover    Boolean   @default(true) @map("auto_cutover")
  cutoverAt      DateTime? @map("cutover_at")
  cutoverBy      String?   @map("cutover_by") // "auto" | user name

  @@map("sync_state")
}

// ─────────────────────────────────────────────────────────────────────────────
// Cutting / Sampling Module
// ─────────────────────────────────────────────────────────────────────────────

model CuttingEntry {
  id          String   @id @default(cuid())
  slabNumber  Float
  batchKey    String   @map("batch_key")
  design      String?
  cutDate     DateTime @map("cut_date")
  operator    String
  lengthCm    Float?   @map("length_cm")
  widthCm     Float?   @map("width_cm")
  thicknessMm Float?   @map("thickness_mm")
  quantity    Int      @default(1)
  purpose     String?
  remarks     String?
  createdById String?  @map("created_by_id")
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("cutting_entry")
}

// ─────────────────────────────────────────────────────────────────────────────
// Fabrication Module (erp-v4 integrated)
// All tables prefixed fab_ to avoid conflicts with existing Pacific-ERP tables.
// ─────────────────────────────────────────────────────────────────────────────

enum FabProjectStatus {
  PLANNING
  ALLOCATED
  RELEASED_TO_PRODUCTION
  COMPLETED
}

enum FabRequirementStatus {
  PENDING
  ALLOCATED
  RELEASED
}

enum FabPieceStatus {
  PENDING
  CUTTING
  CUT
  POLISHING
  POLISHED
  SINK_CUTTING
  SINK_CUT
  FABRICATION
  FABRICATED
  PACKAGED
  REJECTED
}

enum FabMachineType {
  CUTTING
  POLISHING
  SINK_CUTTING
  FABRICATION
  PACKAGING
}

enum FabOperationType {
  CUTTING
  POLISHING
  SINK_CUTTING
  FABRICATION
  PACKAGING
}

enum FabOperationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum FabSlabProductionStatus {
  READY
  IN_PROGRESS
  COMPLETED
}

enum FabShapeType {
  RECTANGLE
  L_SHAPE
  CURVE
  ROUND
  CUSTOM
}

model FabMachine {
  id         String              @id @default(cuid())
  code       String              @unique
  name       String
  type       FabMachineType
  createdAt  DateTime            @default(now()) @map("created_at")
  sessions   FabMachineSession[]
  operations FabOperation[]
  slabJobs   FabSlabJob[]
  downtimes  FabMachineDowntime[]

  @@map("fab_machine")
}

/// Floor roster. The operator login is shared; these names are who actually
/// stood at the machine for a process session. Supervisor creates them.
model FabWorker {
  id        String               @id @default(cuid())
  name      String               @unique
  active    Boolean              @default(true)
  createdAt DateTime             @default(now()) @map("created_at")
  createdById String?            @map("created_by_id")
  createdBy   User?              @relation(fields: [createdById], references: [id])
  sessions    FabMachineSession[]
  operations  FabOperation[]
  slabJobs    FabSlabJob[]
  downtimes   FabMachineDowntime[]

  @@index([active])
  @@map("fab_worker")
}

model FabMachineSession {
  id         String     @id @default(cuid())
  userId     String     @map("user_id")
  user       User       @relation(fields: [userId], references: [id])
  machineId  String     @map("machine_id")
  machine    FabMachine @relation(fields: [machineId], references: [id])
  /// Who is standing at this process for this session. Null on sessions
  /// started before the roster existed.
  workerId   String?    @map("worker_id")
  worker     FabWorker? @relation(fields: [workerId], references: [id])
  shift      String
  loginTime  DateTime   @default(now()) @map("login_time")
  logoutTime DateTime?  @map("logout_time")
  isActive   Boolean    @default(true) @map("is_active")

  @@index([machineId, isActive])
  @@map("fab_machine_session")
}

/// Floor stoppage on one machine / process. Start and end are logged while a
/// process session is open so the name and shift are known.
model FabMachineDowntime {
  id          String      @id @default(cuid())
  machineId   String      @map("machine_id")
  machine     FabMachine  @relation(fields: [machineId], references: [id])
  processType String      @map("process_type")
  reason      String
  notes       String?
  startedAt   DateTime    @default(now()) @map("started_at")
  endedAt     DateTime?   @map("ended_at")
  workerId    String?     @map("worker_id")
  worker      FabWorker?  @relation(fields: [workerId], references: [id])
  shift       String?
  sessionId   String?     @map("session_id")
  userId      String      @map("user_id")

  @@index([machineId, endedAt])
  @@index([processType, endedAt])
  @@map("fab_machine_downtime")
}

model FabProject {
  id             String           @id @default(cuid())
  projectCode    String           @unique @map("project_code")
  customerName   String           @map("customer_name")
  status         FabProjectStatus @default(PLANNING)
  numberOfPieces Int              @default(0) @map("number_of_pieces")
  drawingPdfUrl  String?          @map("drawing_pdf_url")
  remarks        String?
  createdAt      DateTime         @default(now()) @map("created_at")
  slabs          FabSlab[]
  pieces         FabPiece[]
  requirements   FabRequirement[]
  drawings       FabDrawing[]
  pos            FabPo[]

  @@map("fab_project")
}

model FabDrawing {
  id            String           @id @default(cuid())
  drawingNumber String           @map("drawing_number")
  unitType      String?          @map("unit_type")
  units         Int?
  areaName      String?          @map("area_name")
  projectId     String           @map("project_id")
  project       FabProject       @relation(fields: [projectId], references: [id])
  defaultSlabId String?          @map("default_slab_id")
  defaultSlab   FabSlab?         @relation("DrawingDefaultSlab", fields: [defaultSlabId], references: [id])
  remarks       String?
  createdAt     DateTime         @default(now()) @map("created_at")
  pieces        FabPiece[]
  requirements  FabRequirement[]

  @@map("fab_drawing")
}

model FabSlab {
  id                     String                     @id @default(cuid())
  slabCode               String                     @map("slab_code")
  colour                 String?
  material               String?
  thickness              Float?
  length                 Float?
  width                  Float?
  totalArea              Float?                     @map("total_area")
  reservedArea           Float?                     @default(0) @map("reserved_area")
  availableArea          Float?                     @map("available_area")
  pacificQcId            String?                    @map("pacific_qc_id")
  projectId              String                     @map("project_id")
  project                FabProject                 @relation(fields: [projectId], references: [id])
  createdAt              DateTime                   @default(now()) @map("created_at")
  pieces                 FabPiece[]
  slabJobs               FabSlabJob[]
  allocations            FabSlabAllocation[]
  requirementAllocations FabRequirementAllocation[]
  assignedDrawings       FabDrawing[]               @relation("DrawingDefaultSlab")
  residuals              FabResidualBag[]

  /// The slab board reads every slab of one project. See scripts/0045.
  @@index([projectId])
  @@map("fab_slab")
}

model FabSlabJob {
  id              String                  @id @default(cuid())
  slabId          String                  @map("slab_id")
  slab            FabSlab                 @relation(fields: [slabId], references: [id])
  machineId       String?                 @map("machine_id")
  machine         FabMachine?             @relation(fields: [machineId], references: [id])
  operatorId      String?                 @map("operator_id")
  operator        User?                   @relation(fields: [operatorId], references: [id])
  workerId        String?                 @map("worker_id")
  worker          FabWorker?              @relation(fields: [workerId], references: [id])
  status          FabSlabProductionStatus @default(READY)
  startTime       DateTime?               @map("start_time")
  endTime         DateTime?               @map("end_time")
  usedAreaSqft    Float?                  @map("used_area_sqft")
  totalWastagePct Float?                  @map("total_wastage_pct")
  trueScrapPct    Float?                  @map("true_scrap_pct")
  kerfMm          Float?                  @default(3) @map("kerf_mm")
  createdAt       DateTime                @default(now()) @map("created_at")

  /// "Has this slab already gone to the cutter?" — asked before every edit
  /// on the slab board and by approve-slab's idempotency check, always
  /// filtered on status as well. See scripts/0045.
  @@index([slabId, status])
  /// "Which slabs were cut between these two dates?" — the CLO half of the
  /// cutting number on the CEO dashboard. The other index leads on slab_id and
  /// cannot serve a scan by status and time. See scripts/0046.
  @@index([status, endTime])
  @@map("fab_slab_job")
}

/// A customer purchase order under a project. A project may hold several POs;
/// the piece rows of each PO's PDF become fab_requirement rows carrying po_id.
/// See scripts/0044-fab-po.sql.
model FabPo {
  id            String           @id @default(cuid())
  projectId     String           @map("project_id")
  project       FabProject       @relation(fields: [projectId], references: [id])
  poNumber      String           @map("po_number")
  /// The uploaded PO PDF's file name, so a manager can tell which document a
  /// set of requirements came from. Null until the PDF is imported.
  pdfFileName   String?          @map("pdf_file_name")
  pdfImportedAt DateTime?        @map("pdf_imported_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  requirements  FabRequirement[]

  /// Unique WITHIN a project, not globally: two customers may legitimately
  /// send the same external PO number. Also the index for "find this PO".
  @@unique([projectId, poNumber])
  /// The PO list on a project page: where project_id = ? order by created_at desc.
  @@index([projectId, createdAt])
  @@map("fab_po")
}

model FabRequirement {
  id                  String                     @id @default(cuid())
  projectId           String                     @map("project_id")
  project             FabProject                 @relation(fields: [projectId], references: [id])
  drawingId           String?                    @map("drawing_id")
  drawing             FabDrawing?                @relation(fields: [drawingId], references: [id])
  /// The purchase order this row came off, when it came from a PO PDF.
  /// Nullable: every requirement created before the PO intake existed has none.
  poId                String?                    @map("po_id")
  po                  FabPo?                     @relation(fields: [poId], references: [id])
  pieceLabel          String?                    @map("piece_label")
  description         String?
  slabCode            String                     @map("slab_code")
  length              Float?
  width               Float?
  thickness           Float?
  quantity            Int
  shapeType           FabShapeType?              @map("shape_type")
  sinkRequired        Boolean                    @default(false) @map("sink_required")
  fabricationRequired Boolean                    @default(false) @map("fabrication_required")
  polishRequired      Boolean                    @default(false) @map("polish_required")
  // How many of `quantity` pieces get a sink — the supervisor's call, per row,
  // replacing the sheet's sink_cuts column. NULL = he has not looked at this row
  // yet, 0 = he looked and said none; both route to no sink. Equal to quantity
  // means all of them. See scripts/0043-fab-requirement-sink-quantity.sql and
  // resolveSinkQuantity() in src/lib/fab/requirement-derive.ts.
  sinkQuantity        Int?                       @map("sink_quantity")
  sinkModel           String?                    @map("sink_model")
  sinkCuts            Int?                       @default(0) @map("sink_cuts")
  faucetCount         Int?                       @default(0) @map("faucet_count")
  depLength           Float?                     @map("dep_length")
  jointCount          Int?                       @default(0) @map("joint_count")
  jointDepLength      Float?                     @map("joint_dep_length")
  radiusCorners       Int?                       @default(0) @map("radius_corners")
  sqftPerPiece        Float?                     @map("sqft_per_piece")
  totalSqft           Float?                     @map("total_sqft")
  notes               String?
  status              FabRequirementStatus       @default(PENDING)
  createdAt           DateTime                   @default(now()) @map("created_at")
  pieces              FabPiece[]
  allocations         FabRequirementAllocation[]

  /// The PO detail screen reads every requirement of one PO. Postgres does
  /// not index a foreign key for you, and without this the lookup is a
  /// sequential scan of every requirement in the system.
  @@index([poId])
  /// Both supervisor boards, and release-project, read every requirement of
  /// one project. See scripts/0045.
  @@index([projectId])
  @@map("fab_requirement")
}

model FabRequirementAllocation {
  id                String         @id @default(cuid())
  requirementId     String         @map("requirement_id")
  requirement       FabRequirement @relation(fields: [requirementId], references: [id])
  slabId            String         @map("slab_id")
  slab              FabSlab        @relation(fields: [slabId], references: [id])
  allocatedQuantity Int            @map("allocated_quantity")
  createdAt         DateTime       @default(now()) @map("created_at")

  /// "Everything this piece row is allocated to, across slabs" — the sum the
  /// no-over-allocation rule is checked against, re-read inside a transaction
  /// on every assignment. See scripts/0045.
  @@index([requirementId])
  /// "The rows on this slab" — the slab cards and the loss recomputation in
  /// approve-slab.
  @@index([slabId])
  @@map("fab_requirement_allocation")
}

model FabPiece {
  id                   String              @id @default(cuid())
  pieceCode            String              @unique @map("piece_code")
  projectId            String              @map("project_id")
  project              FabProject          @relation(fields: [projectId], references: [id])
  slabId               String?             @map("slab_id")
  slab                 FabSlab?            @relation(fields: [slabId], references: [id])
  drawingId            String?             @map("drawing_id")
  drawing              FabDrawing?         @relation(fields: [drawingId], references: [id])
  requirementId        String?             @map("requirement_id")
  requirement          FabRequirement?     @relation(fields: [requirementId], references: [id])
  shapeType            FabShapeType?       @map("shape_type")
  length               Float?
  width                Float?
  remarks              String?
  hasSink              Boolean             @default(false) @map("has_sink")
  polishRequired       Boolean             @default(false) @map("polish_required")
  fabricationRequired  Boolean             @default(false) @map("fabrication_required")
  polishingCompleted   Boolean             @default(false) @map("polishing_completed")
  sinkCompleted        Boolean             @default(false) @map("sink_completed")
  fabricationCompleted Boolean             @default(false) @map("fabrication_completed")
  status               FabPieceStatus      @default(PENDING)
  createdAt            DateTime            @default(now()) @map("created_at")
  operations           FabOperation[]
  pieceOperations      FabPieceOperation[]
  allocations          FabSlabAllocation[]
  packagePieces        FabPackagePiece[]
  rejectedAt           DateTime?           @map("rejected_at")
  rejectReason         String?             @map("reject_reason")
  rejectNotes          String?             @map("reject_notes")
  rejectedByWorkerId   String?             @map("rejected_by_worker_id")

  @@map("fab_piece")
}

model FabSlabAllocation {
  id            String   @id @default(cuid())
  pieceId       String   @map("piece_id")
  piece         FabPiece @relation(fields: [pieceId], references: [id])
  slabId        String   @map("slab_id")
  slab          FabSlab  @relation(fields: [slabId], references: [id])
  allocatedArea Float?   @map("allocated_area")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("fab_slab_allocation")
}

model FabOperation {
  id              String              @id @default(cuid())
  pieceId         String              @map("piece_id")
  piece           FabPiece            @relation(fields: [pieceId], references: [id])
  machineId       String?             @map("machine_id")
  machine         FabMachine?         @relation(fields: [machineId], references: [id])
  operatorId      String              @map("operator_id")
  operator        User                @relation(fields: [operatorId], references: [id])
  workerId        String?             @map("worker_id")
  worker          FabWorker?          @relation(fields: [workerId], references: [id])
  shift           String?
  operationType   FabOperationType    @map("operation_type")
  pieceOperations FabPieceOperation[]
  startTime       DateTime?           @map("start_time")
  endTime         DateTime?           @map("end_time")
  remarks         String?
  status          FabOperationStatus  @default(IN_PROGRESS)
  createdAt       DateTime            @default(now()) @map("created_at")

  @@map("fab_operation")
}

model FabPieceOperation {
  id            String           @id @default(cuid())
  pieceId       String           @map("piece_id")
  piece         FabPiece         @relation(fields: [pieceId], references: [id])
  operationType FabOperationType @map("operation_type")
  sequence      Int
  isRequired    Boolean          @default(true) @map("is_required")
  isCompleted   Boolean          @default(false) @map("is_completed")
  startedAt     DateTime?        @map("started_at")
  completedAt   DateTime?        @map("completed_at")
  operationId   String?          @map("operation_id")
  operation     FabOperation?    @relation(fields: [operationId], references: [id])
  createdAt     DateTime         @default(now()) @map("created_at")

  /// "What was finished between these two dates?" — the CEO dashboard's
  /// single-day strip, its date-wise stage breakdown (up to 92 days, grouped
  /// in the database) and its 30-minute idle window all ask exactly this, and
  /// the table carried no index at all until now. See scripts/0046.
  @@index([isCompleted, completedAt])
  @@map("fab_piece_operation")
}

model FabPackage {
  id          String            @id @default(cuid())
  packageCode String            @unique @map("package_code")
  remarks     String?
  createdAt   DateTime          @default(now()) @map("created_at")
  pieces      FabPackagePiece[]
  dispatches  FabDispatch[]

  @@map("fab_package")
}

model FabPackagePiece {
  id        String     @id @default(cuid())
  packageId String     @map("package_id")
  package   FabPackage @relation(fields: [packageId], references: [id])
  pieceId   String     @map("piece_id")
  piece     FabPiece   @relation(fields: [pieceId], references: [id])
  createdAt DateTime   @default(now()) @map("created_at")

  @@map("fab_package_piece")
}

model FabDispatch {
  id            String     @id @default(cuid())
  packageId     String     @map("package_id")
  package       FabPackage @relation(fields: [packageId], references: [id])
  vehicleNumber String?    @map("vehicle_number")
  driverName    String?    @map("driver_name")
  destination   String?
  dispatchDate  DateTime   @map("dispatch_date")
  remarks       String?
  createdAt     DateTime   @default(now()) @map("created_at")

  @@map("fab_dispatch")
}

model FabResidualBag {
  id        String             @id @default(cuid())
  bagCode   String             @unique @map("bag_code")
  slabId    String             @map("slab_id")
  slab      FabSlab            @relation(fields: [slabId], references: [id])
  rack      String?
  remarks   String?
  createdAt DateTime           @default(now()) @map("created_at")
  pieces    FabResidualPiece[]

  @@map("fab_residual_bag")
}

model FabResidualPiece {
  id        String         @id @default(cuid())
  bagId     String         @map("bag_id")
  bag       FabResidualBag @relation(fields: [bagId], references: [id])
  length    Float
  width     Float
  quantity  Int
  area      Float
  reusable  Boolean        @default(true)
  remarks   String?
  createdAt DateTime       @default(now()) @map("created_at")

  @@map("fab_residual_piece")
}

// ============================================================================
// Finished-Goods Inventory  (native, fg_*).  QC (polish_qc) autolinks into this.
// Design: docs/finished-goods-inventory-design.md
// NOTE: slabNumber is Float to match polish_qc + accommodate valid ".1" insert
// slabs; integer-only enforcement (if wanted) is applied at the app layer,
// pending the user's final decision on decimal slabs.
// ============================================================================

enum SlabStatus {
  AVAILABLE
  RESERVED
  PACKED
  DISPATCHED
  RETURNED
  CTS // cut to size - committed to cutting, still physically in stock
}

enum SlabSource {
  QC_AUTOLINK
  BULK_UPLOAD
}

model FinishedSlab {
  id         String @id @default(cuid())
  slabNumber Float  @unique @map("slab_number")

  // ---- QC-owned: overwritten each time the slab passes QC ----
  design         String?   @map("design")
  grade          String?   @map("grade") // A / A2 / B / C / CTS / Printing (exclusive)
  slabThickness  String?   @map("slab_thickness")
  qualityIssue   String[]  @default([]) @map("quality_issue") // mirrored from PolishQc each QC pass
  polishType     String?   @map("polish_type") // Polish / Suede / Honed / Leathered
  rwStatus       String?   @map("rw_status")
  repolishStatus String?   @map("repolish_status")
  batchNumber    String?   @map("batch_number")
  batchKey       String?   @map("batch_key")
  barcode        String?   @map("barcode")
  qcInspector    String?   @map("qc_inspector")
  lastQcAt       DateTime? @map("last_qc_at")
  lengthIn       Float?    @default(137) @map("length_in") // default full slab 137" x 79"
  widthIn        Float?    @default(79) @map("width_in") // sqft = L*W/144, sqm = sqft*0.092903 (derived)

  // ---- Location: Bay set at QC, Frame set by Dispatch (cleared on re-QC) ----
  bayNumber   String? @map("bay_number")
  frameNumber String? @map("frame_number")

  // ---- Inventory-owned: never overwritten by QC ----
  status               SlabStatus @default(AVAILABLE) @map("status")
  reservedForPi        String?    @map("reserved_for_pi")
  customer             String?    @map("customer")
  reservedAt           DateTime?  @map("reserved_at")
  reservationExpiresAt DateTime?  @map("reservation_expires_at")
  notes                String?    @map("notes")

  // ---- Provenance / stock-age ----
  source      SlabSource @default(QC_AUTOLINK) @map("source")
  firstSeenAt DateTime   @default(now()) @map("first_seen_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  events SlabEvent[]

  @@index([batchKey])
  @@index([status])
  @@index([grade])
  @@index([design])
  @@map("fg_finished_slab")
}

model DesignAlias {
  id        String   @id @default(cuid())
  variant   String   @unique @map("variant")
  canonical String   @map("canonical")
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([canonical])
  @@map("fg_design_alias")
}

model SlabEvent {
  id         String       @id @default(cuid())
  slabNumber Float        @map("slab_number")
  slab       FinishedSlab @relation(fields: [slabNumber], references: [slabNumber])
  kind       String       @map("kind") // created | qc_update | location | status | reserve | pack | dispatch | return | flagged_non_integer
  field      String?      @map("field")
  oldValue   String?      @map("old_value")
  newValue   String?      @map("new_value")
  changedBy  String?      @map("changed_by")
  source     String?      @map("source")
  at         DateTime     @default(now()) @map("at")

  @@index([slabNumber])
  @@index([at])
  @@map("fg_slab_event")
}

/// The dispatch invoice file uploaded when slabs leave the yard (inventory
/// dispatch flow) — bytea in Postgres, Vercel has no disk. `slab_numbers`
/// pins which slabs the file covered at upload time. Ids are minted in the
/// route ("inv..."); access stays raw SQL.
model DispatchInvoice {
  id           String   @id
  pi           String?  @map("pi")
  customer     String?  @map("customer")
  filename     String   @map("filename")
  mime         String   @map("mime")
  data         Bytes    @map("data")
  slabNumbers  Float[]  @map("slab_numbers")
  dispatchedBy String?  @map("dispatched_by")
  at           DateTime @default(now()) @map("at") @db.Timestamptz(6)

  @@map("fg_dispatch_invoice")
}

/// A batch ticked "approved for Sales" on the inventory approval screen:
/// a row here puts the batch in the register + Sales view; deleting it sends
/// the batch back to PENDING. Upserted raw with ON CONFLICT (design, batch).
model SalesApprovedBatch {
  design     String   @map("design")
  batch      String   @default("") @map("batch")
  approvedBy String?  @map("approved_by")
  at         DateTime @default(now()) @map("at") @db.Timestamptz(6)

  @@id([design, batch])
  @@map("fg_sales_approved_batch")
}

/// A design hidden from the Sales inventory view (design-level master switch,
/// incl. __TRIALS__). batch is '' rather than NULL so the composite PK can
/// hold — Postgres treats NULLs as distinct.
model SalesHiddenDesign {
  design   String   @map("design")
  hiddenBy String?  @map("hidden_by")
  at       DateTime @default(now()) @map("at") @db.Timestamptz(6)
  batch    String   @default("") @map("batch")

  @@id([design, batch])
  @@map("fg_sales_hidden_design")
}

// ==========================================
// Consumables module (ported from the standalone consumables dashboard).
// Native ERP tables — NOT generated from Airtable; preserve across regens.
// Columns stay camelCase (module convention) so ported raw-SQL chart
// queries only needed TABLE-name changes; tables namespaced consumable_*.
// ==========================================

model ConsumableDepartment {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  productionConsumables ProductionConsumable[]
  polishingConsumables  PolishingConsumable[]
  consumptionEntries    ConsumptionEntry[]

  @@map("consumable_department")
}

model DirectMaterial {
  id               String               @id @default(cuid())
  name             String
  variant          String?
  unit             String
  dailyConsumption Float                @default(0)
  status           DirectMaterialStatus @default(ACTIVE)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@map("consumable_direct_material")
}

enum DirectMaterialStatus {
  ACTIVE
  INACTIVE
}

model ProductionConsumable {
  id               String   @id @default(cuid())
  name             String
  unit             String
  dailyConsumption Float    @default(0)
  currentStock     Float    @default(0)
  minStock         Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  departmentId String
  department   ConsumableDepartment @relation(fields: [departmentId], references: [id])

  @@map("consumable_production")
}

model PolishingConsumable {
  id               String   @id @default(cuid())
  name             String
  unit             String   @default("PCS")
  dailyConsumption Float    @default(0)
  currentStock     Float    @default(0)
  minStock         Float    @default(0)
  createdAt        DateTime @default(now())

  departmentId String
  department   ConsumableDepartment @relation(fields: [departmentId], references: [id])

  @@map("consumable_polishing")
}

model InventoryStock {
  id           String       @id @default(cuid())
  itemName     String
  category     ItemCategory
  unit         String
  currentStock Float        @default(0)
  minStock     Float        @default(0)
  maxStock     Float        @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  inventoryEntries   InventoryEntry[]
  consumptionEntries ConsumptionEntry[]

  @@map("consumable_inventory_stock")
}

enum ItemCategory {
  DIRECT_MATERIAL
  PRODUCTION_CONSUMABLE
  POLISHING_CONSUMABLE
}

model FilmRoll {
  id             String   @id @default(cuid())
  rollNumber     String   @unique
  filmType       String
  machine        String
  initialWeight  Float
  layersUsed     Int      @default(0)
  weightPerLayer Float
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("consumable_film_roll")
}

model ConsumptionEntry {
  id       String   @id @default(cuid())
  date     DateTime @default(now())
  itemName String
  quantity Float
  unit     String
  remarks  String?

  departmentId String
  department   ConsumableDepartment @relation(fields: [departmentId], references: [id])

  inventoryStockId String?
  inventoryStock   InventoryStock? @relation(fields: [inventoryStockId], references: [id])

  createdAt DateTime @default(now())

  @@map("consumable_consumption_entry")
}

model InventoryEntry {
  id       String   @id @default(cuid())
  date     DateTime @default(now())
  quantity Float
  unit     String

  inventoryStockId String
  inventoryStock   InventoryStock @relation(fields: [inventoryStockId], references: [id])

  createdAt DateTime @default(now())

  @@map("consumable_inventory_entry")
}

// ============================================================================
// International Sales module (ported from Shalman's fork). Native ERP tables —
// preserve across regens.
//
// Porting notes (Phase 1):
//  - The fork attached hard relations to User (sp/manager/createdBy/checkedBy/
//    user). Our core User model is untouched: those are plain String id
//    columns here (commented "-> users.id"), resolved in app code.
//  - PRODUCTION_MANAGER (fork SalesRole) is intentionally NOT ported; those
//    checks map to ADMIN in Phase 2. users.sales_role / users.sales_factory
//    columns are also deferred to Phase 2.
//  - proforma_invoices.payment_terms_data, sales_payment_divisions
//    (extended_due_date/overridden_*/override_note/reminders_sent),
//    sales_shipment_docs extras and sales_config.invoice_config_* are
//    raw-SQL-only columns (kept out of Prisma client by the fork to avoid
//    P2022); they exist in scripts/0019-international-sales-tables.sql only,
//    as does the model-less sales_notifications table.
// ============================================================================

enum SalesOrderStatus {
  DRAFT
  PENDING_PAYMENT
  PENDING_STOCK_CHECK
  STOCK_CONFIRMED
  PENDING_PRODUCTION
  IN_PRODUCTION
  PACKING
  DISPATCHED
  IN_TRANSIT
  PORT_ARRIVED
  DELIVERED
  CANCELLED
}

enum PIStatus {
  DRAFT
  SENT
  UNDER_REVISION
  REJECTED
  ACCEPTED
}

enum ProductType {
  QUARTZ
  GRANITE
}

enum PaymentDivisionType {
  ADVANCE
  CAD
  INSPECTION
  RECEIVE_TO_PAY
  BL_TO_PAY
  CREDIT
}

enum PaymentDivisionStatus {
  PENDING
  PAID
  OVERDUE
}

enum SalesProductionJobStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum SalesProductionType {
  SLAB
  FAB
}

enum PackingListStatus {
  PENDING_SEND
  SENT
  ACCEPTED
  REJECTED
}

enum StockCheckStatus {
  PENDING
  AVAILABLE
  UNAVAILABLE
  PARTIAL
}

enum PortDeliveryStatus {
  PENDING
  CLEARED
  OVERRIDE
  DELIVERED
}

enum CreditNoteStatus {
  PENDING_INSPECTION
  INSPECTED
  ISSUED
  REJECTED
}

model SalesManagerAssignment {
  id         String   @id @default(cuid())
  spId       String   @map("sp_id") // -> users.id (no hard FK; core User untouched)
  managerId  String   @map("manager_id") // -> users.id (no hard FK)
  isActive   Boolean  @default(true) @map("is_active")
  assignedAt DateTime @default(now()) @map("assigned_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  note       String?

  @@map("sales_manager_assignments")
}

model SalesClient {
  id       String  @id @default(cuid())
  name     String
  email    String?
  isActive Boolean @default(true) @map("is_active")

  phone         String?
  address       String?
  city          String? // 0025 — applied before this model change deployed
  country       String
  contactPerson String? @map("contact_person")
  createdById   String  @map("created_by_id") // -> users.id (no hard FK)

  defaultCurrency        String?  @map("default_currency")
  defaultUnit            String?  @map("default_unit")
  defaultPortOfDischarge String?  @map("default_port_of_discharge")
  defaultDeliveryTerms   String?  @map("default_delivery_terms")
  defaultPaymentTerms    String?  @map("default_payment_terms")
  ccEmails               String[] @map("cc_emails")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  proformaInvoices ProformaInvoice[]
  orders           SalesOrder[]

  @@map("sales_clients")
}

model ProformaInvoice {
  id             String      @id @default(cuid())
  piNumber       String      @unique @map("pi_number")
  spId           String      @map("sp_id") // -> users.id (no hard FK)
  clientId       String      @map("client_id")
  orderId        String?     @map("order_id")
  status         PIStatus    @default(DRAFT)
  productType    ProductType @default(QUARTZ) @map("product_type")
  rejectionCount Int         @default(0) @map("rejection_count")
  revisionCount  Int         @default(0) @map("revision_count")

  items               Json
  totalAmount         Float   @map("total_amount")
  currency            String  @default("USD")
  deliveryTerms       String? @map("delivery_terms")
  paymentTermsSummary String? @map("payment_terms_summary")
  // paymentTermsData stored in payment_terms_data column (raw SQL only — not in Prisma client to avoid P2022)
  notes               String?
  validityDays        Int?    @map("validity_days")

  // Shipping / consignee fields
  buyerPoNo            String?   @map("buyer_po_no")
  deliveryDate         DateTime? @map("delivery_date")
  consigneeDetails     String?   @map("consignee_details")
  notifyPartyDetails   String?   @map("notify_party_details")
  buyerIfNotConsignee  String?   @map("buyer_if_not_consignee")
  countryOfDestination String?   @map("country_of_destination")
  preCarriageBy        String?   @default("By Road") @map("pre_carriage_by")
  placeOfReceipt       String?   @map("place_of_receipt")
  portOfLoading        String?   @default("Chennai Port") @map("port_of_loading")
  portOfDischarge      String?   @map("port_of_discharge")
  finalDestination     String?   @map("final_destination")
  grossWeight          Float?    @map("gross_weight")
  netWeight            Float?    @map("net_weight")
  discountAmount       Float?    @default(0) @map("discount_amount")

  sentAt     DateTime? @map("sent_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  client           SalesClient      @relation(fields: [clientId], references: [id])
  order            SalesOrder?      @relation(fields: [orderId], references: [id])
  rejectionLogs    PIRejectionLog[]
  revisions        PIRevision[]
  /// Present in the live database but not previously modelled here, so
  /// `prisma db push` proposed DROPping it WITH ITS DATA. Modelled
  /// 2026-08-12 to reconcile that drift — nullable, exactly as the column
  /// already is, so this describes the database rather than changing it.
  paymentTermsData Json?            @map("payment_terms_data")

  @@map("proforma_invoices")
}

model PIRevision {
  id              String    @id @default(cuid())
  piId            String    @map("pi_id")
  revisionNo      Int       @map("revision_no")
  reason          String? // SP's note on what changed
  customerRemarks String?   @map("customer_remarks")
  createdById     String    @map("created_by_id") // -> users.id (no hard FK)
  sentAt          DateTime? @map("sent_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  pi ProformaInvoice @relation(fields: [piId], references: [id])

  @@map("pi_revisions")
}

model PIRejectionLog {
  id         String   @id @default(cuid())
  piId       String   @map("pi_id")
  reason     String?
  rejectedAt DateTime @default(now()) @map("rejected_at")

  pi ProformaInvoice @relation(fields: [piId], references: [id])

  @@map("pi_rejection_logs")
}

model SalesOrder {
  id            String           @id @default(cuid())
  orderNumber   String           @unique @map("order_number")
  clientId      String           @map("client_id")
  spId          String           @map("sp_id") // -> users.id (no hard FK)
  status        SalesOrderStatus @default(PENDING_PAYMENT)
  totalAmount   Float?           @map("total_amount")
  currency      String?          @default("USD")
  deliveryTerms String?          @map("delivery_terms")
  notes         String?
  invoiceNumber String?          @unique @map("invoice_number") // PESPL/XXXX format
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  client           SalesClient            @relation(fields: [clientId], references: [id])
  proformaInvoices ProformaInvoice[]
  paymentTerms     SalesPaymentTerms?
  paymentDivisions SalesPaymentDivision[]
  stockCheck       SalesStockCheck?
  productionJob    SalesProductionJob?
  packages         SalesPackage[]
  packingList      SalesPackingList?
  container        SalesContainer?
  shipmentDocs     SalesShipmentDocs?
  portArrival      SalesPortArrival?
  logs             SalesOrderLog[]
  adminAlerts      SalesAdminAlert[]
  creditNotes      SalesCreditNote[]

  @@map("sales_orders")
}

model SalesPaymentTerms {
  id      String @id @default(cuid())
  orderId String @unique @map("order_id")

  advancePct Float @default(0) @map("advance_pct")
  cadPct     Float @default(0) @map("cad_pct")

  inspectionPct  Float @default(0) @map("inspection_pct")
  inspectionDays Int?  @map("inspection_days")

  receiveToPayPct  Float @default(0) @map("receive_to_pay_pct")
  receiveToPayDays Int?  @map("receive_to_pay_days")

  blToPayPct  Float @default(0) @map("bl_to_pay_pct")
  blToPayDays Int?  @map("bl_to_pay_days")

  creditPct  Float @default(0) @map("credit_pct")
  creditDays Int?  @map("credit_days")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order            SalesOrder             @relation(fields: [orderId], references: [id])
  paymentDivisions SalesPaymentDivision[]

  @@map("sales_payment_terms")
}

model SalesPaymentDivision {
  id           String                @id @default(cuid())
  orderId      String                @map("order_id")
  termsId      String?               @map("terms_id")
  type         PaymentDivisionType
  percentage   Float
  amount       Float
  deadlineDays Int?                  @map("deadline_days")
  dueDate      DateTime?             @map("due_date")
  paidAt       DateTime?             @map("paid_at")
  status       PaymentDivisionStatus @default(PENDING)
  notes        String?
  // extended_due_date / overridden_at / overridden_by_id / override_note /
  // reminders_sent live in the table for raw SQL only (see 0019 SQL)
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  order           SalesOrder         @relation(fields: [orderId], references: [id])
  terms           SalesPaymentTerms? @relation(fields: [termsId], references: [id])
  /// Present in the live database but not previously modelled here, so
  /// `prisma db push` proposed DROPping it WITH ITS DATA. Modelled
  /// 2026-08-12 to reconcile that drift — nullable, exactly as the column
  /// already is, so this describes the database rather than changing it.
  amountReceived  Float?             @map("amount_received")
  /// In the live database but not modelled here, so `prisma db push`
  /// proposed DROPping it WITH ITS DATA. Added 2026-08-12 to reconcile
  /// that drift: each line describes the column as it already exists —
  /// same type, same nullability, same default — so the schema now
  /// matches the database instead of asking to change it.
  extendedDueDate DateTime?          @map("extended_due_date") @db.Timestamptz
  overriddenAt    DateTime?          @map("overridden_at") @db.Timestamptz
  overriddenById  String?            @map("overridden_by_id")
  overrideNote    String?            @map("override_note")
  remindersSent   Json               @default("[]") @map("reminders_sent")

  @@map("sales_payment_divisions")
}

model SalesStockCheck {
