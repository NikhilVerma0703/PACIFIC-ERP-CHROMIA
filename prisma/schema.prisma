  vesselName         String?   @map("vessel_name")
  portOfLoading      String?   @map("port_of_loading")
  portOfDischarge    String?   @map("port_of_discharge")
  etaDate            DateTime? @map("eta_date")
  etdDate            DateTime? @map("etd_date")
  linerOtlNo         String?   @map("liner_otl_no")
  eSealNo            String?   @map("e_seal_no")
  vehicleNo          String?   @map("vehicle_no")
  trackingLink       String?   @map("tracking_link")
  packageDescription String?   @map("package_description") // e.g. "08 Wooden Crate(S) + 03 Sample Box"

  // Weight (MT)
