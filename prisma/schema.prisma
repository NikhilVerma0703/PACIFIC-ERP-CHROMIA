}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OPERATOR
  INCHARGE
  LINE_MANAGER
  ADMIN
  FINANCE
  ACCOUNTS
  SALES
  COMMERCIAL
  STORE
  MAINTENANCE
  ROBO
}

enum Station {
  PRESS
  OVEN
  JOT
  MIXER
  KREOS
  DISTRIBUTOR
  SILO
  POLISH_QC
  POLISH_ENTRY
  CUTTING
}

enum Branch {
  SHOP_FLOOR
  OFFICE
  FABRICATION
