  actions   Json     @default("[]")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, isRead, createdAt(sort: Desc)], map: "idx_sales_notifications_user")
  @@map("sales_notifications")
}

// ============================================================================
// ROBO MODULE — Robo production line (merged from ROBO_MODULE standalone app).
// Models are Robo-prefixed to keep them clearly namespaced from the Airtable-
// generated tables above. Hand-maintained; NOT touched by gen-schema.py.
// ============================================================================

model RoboMachine {
