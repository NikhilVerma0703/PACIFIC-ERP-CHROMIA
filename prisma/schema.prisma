// ============================================================================
// International Sales module (ported from Shalman's fork). Native ERP tables —
// preserve across regens.
//
// Porting notes (Phase 1):
//  - The fork attached hard relations to User (sp/manager/createdBy/checkedBy/
//    user). Our core User model is untouched: those are plain String id
//    columns here (commented "-> users.id"), resolved in app code.
//  - PRODUCTION_MANAGER (fork SalesRole) is intentionally NOT ported; those
//    checks map to ADMIN in Phase 2. users.sales_role / users.sales_factory
//    columns are also deferred to Phase 2.
//  - proforma_invoices.payment_terms_data, sales_payment_divisions
//    (extended_due_date/overridden_*/override_note/reminders_sent),
//    sales_shipment_docs extras and sales_config.invoice_config_* are
//    raw-SQL-only columns (kept out of Prisma client by the fork to avoid
//    P2022); they exist in scripts/0019-international-sales-tables.sql only,
//    as does the model-less sales_notifications table.
// ============================================================================

enum SalesOrderStatus {
  DRAFT
  PENDING_PAYMENT
  PENDING_STOCK_CHECK
  STOCK_CONFIRMED
  PENDING_PRODUCTION
  IN_PRODUCTION
  PACKING
  DISPATCHED
  IN_TRANSIT
  PORT_ARRIVED
  DELIVERED
  CANCELLED
}

enum PIStatus {
  DRAFT
  SENT
  UNDER_REVISION
  REJECTED
  ACCEPTED
}

enum ProductType {
  QUARTZ
  GRANITE
}

enum PaymentDivisionType {
  ADVANCE
  CAD
  INSPECTION
  RECEIVE_TO_PAY
  BL_TO_PAY
  CREDIT
}

enum PaymentDivisionStatus {
  PENDING
  PAID
  OVERDUE
}

enum SalesProductionJobStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum SalesProductionType {
  SLAB
  FAB
}

enum PackingListStatus {
  PENDING_SEND
  SENT
  ACCEPTED
  REJECTED
}

enum StockCheckStatus {
  PENDING
  AVAILABLE
  UNAVAILABLE
  PARTIAL
}

enum PortDeliveryStatus {
  PENDING
  CLEARED
  OVERRIDE
  DELIVERED
}

enum CreditNoteStatus {
  PENDING_INSPECTION
  INSPECTED
  ISSUED
  REJECTED
}

model SalesManagerAssignment {
  id         String   @id @default(cuid())
  spId       String   @map("sp_id") // -> users.id (no hard FK; core User untouched)
  managerId  String   @map("manager_id") // -> users.id (no hard FK)
  isActive   Boolean  @default(true) @map("is_active")
  assignedAt DateTime @default(now()) @map("assigned_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  note       String?

  @@map("sales_manager_assignments")
}

model SalesClient {
  id       String  @id @default(cuid())
  name     String
  email    String?
  isActive Boolean @default(true) @map("is_active")

  phone         String?
  address       String?
  city          String? // 0025 — applied before this model change deployed
  country       String
  contactPerson String? @map("contact_person")
  createdById   String  @map("created_by_id") // -> users.id (no hard FK)

  defaultCurrency        String?  @map("default_currency")
  defaultUnit            String?  @map("default_unit")
  defaultPortOfDischarge String?  @map("default_port_of_discharge")
  defaultDeliveryTerms   String?  @map("default_delivery_terms")
  defaultPaymentTerms    String?  @map("default_payment_terms")
  ccEmails               String[] @map("cc_emails")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  proformaInvoices ProformaInvoice[]
  orders           SalesOrder[]

  @@map("sales_clients")
}

model ProformaInvoice {
  id             String      @id @default(cuid())
  piNumber       String      @unique @map("pi_number")
  spId           String      @map("sp_id") // -> users.id (no hard FK)
  clientId       String      @map("client_id")
  orderId        String?     @map("order_id")
  status         PIStatus    @default(DRAFT)
  productType    ProductType @default(QUARTZ) @map("product_type")
  rejectionCount Int         @default(0) @map("rejection_count")
  revisionCount  Int         @default(0) @map("revision_count")

  items               Json
  totalAmount         Float   @map("total_amount")
  currency            String  @default("USD")
  deliveryTerms       String? @map("delivery_terms")
  paymentTermsSummary String? @map("payment_terms_summary")
  // paymentTermsData stored in payment_terms_data column (raw SQL only — not in Prisma client to avoid P2022)
  notes               String?
  validityDays        Int?    @map("validity_days")

  // Shipping / consignee fields
  buyerPoNo            String?   @map("buyer_po_no")
  deliveryDate         DateTime? @map("delivery_date")
  consigneeDetails     String?   @map("consignee_details")
  notifyPartyDetails   String?   @map("notify_party_details")
  buyerIfNotConsignee  String?   @map("buyer_if_not_consignee")
  countryOfDestination String?   @map("country_of_destination")
  preCarriageBy        String?   @default("By Road") @map("pre_carriage_by")
  placeOfReceipt       String?   @map("place_of_receipt")
  portOfLoading        String?   @default("Chennai Port") @map("port_of_loading")
  portOfDischarge      String?   @map("port_of_discharge")
  finalDestination     String?   @map("final_destination")
  grossWeight          Float?    @map("gross_weight")
  netWeight            Float?    @map("net_weight")
  discountAmount       Float?    @default(0) @map("discount_amount")

  sentAt     DateTime? @map("sent_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  client        SalesClient      @relation(fields: [clientId], references: [id])
  order         SalesOrder?      @relation(fields: [orderId], references: [id])
  rejectionLogs PIRejectionLog[]
  revisions     PIRevision[]

  @@map("proforma_invoices")
}

model PIRevision {
  id              String    @id @default(cuid())
  piId            String    @map("pi_id")
  revisionNo      Int       @map("revision_no")
  reason          String? // SP's note on what changed
  customerRemarks String?   @map("customer_remarks")
  createdById     String    @map("created_by_id") // -> users.id (no hard FK)
  sentAt          DateTime? @map("sent_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  pi ProformaInvoice @relation(fields: [piId], references: [id])

  @@map("pi_revisions")
}

model PIRejectionLog {
  id         String   @id @default(cuid())
  piId       String   @map("pi_id")
  reason     String?
  rejectedAt DateTime @default(now()) @map("rejected_at")

  pi ProformaInvoice @relation(fields: [piId], references: [id])

  @@map("pi_rejection_logs")
}

model SalesOrder {
  id            String           @id @default(cuid())
  orderNumber   String           @unique @map("order_number")
  clientId      String           @map("client_id")
  spId          String           @map("sp_id") // -> users.id (no hard FK)
  status        SalesOrderStatus @default(PENDING_PAYMENT)
  totalAmount   Float?           @map("total_amount")
  currency      String?          @default("USD")
  deliveryTerms String?          @map("delivery_terms")
  notes         String?
  invoiceNumber String?          @unique @map("invoice_number") // PESPL/XXXX format
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  client           SalesClient            @relation(fields: [clientId], references: [id])
  proformaInvoices ProformaInvoice[]
  paymentTerms     SalesPaymentTerms?
  paymentDivisions SalesPaymentDivision[]
  stockCheck       SalesStockCheck?
  productionJob    SalesProductionJob?
  packages         SalesPackage[]
  packingList      SalesPackingList?
  container        SalesContainer?
  shipmentDocs     SalesShipmentDocs?
  portArrival      SalesPortArrival?
  logs             SalesOrderLog[]
  adminAlerts      SalesAdminAlert[]
  creditNotes      SalesCreditNote[]

  @@map("sales_orders")
}

model SalesPaymentTerms {
  id      String @id @default(cuid())
  orderId String @unique @map("order_id")

  advancePct Float @default(0) @map("advance_pct")
  cadPct     Float @default(0) @map("cad_pct")

  inspectionPct  Float @default(0) @map("inspection_pct")
  inspectionDays Int?  @map("inspection_days")

  receiveToPayPct  Float @default(0) @map("receive_to_pay_pct")
  receiveToPayDays Int?  @map("receive_to_pay_days")

  blToPayPct  Float @default(0) @map("bl_to_pay_pct")
  blToPayDays Int?  @map("bl_to_pay_days")

  creditPct  Float @default(0) @map("credit_pct")
  creditDays Int?  @map("credit_days")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order            SalesOrder             @relation(fields: [orderId], references: [id])
  paymentDivisions SalesPaymentDivision[]

  @@map("sales_payment_terms")
