}

model RoboShift {
  id                String                 @id @default(cuid())
  date              String
  shiftNumber       Int
  startTime         String
  endTime           String?
  status            String                 @default("ACTIVE")
  operatorName      String                 @default("")
  notes             String?
  // Fixed cycle times for Roycuts (set once per shift — applies to all slabs)
  roycut1CycleTime  Int?
  roycut2CycleTime  Int?
  roycut3CycleTime  Int?
  createdAt         DateTime               @default(now())
  batchRecipes      RoboBatchRecipe[]
  productionRecords RoboProductionRecord[]
  delayLogs         RoboDelayLog[]
}

model RoboBatchRecipe {
  id                String                 @id @default(cuid())
  shiftId           String
  shift             RoboShift              @relation(fields: [shiftId], references: [id])
  designId          String?
  design            RoboDesign?            @relation(fields: [designId], references: [id])
  programId         String?
  program           RoboProgram?           @relation(fields: [programId], references: [id])
  designName        String                 @default("")
  programName       String                 @default("")
  targetSlabs       Int?
  thickness         Float?
  notes             String?
  createdAt         DateTime               @default(now())
  entries           RoboBatchRecipeEntry[]
  productionRecords RoboProductionRecord[]
}

model RoboBatchRecipeEntry {
  id              String          @id @default(cuid())
  batchRecipeId   String
  batchRecipe     RoboBatchRecipe @relation(fields: [batchRecipeId], references: [id])
  machineId       String
  machine         RoboMachine     @relation(fields: [machineId], references: [id])
  programName     String? // Program name for this specific machine
  toolName        String?
  liquidName      String?
  powderName      String?
  rollerHeight    String?
  targetCycleTime Int? // Target cycle time in seconds (fixed for production run)
  notes           String?

  @@unique([batchRecipeId, machineId])
}

model RoboProductionRecord {
  id               String           @id @default(cuid())
  serialNumber     Int?
  slabNumber       String
  shiftId          String
  shift            RoboShift        @relation(fields: [shiftId], references: [id])
  batchRecipeId    String?
  batchRecipe      RoboBatchRecipe? @relation(fields: [batchRecipeId], references: [id])
  inTime           String?
  outTime          String?
  roymixCycleTime  Int? // RoyMix cycle time in seconds (varies per slab)
  roymixBodyWeight Float? // RoyMix body weight in kg (recorded per slab)
  thickness        Float?
  status           String           @default("COMPLETED")
  remarks          String?
  createdAt        DateTime         @default(now())
  delayLogs        RoboDelayLog[]
}

model RoboDelayLog {
  id                 String                @id @default(cuid())
  shiftId            String
  shift              RoboShift             @relation(fields: [shiftId], references: [id])
  productionRecordId String?
  productionRecord   RoboProductionRecord? @relation(fields: [productionRecordId], references: [id])
  machineId          String?
  machine            RoboMachine?          @relation(fields: [machineId], references: [id])
  machineName        String?
  delayCodeId        String
  delayCode          RoboDelayCode         @relation(fields: [delayCodeId], references: [id])
  durationMinutes    Int
  startTime          String?
  endTime            String?
  remarks            String?
  createdAt          DateTime              @default(now())
}

/// One bulk import of a production register workbook (ROBO_MODULE upstream's
/// ImportLog, namespaced). No relations on purpose - it is a journal, and the
/// rows it describes survive it.
model RoboImportLog {
  id        String   @id @default(cuid())
  fileName  String
  period    String?
  status    String   @default("failed")
  totalRows Int      @default(0)
  imported  Int      @default(0)
  skipped   Int      @default(0)
  failed    Int      @default(0)
  message   String?
  user      String   @default("System Administrator")
  createdAt DateTime @default(now())
}

/// An admin's ruling on a slab two shifts both claimed in MIS.
///
/// The scoreboard drops a contested slab from BOTH shifts, because paying it
/// twice is wrong and picking a winner is not a machine's decision. This table
/// is where the admin makes that call: one row per slab, naming the shift it
/// belongs to. Awarded slabs stop being contested — they score for the winner
/// and are excluded from everyone else.
///
/// Deliberately per-slab rather than per-range: a range is an MIS row, and the
/// row is exactly what was typed wrong, so a ruling keyed to it would move when
/// the row is corrected.
model SlabClaimAward {
  id         String   @id @default(cuid())
  slabNumber Float    @unique @map("slab_number")
  /// The IST date the winning shift STARTED (a C shift anchors on that day).
  anchor     String   @map("anchor")
  /// A | B | C
  shift      String   @map("shift")
  decidedBy  String?  @map("decided_by")
  decidedAt  DateTime @default(now()) @map("decided_at")

  @@index([anchor, shift])
  @@map("slab_claim_award")
}

// ---------------------------------------------------------------------------
// Finance engine (Bill Automation) — ported from automation/app/db.py so the
// whole flow runs inside the web app: Vercel + Neon, no Python service, no
// tunnel. Table-for-table with the SQLite schema except:
//   - `vouchers` (live Tally HTTP mode) and `layout_memory` (never read) are
//     not ported — file export is the only posting path here.
//   - Page images live in fin_bill_image (bytea) because Vercel has no disk.
// ---------------------------------------------------------------------------

model FinanceBill {
  id             Int      @id @default(autoincrement())
  filename       String
  // One row per BILL, not per uploaded file: an 11-page PDF of receipts is 11
  // separate claims, each needing its own ledger and amount.
  sourceFile     String?  @map("source_file")
  pageNo         Int      @default(1) @map("page_no")
  batchId        String?  @map("batch_id")
  fileSha256     String   @map("file_sha256")
  textLayer      String?  @map("text_layer")
  // Chosen by the clerk BEFORE upload, never read off the bill.
  person         String?
  phash          String?
  pageCount      Int      @default(1) @map("page_count")
  // queued | processing | review | needs_reupload | manual_entry
  // | approved | posted | rejected | duplicate | error
  status         String   @default("queued")
  error          String?
  autoApproved   Boolean  @default(false) @map("auto_approved")
  qualityVerdict String?  @map("quality_verdict")
  qualityJson    Json?    @map("quality_json")
  ocrEngine      String?  @map("ocr_engine")
  ocrVariant     String?  @map("ocr_variant")
  ocrConfidence  Float?   @map("ocr_confidence")
  ocrText        String?  @map("ocr_text")
  createdBy      String   @default("system") @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  image       FinanceBillImage?
  extractions FinanceExtraction[]

  @@index([fileSha256])
  @@index([status])
  @@index([batchId])
  @@map("fin_bill")
}

/// The page image, separated so bill listings never drag megabytes of bytea
/// through the pool. Compressed to JPEG at ingest; served by /bills/{id}/image.
model FinanceBillImage {
  billId Int         @id @map("bill_id")
  bill   FinanceBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  mime   String
  bytes  Bytes

  @@map("fin_bill_image")
}

model FinanceExtraction {
  id              Int         @id @default(autoincrement())
  billId          Int         @map("bill_id")
  bill            FinanceBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  vendorName      String?     @map("vendor_name")
  vendorGstin     String?     @map("vendor_gstin")
  invoiceNo       String?     @map("invoice_no")
  invoiceDate     String?     @map("invoice_date")
  taxableValue    Float?      @map("taxable_value")
  cgst            Float?
  sgst            Float?
  igst            Float?
  roundOff        Float?      @map("round_off")
  netAmount       Float?      @map("net_amount")
  hsnSac          String?     @map("hsn_sac")
  ledger          String?
  person          String?
  narration       String?
  fieldsJson      Json?       @map("fields_json")
  suggestionsJson Json?       @map("suggestions_json")
  confidence      Float?
  arithmeticOk    Boolean     @default(false) @map("arithmetic_ok")
  editedByUser    Boolean     @default(false) @map("edited_by_user")
  createdBy       String      @default("system") @map("created_by")
  createdAt       DateTime    @default(now()) @map("created_at")

  @@index([billId])
  @@index([vendorGstin, invoiceNo, netAmount])
  @@map("fin_extraction")
}

model FinanceVendorMemory {
  vendorKey String   @map("vendor_key")
  ledger    String
  count     Int      @default(1)
  lastSeen  DateTime @default(now()) @map("last_seen")

  @@id([vendorKey, ledger])
  @@map("fin_vendor_memory")
}

/// Which ledgers a person's claims actually go to — available BEFORE the bill
/// is read, and the cheapest intelligence in the system.
model FinancePersonMemory {
  person   String
  ledger   String
  count    Int      @default(1)
  lastSeen DateTime @default(now()) @map("last_seen")
  source   String   @default("confirmed") // confirmed | tally_history

  @@id([person, ledger])
  @@map("fin_person_memory")
}

model FinanceLedgerUsage {
  ledger String @id
  count  Int    @default(0)

  @@map("fin_ledger_usage")
}

model FinanceTokenWeight {
  token  String
  ledger String
  weight Float  @default(1.0)

  @@id([token, ledger])
  @@index([token])
  @@map("fin_token_weight")
}

model FinanceCorrection {
  id        Int      @id @default(autoincrement())
  billId    Int?     @map("bill_id")
  suggested String?
  corrected String?
  vendorKey String?  @map("vendor_key")
  person    String?
  score     Float?
  createdBy String   @default("system") @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("fin_correction")
}

model FinanceDuplicate {
  id             Int      @id @default(autoincrement())
  billId         Int      @map("bill_id")
  matchId        Int      @map("match_id")
  kind           String // file_hash | image_hash | field_match
  detail         String?
  overridden     Boolean  @default(false)
  overrideReason String?  @map("override_reason")
  overrideBy     String?  @map("override_by")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([billId])
  @@map("fin_duplicate")
}

/// One row per exported XML batch. A bill in an export is `posted` and
/// permanently excluded from later batches — with Tally's standard Journal
/// type, this table and dedupe are the ONLY duplicate defences there are.
model FinanceExport {
  ref        String   @id
  xml        String
  xlsxBase64 String?  @map("xlsx_base64")
  vouchers   Int
  total      Float
  newLedgers Json?    @map("new_ledgers")
  status     String   @default("generated") // generated | imported | voided
  note       String?
  createdBy  String   @default("system") @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  bills FinanceExportBill[]

  @@map("fin_export")
}

model FinanceExportBill {
  ref       String
  export    FinanceExport @relation(fields: [ref], references: [ref], onDelete: Cascade)
  billId    Int           @map("bill_id")
  voucherNo String        @map("voucher_no")

  @@id([ref, billId])
  @@index([billId])
  @@map("fin_export_bill")
}

/// The Tally chart of accounts, seeded from a MASTER.xml upload. Replaces both
/// ledgers_cache and the people list in config.yaml: person rows are the
/// claimant dropdown, expense rows are the classifier vocabulary.
model FinanceLedger {
  name      String   @id
  parent    String?
  gstin     String?
  isPerson  Boolean  @default(false) @map("is_person")
  isExpense Boolean  @default(false) @map("is_expense")
  syncedAt  DateTime @default(now()) @map("synced_at")

  @@index([isPerson])
  @@index([isExpense])
  @@map("fin_ledger")
}

model FinanceVendorEntry {
  id            Int      @id @default(autoincrement())
  billId        Int      @map("bill_id")
  vendorLedger  String   @map("vendor_ledger")
  expenseLedger String   @map("expense_ledger")
  taxable       Float
  cgst          Float    @default(0)
  sgst          Float    @default(0)
  igst          Float    @default(0)
  /// The reviewer's CHOSEN input-tax heads: [{ledger, amount, tax, rate}].
  ///
  /// The three scalars above cannot stand in for this. (tax, rate, eligible)
  /// does not identify one ledger — 9% eligible CGST matches both
  /// "INPUT CGST @ 9%" and "CGST @ 9% ON SERVICE", and nothing on the invoice
  /// chooses between them (gst.ts, trap 2). Re-deriving the head at export
  /// time would therefore silently overrule the human on the one decision the
  /// vendor panel exists to ask, and book input credit where the GST return
  /// will not find it. So the choice is stored verbatim.
  taxLinesJson  Json?    @map("tax_lines_json")
  tdsSection    String?  @map("tds_section")
  /// The full TDS head as spelled in Tally. `tdsSection` keeps the section
  /// (194C) for reporting; the voucher needs the ledger name itself, and PESPL
  /// runs several heads per section at different rates (tds.ts).
  tdsLedger     String?  @map("tds_ledger")
  tdsAmount     Float    @default(0) @map("tds_amount")
  invoiceNo     String?  @map("invoice_no")
  invoiceDate   String?  @map("invoice_date")
  narration     String?
  createdBy     String   @default("system") @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([billId])
  @@map("fin_vendor_entry")
}

/// The agent's journal. Autonomy without a journal is unaccountable: when a
/// clerk asks "why is this bill already approved?", the answer must be one
/// screen away, not a shrug.
model FinanceAgentEvent {
  id        Int      @id @default(autoincrement())
  kind      String
  billId    Int?     @map("bill_id")
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("fin_agent_event")
}

model FinanceLedgerRequest {
  id        Int      @id @default(autoincrement())
  name      String
  parent    String?
  reason    String?
  status    String   @default("open") // open | done | declined
  createdBy String   @default("system") @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("fin_ledger_request")
}

/// The costing rate card - one rate in force from a date.
///
/// Row-per-(item, variant, effective_from), append-only. "What did resin cost
/// in June?" is answered by the newest row at or before the batch's run date,
/// so costing a June batch uses June's rates even when today's differ - and a
/// re-costed batch prices identically forever. Purpose-built rather than
/// reusing consumables_and_rate: that table is an Airtable-sync snapshot with
/// one COLUMN per material and no unit or supplier axis, so a new grit band
/// there is a schema migration, where here it is a row an admin inserts.
model CostingRate {
  id            String   @id @default(cuid())
  /// RESIN | GRIT | FILLER | PIGMENT | CHEMICAL | CONVERSION | BASIS
  category      String
  /// Canonical key from src/lib/costing/rateCard.ts, e.g. "grit-0.6-1.2".
  item          String
  /// Splits an item across suppliers (resin: "Aypols", "3n Composits").
  /// Empty string rather than NULL so the uniqueness constraint can hold -
  /// Postgres treats NULLs as distinct, which would allow duplicate rows.
  variant       String   @default("")
  /// What `rate` is per: kg | t | sqft | month | slab | usd | day
  unit          String
  rate          Float
  effectiveFrom DateTime @map("effective_from") @db.Date
  note          String?
  createdBy     String   @default("system") @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([item, variant, effectiveFrom])
  @@index([category, effectiveFrom])
  @@map("costing_rate")
}
