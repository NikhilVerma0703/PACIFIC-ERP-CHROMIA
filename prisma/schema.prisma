generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OPERATOR
  INCHARGE
  LINE_MANAGER
  ADMIN
  FINANCE
  ACCOUNTS
  SALES
  COMMERCIAL
  STORE
  MAINTENANCE
  ROBO
  CHROMIA // Chromia line tablet role — capped to /chromia + /api/chromia, exactly like ROBO
  COMMERCIAL_MANAGER // Commercial Manager — everything COMMERCIAL does plus approve, cancel and plan (owner, 2026-09-07, answer 9). Added by scripts/0079.
  SAMPLING // Sampling Incharge — capped to /sampling + /api/sampling, exactly like ROBO and CHROMIA. A ROLE, not a Branch: see the SAMPLING MODULE banner at the foot of this file. Added by scripts/0051.
  COMMERCIAL_DOCS
  COMMERCIAL_EXEC
  COMMERCIAL_LOGISTICS
}

enum Station {
  PRESS
  OVEN
  JOT
  MIXER
  KREOS
  DISTRIBUTOR
  SILO
  POLISH_QC
  POLISH_ENTRY
  CUTTING
}

enum Branch {
  SHOP_FLOOR
  OFFICE
  FABRICATION
  INTERNATIONAL_SALES
  CHROMIA // RETIRED department, kept only so logins the old integration created still decode — offered nowhere in the UI; scripts/0046 empties it
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String?
  passwordHash       String
  sessionVersion     Int                 @default(1) @map("session_version") // bump -> all of this user's devices are logged out
  role               Role                @default(OPERATOR)
  station            Station?
  branch             Branch              @default(SHOP_FLOOR)
  active             Boolean             @default(true)
  // International Sales duty + factory scope (text on purpose: the fork's
  // SalesRole enum is retired — PRODUCTION_MANAGER duties belong to ADMIN).
  // Columns arrive via scripts/0020-sales-user-columns.sql (user-applied).
  salesRole          String?             @map("sales_role")
  salesFactory       String?             @map("sales_factory")
  /// Per-salesperson outbound mailbox (Sales -> Settings -> SMTP), scripts/0021.
  /// Types match that script exactly — text, integer, text, text — so declaring
  /// them changes no column, it only stops `db push` DROPPING them and taking
  /// every configured mailbox with it. Access stays raw SQL in
  /// lib/sales/mailer.ts, which degrades to "mail no-ops" while they are absent.
  ///
  /// smtpPass IS A STORED PASSWORD. listUsersRows() selects an explicit column
  /// list so it is never fetched into the Users screen, and src/auth.ts builds
  /// its return object field by field rather than spreading the row. Keep both
  /// that way.
  smtpHost           String?             @map("smtp_host")
  smtpPort           Int?                @map("smtp_port")
  smtpUser           String?             @map("smtp_user")
  smtpPass           String?             @map("smtp_pass")
  /// THE SECOND GRANTED JOB — one login, two role+branch pairs, a cookie
  /// selecting which is live (src/lib/roleContext.ts). Both halves move
  /// together: a role without a branch is not a job, and roleContext treats a
  /// half-filled grant as no grant at all.
  ///
  /// DECLARED HERE ON PURPOSE, and that is a correction rather than a
  /// preference. scripts/0052 argued these should stay out of the model,
  /// following what 0019 and 0024 did for sales_role and amount_received — but
  /// BOTH of those are in this model now (lines above, and BatchCosting), and
  /// amountReceived carries a comment saying it was added precisely because
  /// `prisma db push` proposed dropping it WITH ITS DATA. The precedent had
  /// already been reversed; only 0052 still relied on it.
  ///
  /// Leaving them undeclared is not neutral. `db push` compares the database to
  /// this file, sees two columns nothing describes, and drops them — silently,
  /// with every grant in them. That is not hypothetical: it happened on the dev
  /// database on 24 Aug 2026, between applying 0052 and the next `db push`, and
  /// the same sequence against Neon would delete real grants from real people.
  /// `db:push` is in package.json, in the README, in setup-cloud.bat, and the
  /// admin page tells admins to run it.
  ///
  /// The raw-SQL readers in lib/users.ts stay as they are: they fail open when
  /// the columns are absent, which keeps a stale deploy from 500-ing the whole
  /// Users screen. Declaring the fields makes the columns SURVIVE; the raw
  /// reads make their absence SURVIVABLE. Both are wanted.
  altRole            Role?               @map("alt_role")
  altBranch          Branch?             @map("alt_branch")
  createdById        String?
  createdBy          User?               @relation("UserCreator", fields: [createdById], references: [id])
  createdUsers       User[]              @relation("UserCreator")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  cuttingEntries     CuttingEntry[]
  fabMachineSessions FabMachineSession[]
  /// Slabs this login CUT. Named now that a second relation to FabSlabJob
  /// exists — Prisma cannot tell two links to one model apart without it.
  fabSlabJobs        FabSlabJob[]        @relation("FabSlabJobOperator")
  /// Slabs this login SENT TO CUTTING. scripts/0064. A different act from the
  /// one above, usually by a different person: the supervisor (or the cutter
  /// himself) puts the slab up, and whoever is at the saw cuts it.
  fabSlabJobsReleased FabSlabJob[]       @relation("FabSlabJobReleasedBy")
  /// scripts/0067 — the three places a login can put a typed figure or a hand
  /// reassignment on the record. Named relations, because Prisma cannot tell
  /// two links to one model apart without them.
  fabRowOverrides    FabRequirement[]   @relation("FabRequirementEdgeOverrideBy")
  fabHandAssigned    FabPiece[]         @relation("FabPieceHandAssignedBy")
  fabProjectTotals   FabProject[]       @relation("FabProjectManualTotalBy")
  fabOperations      FabOperation[]
  fabWorkersCreated  FabWorker[]

  @@map("users")
}

/// Login rate-limit counters (src/auth.ts): one row per throttle key, counting
/// failures in a rolling 15-minute window; stale rows are cleaned opportunistically.
/// DB-backed so the lockout survives serverless instances — auth falls back to an
/// in-memory map if this table is absent. Hand-written; access stays raw SQL.
model LoginAttempt {
  key     String   @id
  n       Int      @default(1)
  firstAt DateTime @default(now()) @map("first_at") @db.Timestamptz(6)

  @@map("login_attempt")
}

