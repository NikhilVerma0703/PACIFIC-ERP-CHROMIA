  /// same type, same nullability, same default — so the schema now
  /// matches the database instead of asking to change it.
  packingListUpload     String?    @map("packing_list_upload")
  measurementListUpload String?    @map("measurement_list_upload")
  insurancePct          Decimal?   @map("insurance_pct") @db.Decimal
  oceanFreight          Decimal?   @map("ocean_freight") @db.Decimal
  packingCharges        Decimal?   @map("packing_charges") @db.Decimal
  marksNos              String?    @map("marks_nos")
  itemNetWeights        Json?      @map("item_net_weights")

  @@map("sales_shipment_docs")
}

