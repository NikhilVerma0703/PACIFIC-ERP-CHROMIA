// Two-tier RM (grit & filler) — the bulk, bag-less pool uploaded by the Store
// Incharge from Excel. Bags are carved out of this into the Rm table via the
// RM Assignment form, which deducts remainingKg.
model UnassignedRm {
  id               String    @id @default(cuid())
  invNo            String    @map("inv_no")
  type             String    @default("") @map("type")
  size             String    @default("") @map("size")
  grade            String    @default("") @map("grade")
  supplier         String?   @map("supplier")
  totalKg          Float     @default(0) @map("total_kg")
  remainingKg      Float     @default(0) @map("remaining_kg")
  // mirrored from the RM table (non-bag fields)
  date             DateTime? @map("date")
  status           String?   @map("status")
  testedBy         String?   @map("tested_by")
  availability     String?   @map("availability")
  contamination    String?   @map("contamination")
  gritShade        String?   @map("grit_shade")
  fillerShade      String?   @map("filler_shade")
  colourL          Float?    @map("colour_l")
  colourA          Float?    @map("colour_a")
  colourB          Float?    @map("colour_b")
  consumablesIssue String?   @map("consumables_issue")
  remarks          String?   @map("remarks")
  uploadedBy       String?   @map("uploaded_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([invNo, type, size, grade])
  @@map("unassigned_rm")
}

