}

// ---- Recalibration -----------------------------------------------------------

/// One recalibration cycle. Maximum five per slab — enforced in the service
/// layer against ChromiaSlab.recalibrationCount and by the unique constraint
/// below.
model ChromiaRecalibrationCycle {
  id            String                     @id @default(uuid())
  attemptNumber Int                        @map("attempt_number")
  status        ChromiaRecalibrationStatus @default(PENDING_DISPATCH)

  slabId String      @map("slab_id")
  slab   ChromiaSlab @relation(fields: [slabId], references: [id], onDelete: Cascade)

  // The cycle that failed QC and triggered this recalibration.
  failedCycleId String?              @unique @map("failed_cycle_id")
  failedCycle   ChromiaProcessCycle? @relation("ChromiaFailedCycle", fields: [failedCycleId], references: [id], onDelete: SetNull)

  // The cycle created when the slab restarted after coming back.
  restartedCycleId String?              @unique @map("restarted_cycle_id")
  restartedCycle   ChromiaProcessCycle? @relation("ChromiaRestartedCycle", fields: [restartedCycleId], references: [id], onDelete: SetNull)

  reasonId String?                     @map("reason_id")
  reason   ChromiaRecalibrationReason? @relation(fields: [reasonId], references: [id], onDelete: SetNull)

  reasonNotes String? @map("reason_notes")

  // Outward
  sentDate           DateTime? @map("sent_date")
  expectedReturnDate DateTime? @map("expected_return_date")
  facilityName       String?   @map("facility_name")
  gatePassNo         String?   @map("gate_pass_no")
  transporter        String?
  vehicleNo          String?   @map("vehicle_no")
  conditionOnSend    String?   @map("condition_on_send")

  issuedById String? @map("issued_by_id") // -> users.id (no hard FK)

  // Return
  receivedDate      DateTime? @map("received_date")
  turnaroundDays    Int?      @map("turnaround_days")
  conditionOnReturn String?   @map("condition_on_return")
  workAccepted      Boolean?  @map("work_accepted")

  receivedById String? @map("received_by_id") // -> users.id (no hard FK)

  // Upper-surface removal
  thicknessBeforeMm  Decimal? @map("thickness_before_mm") @db.Decimal(18, 3)
  thicknessAfterMm   Decimal? @map("thickness_after_mm") @db.Decimal(18, 3)
  materialRemovedMm  Decimal? @map("material_removed_mm") @db.Decimal(18, 3)
  withinMinThickness Boolean? @map("within_min_thickness")

  photoUrls String[] @map("photo_urls")
  notes     String?

  restartedAt DateTime? @map("restarted_at")

  createdById String?  @map("created_by_id") // -> users.id (no hard FK)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([slabId, attemptNumber])
  @@index([status, sentDate])
  @@index([slabId])
  @@index([reasonId])
  @@index([receivedDate])
  @@map("chromia_recalibration_cycle")
}

