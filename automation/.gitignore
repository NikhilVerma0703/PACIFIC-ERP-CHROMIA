# Runtime data. None of this belongs in the repository.
#
# data/ accumulates the SQLite database, every uploaded bill image, split page
# images and generated XML. It also holds PESPL's 30 MB All Masters export and
# their trial balance - real company financial data that should not sit in a git
# history. The app recreates every directory it needs on first run.
data/*.db
data/*.db-wal
data/*.db-shm
data/uploads/
data/pages/
data/tally_export/
data/inbox/
# 1.3 MB cache of the full chart of accounts, rebuilt from MASTER.xml
# automatically. NOTE: gitignore has no inline comments - a trailing "# ..."
# on this line becomes part of the pattern and silently matches nothing.
data/ledgers.json

# Company financial exports. Keep these out of version control and hand them
# over separately - they contain the full chart of accounts and real vouchers.
data/MASTER.xml
data/*.xlsx
*.xlsx
data/TEST_*.xml
data/SAMPLE_*.xml
data/*.pdf

__pycache__/
*.py[cod]
.venv/
venv/
env/
.env

.vscode/
.idea/
.DS_Store
Thumbs.db
